Cell[BoxData[{
 RowBox[{"Clear", "[", "dummyRules", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dummyRules", "[", 
   RowBox[{
    RowBox[{"a_", " ", "exp_op"}], ",", "rest___"}], "]"}], ":=", 
  RowBox[{"dummyRules", "[", 
   RowBox[{"exp", ",", "rest"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dummyRules", "[", 
   RowBox[{"exp_op", ",", "extFields_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"intInds", ",", "dummies"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"intInds", "=", 
      RowBox[{"Union", "@", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"exp", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"A", "|", "cb", "|", "c"}], ",", "i_"}], "}"}], ":>", 
            "i"}], ",", "\[Infinity]"}], "]"}], ",", 
         RowBox[{"Alternatives", "@@", 
          RowBox[{"extFields", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Thread", "@", 
      RowBox[{"Rule", "[", 
       RowBox[{"intInds", ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"insDummy", "[", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"Length", "@", "intInds"}], "}"}]}], "]"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9706339588823566`*^9, 3.970634171792302*^9}, {
