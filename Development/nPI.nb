Cell[BoxData[{
 RowBox[{"Clear", "@", "derivP"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivP", "[", 
   RowBox[{"exp_op", ",", 
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"field1_", ",", "i1_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"field2_", ",", "i2_"}], "}"}]}], "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"props", ",", "extP", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"props", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{"P", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"field1", ",", "_"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"field2", ",", "_"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"extP", "=", 
      RowBox[{"P", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"field1", ",", "i1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"field2", ",", "i2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Plus", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"prop", ",", 
           RowBox[{
            RowBox[{"exp", "/.", 
             RowBox[{"prop", ":>", 
              RowBox[{"Sequence", "[", "]"}]}]}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"prop", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ":>", "i1"}], ",", 
              RowBox[{
               RowBox[{"prop", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "2"}], "]"}], "]"}], ":>", "i2"}]}], 
             "}"}]}]}], "]"}], "/@", "props"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"identifyGraphs", "[", 
      RowBox[{"res", ",", 
       RowBox[{"List", "@@", "extP"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.969687846825981*^9, 3.969687848553564*^9}, {
  3.969687952977585*^9, 3.969687991948295*^9}, {3.9696880354669847`*^9, 
