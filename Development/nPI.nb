Cell[BoxData[{
 RowBox[{"Clear", "[", "derivPop", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivPop", "[", 
   RowBox[{"exp_", ",", 
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"field1_", ",", "i1_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"field2_", ",", "i2_"}], "}"}]}], "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"extP", ",", "res"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"extP", "=", 
      RowBox[{"P", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"field1", ",", "i1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"field2", ",", "i2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"derivP", "[", 
       RowBox[{"exp", ",", "extP"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"identifyGraphs", "[", 
      RowBox[{"res", ",", 
       RowBox[{"List", "@@", "extP"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
