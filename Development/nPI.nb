          RowBox[{"{", 
           RowBox[{"a", ",", "_"}], "}"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"vert", ",", 
          RowBox[{
           RowBox[{"exp", "/.", 
            RowBox[{"vert", ":>", 
             RowBox[{"Sequence", "[", "]"}]}]}], "/.", 
           RowBox[{"indRules", "[", "vert", "]"}]}]}], "]"}], "/@", 
        "vertices"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Thread", "[", 
     RowBox[{"Rule", "[", 
      RowBox[{
       RowBox[{"List", "@@", 
