       RowBox[{"{", "fieldsInds", "}"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"indRules", "[", "vert_", "]"}], ":=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"List", "@@", 
          RowBox[{"vert", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "inds"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
