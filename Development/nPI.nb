          RowBox[{"MemberQ", "[", 
           RowBox[{"extInds", ",", "i1"}], "]"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"indRules", "=", 
      RowBox[{"Rule", "@@@", "extPropsDirected"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
