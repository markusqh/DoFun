   RowBox[{"exp_op", ",", 
    RowBox[{"V", "[", "fieldsInds___", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vertices", ",", "extV", ",", "inds", ",", "indRules"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"inds", "=", 
      RowBox[{
       RowBox[{"{", "fieldsInds", "}"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"indRules", "[", "vert_", "]"}], ":=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"List", "@@", 
          RowBox[{"vert", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "inds"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vertices", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{
