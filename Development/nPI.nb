          RowBox[{"A", ",", "k"}], "}"}]}], "]"}], "]"}], "-", 
      RowBox[{"eomAAA", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "/.", 
     RowBox[{"a_op", ":>", 
