Cell[BoxData[{
 RowBox[{"Clear", "@", "derivP"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivP", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a_", "?", "NumericQ"}], " ", "b_op"}], ",", "rest__"}], "]"}], ":=", 
  RowBox[{"a", " ", 
   RowBox[{"derivP", "[", 
    RowBox[{"b", ",", "rest"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivP", "[", 
   RowBox[{"a_Plus", ",", "rest__"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"derivP", "[", 
     RowBox[{"#", ",", "rest"}], "]"}], "&"}], "/@", "a"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivP", "[", 
   RowBox[{"exp_op", ",", 
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"field1_", ",", "i1_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"field2_", ",", "i2_"}], "}"}]}], "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"props", ",", "extP", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"props", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{"P", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"field1", ",", "_"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"field2", ",", "_"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"extP", "=", 
      RowBox[{"P", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"field1", ",", "i1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"field2", ",", "i2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Plus", "@@", 
       RowBox[{"(", 
