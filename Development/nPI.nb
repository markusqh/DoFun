  RowBox[{
   RowBox[{
    RowBox[{"derivV", "[", 
     RowBox[{"#", ",", "rest"}], "]"}], "&"}], "/@", "a"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivV", "[", 
   RowBox[{"exp_op", ",", 
    RowBox[{"V", "[", "fieldsInds___", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vertices", ",", "extV", ",", "inds", ",", "indRules", ",", "res"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"inds", "=", 
      RowBox[{
       RowBox[{"{", "fieldsInds", "}"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"indRules", "[", "vert_", "]"}], ":=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"List", "@@", 
          RowBox[{"vert", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "inds"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vertices", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{
         RowBox[{"V", "[", "fieldsInds", "]"}], "/.", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a_", "?", "fieldQ"}], ",", "b_"}], "}"}], ":>", 
          RowBox[{"{", 
           RowBox[{"a", ",", "_"}], "}"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Plus", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"vert", ",", 
           RowBox[{
            RowBox[{"exp", "/.", 
             RowBox[{"vert", ":>", 
              RowBox[{"Sequence", "[", "]"}]}]}], "/.", 
            RowBox[{"indRules", "[", "vert", "]"}]}]}], "]"}], "/@", 
         "vertices"}], ")"}]}]}], ";", "\[IndentingNewLine]", "res"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
