          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"exp", ",", "i", ",", "\[Infinity]"}], "]"}], "==", 
           "1"}]}]}], ",", "\[Infinity]"}], "]"}]}], ";", 
