Cell["\<\
A first minimal working example of a derivative with respect to a propagator:\
\
\>", "Text",
 CellChangeTimes->{{3.9696883380023603`*^9, 
  3.96968835303329*^9}},ExpressionUUID->"57623a17-f5f1-4c8b-8b2f-\
42fcd975bfd5"],

Cell[BoxData[{
 RowBox[{"Clear", "@", "derivP"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivP", "[", 
   RowBox[{"exp_op", ",", 
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"field1_", ",", "i1_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"field2_", ",", "i2_"}], "}"}]}], "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"props", ",", "extP", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"props", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{"P", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"field1", ",", "_"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"field2", ",", "_"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"extP", "=", 
      RowBox[{"P", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"field1", ",", "i1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"field2", ",", "i2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Plus", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"prop", ",", 
           RowBox[{
            RowBox[{"exp", "/.", 
             RowBox[{"prop", ":>", 
              RowBox[{"Sequence", "[", "]"}]}]}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"prop", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ":>", "i1"}], ",", 
              RowBox[{
               RowBox[{"prop", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "2"}], "]"}], "]"}], ":>", "i2"}]}], 
             "}"}]}]}], "]"}], "/@", "props"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"identifyGraphs", "[", 
      RowBox[{"res", ",", 
       RowBox[{"List", "@@", "extP"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.969687846825981*^9, 3.969687848553564*^9}, {
  3.969687952977585*^9, 3.969687991948295*^9}, {3.9696880354669847`*^9, 
  3.96968814457133*^9}, {3.969688205547256*^9, 3.9696882344332314`*^9}, {
  3.969688281254566*^9, 3.969688319432014*^9}, {3.9696914775607147`*^9, 
  3.969691505857843*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"129b6907-63c7-4cd2-afc7-6e38d7117d99"],

