 RowBox[{
  RowBox[{"clipExtProps", "[", "exp_op", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "extProps", ",", "indRules", ",", "extInds", ",", "extPropsDirected"}], 
