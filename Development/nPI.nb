Cell[BoxData[{
 RowBox[{"Clear", "@", "derivV"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivV", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a_", "?", "NumericQ"}], " ", "b_op"}], ",", "rest__"}], "]"}], ":=", 
  RowBox[{"a", " ", 
   RowBox[{"derivV", "[", 
    RowBox[{"b", ",", "rest"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
