            DirectedEdge[{$CellContext`phi, $CellContext`i1, 
                ""}, {$CellContext`phi, $CellContext`i1s, ""}] -> ({
               DoFun`DoDSERGE`Private`arrowLine[
               DoFun`DoDSERGE`Private`field$11094, 
                SlotSequence[1]]}& )}, GraphLayout -> 
           "SpringElectricalEmbedding", ImageSize -> 100, 
           VertexShapeFunction -> {{$CellContext`phi, $CellContext`i1, 
               ""} -> (DoFun`DoDSERGE`Private`getVertexShapeFunction[
               SlotSequence[1]]& ), {$CellContext`phi, $CellContext`i1s, 
               ""} -> (DoFun`DoDSERGE`Private`getVertexShapeFunction[
               SlotSequence[1]]& )}, VertexSize -> {0.15}}]]}, 
      TagBox[
       GraphicsGroupBox[{{
          Arrowheads[{{Medium, 0.8}}], 
          Directive[
           Opacity[0.7], 
           Hue[0.6, 0.7, 0.7], 
           CapForm["Round"]], {{{
             
             BezierCurveBox[{{1., 0.}, {
              0.5000000000000003, -0.1644407471831164}, {0., 
              5.677710618986984*^-18}}]}}, 
           InsetBox[
            FormBox["\"phi phi\"", TraditionalForm], {
