Cell[CellGroupData[{

Cell["IsomorphicGraphQ enhancement", "Section",
 CellChangeTimes->{{3.970132716351585*^9, 
  3.9701327242392063`*^9}},ExpressionUUID->"5858a483-2211-4677-b6a7-\
af467053af80"],

Cell["\<\
--> Not feasible because external points are not distingushed. For example, \
the three swordfish diagrams would be the same. Also problems with multi \
edges (not clear how to resolve, colored edges suggested by Jonas) and mixing \
of bosons and fermions (would require an extra function for separation).\
\>", "Text",
 CellChangeTimes->{{3.9706301540146*^9, 
  3.970630244898396*^9}},ExpressionUUID->"d555dc42-bee5-40da-b83f-\
4cfd1994b6e3"],

Cell["\<\
IsomorphicGraphQ does not work for
1. multiple edges of the same type connecting the same vertex
2. mixing undirected and directed edges\
\>", "Text",
 CellChangeTimes->{{3.970132727620496*^9, 
  3.970132766288472*^9}},ExpressionUUID->"8212da27-ea70-4810-b469-\
96f31e34b261"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"graph1", "=", 
  RowBox[{"Graph", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"UndirectedEdge", "[", 
      RowBox[{"1", ",", "2"}], "]"}], ",", 
