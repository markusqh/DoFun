Cell[CellGroupData[{

Cell["ToDos", "Section",
 CellChangeTimes->{{3.971350270242771*^9, 
  3.971350271382277*^9}},ExpressionUUID->"6360cc77-cb1e-45fa-890f-\
453dc2d6d283"],

Cell["\<\
Ensure that propagator derivatives are done correctly if definition order of \
fields is wrong for fermions.
What about mixed fields?\
\>", "Text",
 CellChangeTimes->{{3.9713502734384604`*^9, 
  3.971350304751031*^9}},ExpressionUUID->"6f4baae7-babf-4c91-8c39-\
8f2b54e50b47"],

Cell["Not implemented for mixed propagators.", "Text",
 CellChangeTimes->{{3.9713522003227663`*^9, 
  3.9713522047611437`*^9}},ExpressionUUID->"f5b3255c-d51b-473a-b306-\
b0420b42bd4e"],

Cell["\<\
Permutations unclear: Necessary for bosons, but fermions do not work \
properly. --> Solved?\
\>", "Text",
 CellChangeTimes->{{3.971430889873291*^9, 3.971430901656369*^9}, {
  3.972300385381997*^9, 
