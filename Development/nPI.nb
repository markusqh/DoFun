          RowBox[{"{", 
           RowBox[{"a", ",", "_"}], "}"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"vert", ",", 
          RowBox[{
           RowBox[{"exp", "/.", 
            RowBox[{"vert", ":>", 
             RowBox[{"Sequence", "[", "]"}]}]}], "/.", 
