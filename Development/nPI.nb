      RowBox[{"P", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"field1", ",", "i1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"field2", ",", "i2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"derivP", "[", 
       RowBox[{"exp", ",", "extP"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"identifyGraphs", "[", 
      RowBox[{"res", ",", 
       RowBox[{"List", "@@", "extP"}]}], "]"}]}]}], "\[IndentingNewLine]", 
