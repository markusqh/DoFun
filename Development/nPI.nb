Cell[BoxData[{
 RowBox[{"Clear", "@", "vertReplsAcbc"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vertReplsAcbc", "[", 
    RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], "=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"op", "[", 
       RowBox[{"V", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "i"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"cb", ",", "j"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "k"}], "}"}]}], "]"}], "]"}], "-", 
      RowBox[{"eomAcbc", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "/.", 
     RowBox[{"a_op", ":>", 
      RowBox[{"(", 
       RowBox[{"a", "/.", 
        RowBox[{"dummyRules", "[", 
         RowBox[{"a", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"A", ",", "i"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"cb", ",", "j"}], "}"}], ",", 
