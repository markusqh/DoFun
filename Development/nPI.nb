Cell[BoxData[{
 RowBox[{"Clear", "@", "identifyGraphsViaGraphs"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"identifyGraphsViaGraphs", "[", 
   RowBox[{
    RowBox[{"a_", "?", "NumericQ"}], ",", "___"}], "]"}], ":=", "a"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"identifyGraphsViaGraphs", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a_", "?", "NumericQ"}], " ", "b_op"}], ",", "___"}], "]"}], ":=", 
  RowBox[{"a", " ", "b"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"identifyGraphsViaGraphs", "[", 
   RowBox[{"a_Plus", ",", "extFields_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"opsNumSummed", ",", "opsNum", ",", "preExp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"preExp", "=", 
      RowBox[{"sortCanonical", "[", 
       RowBox[{"a", ",", "extFields"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Catch", " ", "if", " ", "sortCanonical", " ", "resulted", " ", "in", " ",
        "a", " ", "single", " ", "ip"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Head", "@", "preExp"}], "==", "Times"}], "||", 
        RowBox[{
         RowBox[{"Head", "@", "preExp"}], "==", "op"}]}], ",", 
       RowBox[{"Return", "[", "preExp", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"create", " ", "a", " ", "list", " ", "with", " ", "elements", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"numeric", " ", "factor"}], ",", " ", "op", ",", " ", 
         "graph"}], "}"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"opsNum", "=", 
      RowBox[{"Replace", "[", 
       RowBox[{
        RowBox[{"List", "@@", "preExp"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"b_op", "->", 
           RowBox[{"{", 
            RowBox[{"1", ",", "b", ",", 
             RowBox[{"DSEPlotGraph", "[", 
              RowBox[{"vertexDummies", "[", "b", "]"}], "]"}]}], "}"}]}], ",", 
          RowBox[{
           RowBox[{"c_", " ", "b_op"}], ":>", 
           RowBox[{"{", 
            RowBox[{"c", ",", "b", ",", 
             RowBox[{"DSEPlotGraph", "[", 
              RowBox[{"vertexDummies", "[", "b", "]"}], "]"}]}], "}"}]}]}], 
         "}"}], ",", 
        RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "up", " ", "equal", " ", "graphs"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"opsNumSummed", "=", 
      RowBox[{"Gather", "[", 
       RowBox[{"opsNum", ",", 
        RowBox[{
         RowBox[{"IsomorphicGraphQ", "[", 
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", 
           RowBox[{"#2", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"opsNumSummed", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Plus", "@@", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
       "opsNumSummed"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"return", " ", "sum"}], " ", "*)"}], "\[IndentingNewLine]", 
