      RowBox[{"4", ",", "2"}], "]"}], ",", 
     RowBox[{"UndirectedEdge", "[", 
      RowBox[{"4", ",", "5"}], "]"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.970132768004847*^9, 3.970132852793788*^9}},
