Cell[BoxData[{
 RowBox[{"Clear", "@", "clipExtProps"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"clipExtProps", "[", "exp_", "]"}], "/;", 
   RowBox[{
    RowBox[{"Head", "@", "exp"}], "=!=", "op"}]}], ":=", 
  RowBox[{"exp", "/.", 
   RowBox[{"a_op", ":>", 
    RowBox[{"clipExtProps", "[", "a", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"clipExtProps", "[", "exp_op", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "extProps", ",", "indRules", ",", "extInds", ",", "extPropsDirected"}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"extInds", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"f1_", "?", "fieldQ"}], ",", "i_"}], "}"}], ":>", 
         RowBox[{"i", "/;", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"exp", ",", "i", ",", "\[Infinity]"}], "]"}], "==", 
           "1"}]}]}], ",", "\[Infinity]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"extProps", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{
