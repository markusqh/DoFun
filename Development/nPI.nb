      RowBox[{"{", 
       RowBox[{"field2_", ",", "i2_"}], "}"}]}], "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"props", ",", "extP", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"props", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"exp", ",", 
        RowBox[{"P", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"field1", ",", "_"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"field2", ",", "_"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"extP", "=", 
      RowBox[{"P", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"field1", ",", "i1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"field2", ",", "i2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Plus", "@@", 
