            ImageScaled[{0.5, 0.5}], BaseStyle -> "Graphics"]}, {{{
             
             BezierCurveBox[{{1., 0.}, {0.5000000000000003, 
              0.1644407471831164}, {0., 5.677710618986984*^-18}}]}}, 
           InsetBox[
            FormBox["\"phi phi\"", TraditionalForm], {0.5000000000000001, 
            0.07000000000000006}, 
            ImageScaled[{0.5, 0.5}], BaseStyle -> "Graphics"]}}, {
          Directive[
           Hue[0.6, 0.5, 1.], 
           EdgeForm[
            Directive[
             GrayLevel[0], 
             Opacity[0.7]]]], {
           DiskBox[{1., 0.}, 0.10606601717798213`]}, {
