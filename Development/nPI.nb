     RowBox[{
      RowBox[{"indRules", "[", "vert_", "]"}], ":=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"List", "@@", 
          RowBox[{"vert", "[", 
