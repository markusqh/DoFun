          RowBox[{"c", ",", "k"}], "}"}]}], "]"}], "]"}], "-", 
      RowBox[{"eomAcbc", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "/.", 
     RowBox[{"a_op", ":>", 
