         RowBox[{"MemberQ", "[", 
          RowBox[{"extInds", ",", 
           RowBox[{"i1", "|", "i2"}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
