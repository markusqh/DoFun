           RowBox[{"{", 
            RowBox[{"f1_", ",", "i1_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"f2_", ",", "i2_"}], "}"}]}], "]"}], "/;", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"extInds", ",", 
           RowBox[{"i1", "|", "i2"}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "adjust", " ", "indices", " ", "for", " ", "replacement", " ", 
       "rules"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"extPropsDirected", "=", 
      RowBox[{"extProps", "/.", 
       RowBox[{"{", 
