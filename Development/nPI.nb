Cell[BoxData[
 TemplateBox[{
   GraphicsBox[
    NamespaceBox["NetworkGraphics", 
     DynamicModuleBox[{Typeset`graph = HoldComplete[
         Graph[{{$CellContext`phi, $CellContext`i1, 
            ""}, {$CellContext`phi, $CellContext`i1s, ""}}, {{{1, 2}, {1, 
           2}, {1, 2}}, Null}, {
          EdgeLabels -> {
