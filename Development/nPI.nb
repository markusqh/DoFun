     RowBox[{"Thread", "@", 
      RowBox[{"Rule", "[", 
       RowBox[{"intInds", ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"insDummy", "[", "]"}], ",", 
