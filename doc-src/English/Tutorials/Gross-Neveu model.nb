Cell["To deal with the Dirac algebra, some simple rules suffice:", "Text",
 CellChangeTimes->{{3.783251456843235*^9, 3.783251467676259*^9}, {
  3.784874247769038*^9, 3.784874258937067*^9}, {3.90241313179467*^9, 
  3.902413136173376*^9}},
 CellID->1947882005,ExpressionUUID->"b8392fef-d1e7-4f3a-a6ee-23529850e5a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dimRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"dim", "[", "flavor", "]"}], "\[RuleDelayed]", "Nf"}], ",", 
     RowBox[{
      RowBox[{"dim", "[", "dirac", "]"}], "\[RuleDelayed]", "dgamma"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diracRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"diracM", "[", 
       RowBox[{
        RowBox[{"-", "p_"}], ",", "a_", ",", "b_"}], "]"}], "\[RuleDelayed]", 
      
      RowBox[{"-", 
       RowBox[{"diracM", "[", 
        RowBox[{"p", ",", "a", ",", "b"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"diracM", "[", 
       RowBox[{"p_", ",", "a_", ",", "a_"}], "]"}], "\[RuleDelayed]", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"diracM", "[", 
        RowBox[{"q_", ",", "a_", ",", "b_"}], "]"}], " ", 
       RowBox[{"diracM", "[", 
        RowBox[{"q_", ",", "b_", ",", "c_"}], "]"}]}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"q", "^", "2"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "a", ",", "c"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"diracM", "[", 
        RowBox[{"q_", ",", "b_", ",", "a_"}], "]"}], " ", 
       RowBox[{"diracM", "[", 
        RowBox[{"q_", ",", "c_", ",", "b_"}], "]"}]}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"q", "^", "2"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "a", ",", "c"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"diracM", "[", 
       RowBox[{
        RowBox[{"a_", "+", "b_"}], ",", "c_", ",", "d_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"diracM", "[", 
        RowBox[{"a", ",", "c", ",", "d"}], "]"}], "+", 
       RowBox[{"diracM", "[", 
        RowBox[{"b", ",", "c", ",", "d"}], "]"}]}]}], ",", 
