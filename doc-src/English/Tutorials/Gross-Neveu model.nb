Cell[TextData[{
 "The flow equations can be visualized with RGEPlot. Since the two-point \
equation has only one diagram, the option ",
 StyleBox["output \[Rule] forceEquation",
  FontSlant->"Italic"],
 " is used to avoid plotting only the diagram."
}], "Text",
 CellChangeTimes->{{3.784871153115013*^9, 3.7848711567950373`*^9}, {
  3.784871276251891*^9, 3.784871278556128*^9}, {3.902407205000371*^9, 
