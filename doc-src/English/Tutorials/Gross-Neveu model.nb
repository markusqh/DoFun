     RowBox[{"Limit", "[", 
      RowBox[{"#", ",", 
       RowBox[{"Nf", "\[Rule]", "\[Infinity]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Expand", "@", "betaFinMomDimLess"}]}]}], ";"}], "\n", 
 RowBox[{"betaDimLessLargeNf", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"betaDimLessLargeNfPre", ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"Element", "[", 
      RowBox[{"d", ",", "Integers"}], "]"}]}]}], "]"}]}]}], "Input",
