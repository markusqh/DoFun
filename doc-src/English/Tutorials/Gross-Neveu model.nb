Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "FR4Point", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FR4Point", "[", 
   RowBox[{
    RowBox[{"psib", "[", 
     RowBox[{"p1_", ",", "a_", ",", "i_"}], "]"}], ",", 
    RowBox[{"psib", "[", 
     RowBox[{"p2_", ",", "b_", ",", "j_"}], "]"}], ",", 
    RowBox[{"psi", "[", 
     RowBox[{"p3_", ",", "c_", ",", "k_"}], "]"}], ",", 
    RowBox[{"psi", "[", 
     RowBox[{"p4_", ",", "d_", ",", "l_"}], "]"}]}], "]"}], "=", 
  RowBox[{"getFR", "[", 
   RowBox[{"actionGN", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", "[", 
       RowBox[{"p4", ",", "d", ",", "l"}], "]"}], ",", 
      RowBox[{"psi", "[", 
       RowBox[{"p3", ",", "c", ",", "m"}], "]"}], ",", 
      RowBox[{"psib", "[", 
       RowBox[{"p2", ",", "b", ",", "j"}], "]"}], ",", 
      RowBox[{"psib", "[", 
       RowBox[{"p1", ",", "a", ",", "i"}], "]"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.507353563919478*^9, 3.507353563920177*^9}, 
   3.784868387026223*^9, {3.784868467683066*^9, 3.784868477458513*^9}, {
   3.9023008907296867`*^9, 3.902300893403652*^9}, {3.9053182572387342`*^9, 
   3.905318257886646*^9}, {3.971704408445047*^9, 3.971704462628578*^9}},
 CellLabel->"In[11]:=",
 CellID->1504613262,ExpressionUUID->"f9de40a1-6fa6-4efc-887d-4af2ffc1c6a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{
    FractionBox["1", "Nf"], 
    RowBox[{"gb", " ", 
     RowBox[{"delta", "[", 
      RowBox[{"dirac", ",", "a", ",", "c"}], "]"}], " ", 
     RowBox[{"delta", "[", 
      RowBox[{"dirac", ",", "b", ",", "d"}], "]"}], " ", 
     RowBox[{"delta", "[", 
      RowBox[{"flavor", ",", "i", ",", "m"}], "]"}], " ", 
     RowBox[{"delta", "[", 
      RowBox[{"flavor", ",", "j", ",", "l"}], "]"}], " ", 
     RowBox[{"deltam", "[", 
      RowBox[{"p1", "+", "p2", "+", "p3", "+", "p4"}], "]"}]}]}]}], "+", 
  RowBox[{
   FractionBox["1", "Nf"], 
   RowBox[{"gb", " ", 
    RowBox[{"delta", "[", 
     RowBox[{"dirac", ",", "a", ",", "d"}], "]"}], " ", 
    RowBox[{"delta", "[", 
     RowBox[{"dirac", ",", "b", ",", "c"}], "]"}], " ", 
    RowBox[{"delta", "[", 
     RowBox[{"flavor", ",", "i", ",", "l"}], "]"}], " ", 
    RowBox[{"delta", "[", 
     RowBox[{"flavor", ",", "j", ",", "m"}], "]"}], " ", 
    RowBox[{"deltam", "[", 
     RowBox[{"p1", "+", "p2", "+", "p3", "+", "p4"}], "]"}]}]}]}]], "Output",
 CellChangeTimes->{
  3.94809003797186*^9, 3.962607352578682*^9, 3.971702601232148*^9, {
   3.971704457902289*^9, 3.971704462869584*^9}, 3.971751538009059*^9, 
