Cell[CellGroupData[{

Cell["Definitions", "Section",
 CellChangeTimes->{{3.784870893912496*^9, 3.784870902072659*^9}},
 CellID->490632353,ExpressionUUID->"550489a9-af9f-4519-ab18-3fc0aa55e0e4"],

Cell["The ansatz for the effective action is", "Text",
 CellChangeTimes->{{3.901870981232856*^9, 3.90187098327337*^9}, {
   3.902286456418818*^9, 3.902286460910561*^9}, {3.931001860304375*^9, 
   3.931001885366467*^9}, 
   3.931001926530777*^9},ExpressionUUID->"c7fc16a9-73c1-426c-a798-\
f6eb316b035e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalGamma]", "k"], "[", 
     RowBox[{"\[Psi]", ",", 
      FormBox[
       OverscriptBox["\[Psi]", "_"],
       TraditionalForm]}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Integral]", 
      RowBox[{"dx", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["Z", "\[Psi]"], 
          RowBox[{
           FormBox[
            OverscriptBox["\[Psi]", "_"],
            TraditionalForm], "(", "x", ")"}], " ", "i", 
          FormBox[
           RowBox[{
            SuperscriptBox["\[Gamma]", "\[Mu]"], 
            SubscriptBox["\[PartialD]", "\[Mu]"]}],
           TraditionalForm], 
          RowBox[{"\[Psi]", "(", "x", ")"}]}], "+", 
         RowBox[{
          FractionBox["g", 
           RowBox[{"2", 
            SubscriptBox["N", "f"]}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              OverscriptBox["\[Psi]", "_"], "(", "x", ")"}], 
             RowBox[{"\[Psi]", "(", "x", ")"}]}], ")"}], "2"]}]}], ")"}]}]}], 
     "=", 
     RowBox[{
      RowBox[{
       FormBox[
        RowBox[{"\[Integral]", 
         FractionBox[
          RowBox[{
           SuperscriptBox["d", "d"], "q"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], "d"]]}],
        TraditionalForm], " ", 
       FormBox[
        RowBox[{
         SubscriptBox["Z", "\[Psi]"], 
         OverscriptBox["\[Psi]", "_"]}],
        TraditionalForm], 
       RowBox[{"(", 
        RowBox[{"-", "q"}], ")"}], 
       FormBox[
        RowBox[{
         SuperscriptBox["\[Gamma]", "\[Mu]"], 
         SubscriptBox["q", "\[Mu]"]}],
        TraditionalForm], 
       RowBox[{"\[Psi]", "(", "q", ")"}]}], "+", 
      RowBox[{
       FormBox[
        RowBox[{"\[Integral]", 
         FractionBox[
          RowBox[{
           SuperscriptBox["d", "d"], 
           SubscriptBox["q", "1"], 
           SuperscriptBox["d", "d"], 
           SubscriptBox["q", "2"], 
           SuperscriptBox["d", "d"], 
           SubscriptBox["q", "3"]}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], 
           RowBox[{"3", "d"}]]]}],
        TraditionalForm], " ", 
       RowBox[{
        FormBox[
         OverscriptBox["\[Psi]", "_"],
         TraditionalForm], "(", 
        SubscriptBox["q", "1"], ")"}], 
       RowBox[{"\[Psi]", "(", 
        SubscriptBox["q", "2"], ")"}], 
       RowBox[{
        FormBox[
         OverscriptBox["\[Psi]", "_"],
         TraditionalForm], "(", 
        SubscriptBox["q", "3"], ")"}], 
       RowBox[{"\[Psi]", "(", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["q", "1"]}], "-", 
         SubscriptBox["q", "2"], "-", 
         SubscriptBox["q", "3"]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"7a3fe7db-eb9e-4872-b3d9-97a0c607a6d8"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
  3.902286509132814*^9}, {3.902286556687783*^9, 3.902286559535182*^9}, {
  3.902286641073317*^9, 
  3.902286644237081*^9}},ExpressionUUID->"29bb4184-d0e4-4f67-bf96-\
1abe3082e207"],

Cell[TextData[{
 "For the Fourier transformation, the convention ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", "x", ")"}], "=", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["d", "d"], "q"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
      RowBox[{"\[CapitalPhi]", "(", "q", ")"}], " ", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"q", "\[CenterDot]", "x"}]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"f081d4d5-e075-4ece-a139-e91e4792425b"],
 " was used for fermions ",
 StyleBox["and",
  FontSlant->"Italic"],
 " antifermions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "=", 
    RowBox[{"{", 
     RowBox[{"\[Psi]", ",", 
      OverscriptBox["\[Psi]", "_"]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"962f2857-803d-41e5-b2a2-c6de3e5493cf"],
 ". This entails that both fermion and antifermion momenta in vertices are \
incoming (and outgoing in propagators)."
}], "Text",
 CellChangeTimes->{{3.901870990423199*^9, 3.901871117336906*^9}, 
   3.902285470348755*^9, 3.9022866614112053`*^9, {3.902286710447488*^9, 
   3.902286727746322*^9}, {3.902406540983011*^9, 3.902406604328875*^9}, {
   3.931001698385118*^9, 3.93100173086585*^9}, {3.97170233673345*^9, 
   3.9717023440136642`*^9}},ExpressionUUID->"3e371d28-2823-4b78-86e2-\
0154fdea0220"],

Cell["\<\
Fields are defined as fermions and antifermions with specific indices as \
follows.
setFields is required for doRGE below, while defineFieldsSpecific defines for \
getAE which arguments and indices the fields possess. In this case, that is \
Dirac and flavor indices. The first argument is reserved for momentum.\
\>", "Text",
 CellChangeTimes->{{3.783251062158726*^9, 3.783251067510545*^9}, {
   3.784874018086397*^9, 3.784874025878702*^9}, 3.9018711197307177`*^9, {
   3.902286744714833*^9, 3.902286774979347*^9}, {3.90230004458329*^9, 
   3.902300055178102*^9}, {3.902406632398738*^9, 3.902406721593834*^9}, {
   3.905318093495015*^9, 3.9053180953746233`*^9}, 3.931001747954072*^9, {
   3.94808968015911*^9, 3.9480897149975033`*^9}},
 CellID->1988807061,ExpressionUUID->"528646e2-0533-40e9-a725-3a98b1c0ce70"],

Cell[BoxData[
 RowBox[{"setFields", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"psi", ",", "psib"}], "}"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.767930707234602*^9, 3.7679307168094*^9}},
 CellLabel->"In[2]:=",
 CellID->1559618771,ExpressionUUID->"f9c28285-48e4-4d60-b2af-654ded6294fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"defineFieldsSpecific", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", "[", 
       RowBox[{"momentum", ",", "dirac", ",", "flavor"}], "]"}], ",", 
      RowBox[{"psib", "[", 
       RowBox[{"momentum", ",", "dirac", ",", "flavor"}], "]"}]}], "}"}], 
    "}"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.507353532488787*^9, 3.507353536844699*^9}},
 CellLabel->"In[3]:=",
 CellID->565688341,ExpressionUUID->"70f28553-17ab-4a8c-b49f-2d06f30e60ea"],

Cell["\<\
Since the effective average action in momentum space is needed for the \
derivation of Feynman rules later, it is given here as such. However, one \
could also use a symbolic action in doRGE. The regulator is included as well \
and diracM represents a slashed momentum (Feynman notation).
Note that all momenta in the fields of the action are defined with the same \
convention for the Fourier transformation (as opposed to the possibility to \
use opposite signs for fermions and antifermions).\
\>", "Text",
 CellChangeTimes->{{3.783251085437203*^9, 3.783251086885172*^9}, {
  3.784874035655005*^9, 3.784874070823625*^9}, {3.901870778225658*^9, 
  3.901870786613304*^9}, {3.90187112788999*^9, 3.9018711381451397`*^9}, {
  3.902285500881811*^9, 3.902285504751268*^9}, {3.902300082605207*^9, 
  3.9023000893654747`*^9}, {3.9024071064648037`*^9, 3.902407197985067*^9}, {
  3.902407445841847*^9, 3.902407446043285*^9}, {3.902823289893444*^9, 
  3.902823308804714*^9}, {3.9053181271184397`*^9, 3.905318127196525*^9}, {
  3.905568888701027*^9, 3.905568891591693*^9}, {3.9480897496863832`*^9, 
  3.9480897527411947`*^9}, {3.948089795552539*^9, 3.9480897982971487`*^9}, {
  3.972295166140254*^9, 
  3.9722952344217577`*^9}},ExpressionUUID->"0f1fd57f-a41c-4824-9236-\
cb324705c27b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"actionGN", "=", 
   RowBox[{"convertAction", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"diracM", "[", 
       RowBox[{"q", ",", "a", ",", "b"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Z", "[", 
         RowBox[{"q", "^", "2"}], "]"}], "+", 
        RowBox[{"Rs", "[", 
         RowBox[{
          RowBox[{"q", "^", "2"}], ",", "k"}], "]"}]}], ")"}], " ", 
      RowBox[{"op", "[", 
       RowBox[{
        RowBox[{"psib", "[", 
         RowBox[{
          RowBox[{"-", "q"}], ",", "a", ",", "i"}], "]"}], ",", 
        RowBox[{"psi", "[", 
         RowBox[{"q", ",", "b", ",", "i"}], "]"}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"gb", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "Nf"}], ")"}]}], " ", 
      RowBox[{"op", "[", 
       RowBox[{
        RowBox[{"psib", "[", 
         RowBox[{"q1", ",", "a", ",", "i"}], "]"}], ",", 
        RowBox[{"psi", "[", 
         RowBox[{"q2", ",", "a", ",", "i"}], "]"}], ",", 
        RowBox[{"psib", "[", 
         RowBox[{"q3", ",", "b", ",", "j"}], "]"}], ",", 
        RowBox[{"psi", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "q1"}], "-", "q2", "-", "q3"}], ",", "b", ",", "j"}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.507353542328133*^9, 3.507353542328826*^9}, {
   3.7679307317221217`*^9, 3.767930733466935*^9}, {3.9018707543355207`*^9, 
   3.9018707613081617`*^9}, {3.901872101578669*^9, 3.901872111063012*^9}, {
   3.905331902776843*^9, 3.905331909316818*^9}, 3.905332738625601*^9, 
   3.905334438609237*^9},
 CellLabel->"In[4]:=",
 CellID->1877307342,ExpressionUUID->"52b7686a-f819-479c-9e66-da819a31467b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivations", "Section",
 CellChangeTimes->{{3.948089829048134*^9, 
  3.9480898388814297`*^9}},ExpressionUUID->"bf995354-af63-4d70-baba-\
a9b7e64de95d"],

Cell[TextData[{
 "The symbolic equations are derived with doRGE. In the examples below, the \
flow equations for the two-point function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "1"]}], 
    RowBox[{" ", 
     RowBox[{"\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]}]], TraditionalForm]],ExpressionUUID->
  "6bf6c251-d199-4ba9-bc13-216ebfba6a27"],
 " and the four-point function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "1"], " ", 
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "3"], " ", 
     SubscriptBox["i", "4"]}], 
    RowBox[{
     OverscriptBox["\[Psi]", "_"], 
     OverscriptBox["\[Psi]", "_"], " ", "\[Psi]", " ", "\[Psi]"}]], 
   TraditionalForm]],ExpressionUUID->"552259d2-3d32-476d-a5e8-e6aecfa604d6"],
 " are derived. All derivatives are left-derivatives and the order of fields \
in doRGE, for example in vertices V, is such that they are taken in the order \
as written. For instance, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{
      SubscriptBox["i", "2"], " ", 
      SubscriptBox["i", "1"]}], 
     RowBox[{" ", 
      RowBox[{"\[Psi]", 
       OverscriptBox["\[Psi]", "_"]}]}]], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
     RowBox[{
      SubscriptBox["\[Delta]\[Psi]", 
       SubscriptBox["i", "2"]], "\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Psi]", "_"], 
       SubscriptBox["i", "1"]]}]]}], TraditionalForm]],ExpressionUUID->
  "099882d1-f56c-42f9-8401-c281a9597b35"],
 ". The functions doDSE and doRGE, however, apply one derivative after the \
other, starting with the first entry. Thus, to get the DSE for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "1"]}], 
    RowBox[{" ", 
     RowBox[{"\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]}]], TraditionalForm]],ExpressionUUID->
  "72dc684c-025d-44ed-9fc6-6661fd8836a3"],
 ", one calls doDSE[action, {{\[CapitalPsi],i1},{\[CapitalPsi],i2}}]."
}], "Text",
 CellChangeTimes->{{3.90240673833813*^9, 3.902406832740601*^9}, {
   3.902407067636001*^9, 3.902407083360821*^9}, {3.9310020021674232`*^9, 
   3.931002192371374*^9}, {3.948089862154179*^9, 3.948089865118677*^9}, {
   3.948089927549662*^9, 3.948089928666588*^9}, 3.96260730142869*^9, {
   3.971702472600902*^9, 3.9717024916061287`*^9}, {3.9721211008273163`*^9, 
   3.972121187104013*^9}, 
   3.976958055785699*^9},ExpressionUUID->"818ec6c5-9003-4f7c-bece-\
572875d1d2cf"],

Cell[TextData[{
 "The flow equations for the two-point function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "1"]}], 
    RowBox[{" ", 
     RowBox[{"\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]}]], TraditionalForm]],ExpressionUUID->
  "c8e31e9a-a66a-435b-b4ee-5d958c56b586"],
 " and the four-point function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "1"], " ", 
     SubscriptBox["i", "2"], " ", 
