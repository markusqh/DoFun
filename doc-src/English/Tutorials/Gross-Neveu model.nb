Cell[BoxData[
 RowBox[{
  RowBox[{"addIndices", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"flavor", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "m", ",", "n"}], 
