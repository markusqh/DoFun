      RowBox[{"r", "[", "y", "]"}]}], ")"}], "3"], " ", 
   SuperscriptBox[
    RowBox[{"Z", "[", 
     RowBox[{
      SuperscriptBox["k", "2"], " ", "y"}], "]"}], "2"]}]]], "Output",
 CellChangeTimes->{3.976966086923518*^9, 3.9769661490853043`*^9, 
  3.976967355499563*^9, 3.976967599115896*^9, 3.976967717944645*^9, 
