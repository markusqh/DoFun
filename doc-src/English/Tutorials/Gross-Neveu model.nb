   3.972296352584133*^9, 3.972296355918962*^9}},
 CellLabel->"In[13]:=",
 CellID->1664779243,ExpressionUUID->"bbe78cd5-b675-42ee-a642-934d396f87dd"],

Cell[TextData[{
 "Note that the Dirac indices are written with the index of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Psi]", "_"], TraditionalForm]],ExpressionUUID->
  "1ba23b82-b6e5-4c27-9d4b-8cbf3057b8de"],
 " left of the index of \[Psi]."
}], "Text",
