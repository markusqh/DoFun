Cell["And the algebraic expression for vanishing momenta:", "Text",
 CellChangeTimes->{{3.784871998258298*^9, 3.784872007474838*^9}},
 CellID->686115744,ExpressionUUID->"07df1c7b-7f66-4d3a-af27-5d945ad63ab6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sixPointAlg", "=", 
   RowBox[{"Plus", "@@", 
    RowBox[{"getAE", "[", 
     RowBox[{"sixPoint", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"psi", ",", "i1", ",", "0", ",", "a1", ",", "j1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psi", ",", "i2", ",", "0", ",", "a2", ",", "j2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psi", ",", "i3", ",", "0", ",", "a3", ",", "j3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psib", ",", "i4", ",", "0", ",", "a4", ",", "j4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psib", ",", "i5", ",", "0", ",", "a5", ",", "j5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psib", ",", "i6", ",", "0", ",", "a6", ",", "j6"}], "}"}]}],
        "}"}]}], "]"}]}]}], ";"}]], "Input",
