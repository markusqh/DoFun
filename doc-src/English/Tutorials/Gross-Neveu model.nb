}, Open  ]],

Cell["\<\
With an appropriate projector the equation for the four-point coupling is \
obtained:\
\>", "Text",
 CellChangeTimes->{{3.783252663197487*^9, 3.783252664637649*^9}, {
  3.784871764192369*^9, 3.784871831441179*^9}, {3.9024132123019657`*^9, 
  3.9024132391215878`*^9}},
 CellID->103095197,ExpressionUUID->"b24d567c-23f4-4497-8f3b-faa44d63525b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"projector", "=", 
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{
      RowBox[{"psib", "[", 
       RowBox[{"p1", ",", "a", ",", "i"}], "]"}], ",", 
      RowBox[{"psib", "[", 
       RowBox[{"p2", ",", "b", ",", "j"}], "]"}], ",", 
      RowBox[{"psi", "[", 
       RowBox[{"p3", ",", "c", ",", "m"}], "]"}], ",", 
      RowBox[{"psi", "[", 
       RowBox[{"p4", ",", "d", ",", "l"}], "]"}], ",", 
      RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], "/", "gb"}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fourPointAlgSimProj", "=", 
   RowBox[{
    RowBox[{"FixedPoint", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"integrateDeltas", "[", "#", "]"}], "/.", "diracRules"}], 
       "&"}], ",", 
      RowBox[{"projector", " ", "fourPointAlgSim"}]}], "]"}], "/.", 
    "dimRules"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lhs", "=", 
   RowBox[{
    RowBox[{"integrateDeltas", "[", 
     RowBox[{"projector", "  ", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{
         RowBox[{"psib", "[", 
          RowBox[{"p1", ",", "a", ",", "i"}], "]"}], ",", 
         RowBox[{"psib", "[", 
          RowBox[{"p2", ",", "b", ",", "j"}], "]"}], ",", 
         RowBox[{"psi", "[", 
          RowBox[{"p3", ",", "c", ",", "m"}], "]"}], ",", 
         RowBox[{"psi", "[", 
          RowBox[{"p4", ",", "d", ",", "l"}], "]"}], ",", 
         RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], "/", "gb"}]}], 
     "]"}], "/.", "dimRules"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.507364445551878*^9, 3.507364445553214*^9}, {
   3.783252677237475*^9, 3.783252719958667*^9}, {3.7848691172919292`*^9, 
   3.784869125913125*^9}, {3.78487002411512*^9, 3.784870024705193*^9}, 
   3.976969308269623*^9},
 CellLabel->"In[324]:=",
 CellID->1487701802,ExpressionUUID->"94370ad0-1cc0-40cb-a604-6c7329cb2782"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "gb"], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      FractionBox["1", "Nf"], 
      RowBox[{"gb", " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "a", ",", "c"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "b", ",", "d"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"flavor", ",", "i", ",", "m"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"flavor", ",", "j", ",", "l"}], "]"}]}]}]}], "+", 
    RowBox[{
     FractionBox["1", "Nf"], 
     RowBox[{"gb", " ", 
      RowBox[{"delta", "[", 
       RowBox[{"dirac", ",", "a", ",", "d"}], "]"}], " ", 
      RowBox[{"delta", "[", 
       RowBox[{"dirac", ",", "b", ",", "c"}], "]"}], " ", 
      RowBox[{"delta", "[", 
       RowBox[{"flavor", ",", "i", ",", "l"}], "]"}], " ", 
      RowBox[{"delta", "[", 
       RowBox[{"flavor", ",", "j", ",", "m"}], "]"}]}]}]}], ")"}]}]], "Output",\

 CellChangeTimes->{3.976969309698001*^9, 3.97696935935399*^9, 
  3.976969927990831*^9},
 CellLabel->
  "Out[324]=",ExpressionUUID->"b96094e7-e00b-42e8-b24f-c118ebbcf8e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"beta", "=", 
  RowBox[{
   RowBox[{"fourPointAlgSimProj", "/", "lhs"}], "//", "Simplify"}]}]], "Input",\

 CellChangeTimes->{{3.507364453494417*^9, 3.507364453495094*^9}},
