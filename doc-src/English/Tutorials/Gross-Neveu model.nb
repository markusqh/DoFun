Cell[TextData[{
 "Inserting the explicit expressions for the Feynman rules, the algebraic \
expression for the two-point function ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "1"]}], 
    RowBox[{" ", 
     RowBox[{"\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]}]], TraditionalForm]],ExpressionUUID->
  "38201a70-90ca-439c-8980-a783202afebd"],
 " for zero external momentum is obtained as"
}], "Text",
