Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"r", "[", "y", "]"}]}], ")"}], "2"], " ", 
    RowBox[{"Z", "[", 
     RowBox[{
      SuperscriptBox["k", "2"], " ", "y"}], "]"}]}]], 
  RowBox[{"4", " ", "dgamma", " ", 
   SuperscriptBox["g", "2"], " ", 
   SuperscriptBox["k", 
    RowBox[{"3", "-", "d"}]], " ", 
   SuperscriptBox["y", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "d"}], ")"}]}]], " ", 
   RowBox[{"v", "[", "d", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p1", "+", "p3", "-", 
          RowBox[{"k", " ", 
           SqrtBox["y"]}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"r", "[", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"p1", "+", "p3", "-", 
               RowBox[{"k", " ", 
                SqrtBox["y"]}]}], ")"}], "2"], 
            SuperscriptBox["k", "2"]], "]"}]}], ")"}], " ", 
        RowBox[{"Z", "[", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"p1", "+", "p3", "-", 
            RowBox[{"k", " ", 
             SqrtBox["y"]}]}], ")"}], "2"], "]"}]}]]}], "-", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p2", "+", "p3", "-", 
         RowBox[{"k", " ", 
          SqrtBox["y"]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"r", "[", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"p2", "+", "p3", "-", 
              RowBox[{"k", " ", 
               SqrtBox["y"]}]}], ")"}], "2"], 
           SuperscriptBox["k", "2"]], "]"}]}], ")"}], " ", 
       RowBox[{"Z", "[", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"p2", "+", "p3", "-", 
           RowBox[{"k", " ", 
            SqrtBox["y"]}]}], ")"}], "2"], "]"}]}]]}], ")"}], " ", 
   RowBox[{
