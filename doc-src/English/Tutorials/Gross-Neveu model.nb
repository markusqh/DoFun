Cell[TextData[{
 "To obtain algebraic expressions, Feynman rules are needed. They can be \
defined manually or with the help of getFR. When getFR is used, the order of \
fields for the derivatives is the same as for doRGE. Thus, the two- and \
four-point functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{
      SubscriptBox["i", "2"], " ", 
      SubscriptBox["i", "1"]}], 
     RowBox[{" ", 
      RowBox[{"\[Psi]", 
       OverscriptBox["\[Psi]", "_"]}]}]]}], TraditionalForm]],ExpressionUUID->
  "7901c743-a343-4d65-9247-651e76065fec"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "1"], " ", 
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "3"], " ", 
     SubscriptBox["i", "4"]}], 
    RowBox[{
     OverscriptBox["\[Psi]", "_"], 
     OverscriptBox["\[Psi]", "_"], " ", "\[Psi]", " ", "\[Psi]"}]], 
   TraditionalForm]],ExpressionUUID->"dd0a5894-f5c7-46c5-850e-83ce33088855"],
 ", respectively, are given by the following expressions:"
}], "Text",
 CellChangeTimes->{{3.7832511151021852`*^9, 3.783251117486171*^9}, {
   3.7848697244937572`*^9, 3.784869893937498*^9}, {3.784871092827022*^9, 
   3.784871120155568*^9}, {3.7848717502175503`*^9, 3.784871750217659*^9}, {
   3.902300358145675*^9, 3.902300369754521*^9}, {3.902407831474555*^9, 
   3.902407831793129*^9}, {3.902413088738998*^9, 3.902413089077066*^9}, {
   3.931002242845085*^9, 3.9310022515318117`*^9}, {3.93100229545946*^9, 
   3.931002305073407*^9}, {3.931002407783385*^9, 3.93100240952447*^9}, 
   3.962607335974451*^9, {3.972121090956584*^9, 3.9721210926372128`*^9}, {
   3.972121472278338*^9, 3.972121474298676*^9}, 3.972296045153082*^9, {
   3.97229627893979*^9, 3.972296305954235*^9}},
 CellID->1356600653,ExpressionUUID->"4a4f1406-5403-414f-bd01-c0dc87df1ed7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "FR2Point", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FR2Point", "[", 
   RowBox[{
    RowBox[{"psi", "[", 
     RowBox[{"p2_", ",", "b_", ",", "j_"}], "]"}], ",", 
    RowBox[{"psib", "[", 
     RowBox[{"p1_", ",", "a_", ",", "i_"}], "]"}]}], "]"}], "=", 
  RowBox[{
   RowBox[{"getFR", "[", 
    RowBox[{"actionGN", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"psib", "[", 
        RowBox[{"p1", ",", "a", ",", "i"}], "]"}], ",", 
       RowBox[{"psi", "[", 
        RowBox[{"p2", ",", "b", ",", "j"}], "]"}]}], "}"}]}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
