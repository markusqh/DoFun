Cell[TextData[{
 "The Feynman rules can be applied with getAE. It takes care of momentum \
routing and inserting all indices. One can use the option ",
 StyleBox["explicit",
  FontSlant->"Italic"],
 " set to ",
 StyleBox["False to",
  FontSlant->"Italic"],
 " illustrates that:"
}], "Text",
