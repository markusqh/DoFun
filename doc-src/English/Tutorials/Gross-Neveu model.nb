Cell[TextData[{
 "We now define Feynman rules for the propagator, the four-point function and \
the regulator as given by the expressions above. The regulator must be \
treated like a vertex, hence the different order of fields in comparison to \
the propagator.\nImportant: The propagator function P[\[Psi],",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Psi]", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e7fa42ec-5a73-4fb7-9cec-185bcfc2d64b"],
 "] corresponds to the propagator ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "W"}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      OverscriptBox["\[Eta]", "_"]}], 
     RowBox[{"\[PartialD]", "\[Eta]"}]}]], TraditionalForm]],ExpressionUUID->
  "691cdad1-34ce-4f64-bace-c13921ce3c4c"],
 ". It is written such that its arguments coincide exactly with the ones of \
the vertices (as can be seen below). This includes the momenta. Hence, the \
propagator P is defined with ",
 StyleBox["outgoing",
  FontSlant->"Italic"],
 " momenta."
}], "Text",
 CellChangeTimes->{{3.783251402087451*^9, 3.783251418812517*^9}, 
   3.7848712877240567`*^9, {3.7848741662002296`*^9, 3.784874229272229*^9}, {
   3.9053182828992662`*^9, 3.9053182941987243`*^9}, {3.905334679454233*^9, 
   3.905334807918588*^9}, {3.905568134687037*^9, 3.905568152395654*^9}, {
   3.905568961045857*^9, 3.905568962526198*^9}, {3.931002482838512*^9, 
   3.931002666181941*^9}, {3.9310044611923738`*^9, 3.931004462006279*^9}, {
   3.971702636382073*^9, 3.971702644068158*^9}, 3.9721216809494247`*^9, {
   3.9722963340832453`*^9, 3.972296350174706*^9}, {3.97695810528193*^9, 
   3.976958114355795*^9}},
 CellID->1245402537,ExpressionUUID->"166364d1-15bc-4ef0-8439-bda7e320b49c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{
     RowBox[{"psi", "[", 
      RowBox[{"p2_", ",", "b_", ",", "j_"}], "]"}], ",", 
     RowBox[{"psib", "[", 
      RowBox[{"p1_", ",", "a_", ",", "i_"}], "]"}], ",", 
     RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"delta", "[", 
     RowBox[{"flavor", ",", "i", ",", "j"}], "]"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"diracM", "[", 
       RowBox[{
        RowBox[{"-", "p1"}], ",", "b", ",", "a"}], "]"}], "/", 
      RowBox[{"p1", "^", "2"}]}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Z", "[", 
        RowBox[{"p1", "^", "2"}], "]"}], "+", 
       RowBox[{"Rs", "[", 
        RowBox[{
         RowBox[{"p1", "^", "2"}], ",", "k"}], "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{
     RowBox[{"psib", "[", 
      RowBox[{"p1_", ",", "a_", ",", "i_"}], "]"}], ",", 
     RowBox[{"psib", "[", 
      RowBox[{"p2_", ",", "b_", ",", "j_"}], "]"}], ",", 
     RowBox[{"psi", "[", 
      RowBox[{"p3_", ",", "c_", ",", "m_"}], "]"}], ",", 
     RowBox[{"psi", "[", 
      RowBox[{"p4_", ",", "d_", ",", "l_"}], "]"}], ",", 
     RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"FR4Point", "[", 
      RowBox[{
       RowBox[{"psib", "[", 
        RowBox[{"p1", ",", "a", ",", "i"}], "]"}], ",", 
       RowBox[{"psib", "[", 
        RowBox[{"p2", ",", "b", ",", "j"}], "]"}], ",", 
       RowBox[{"psi", "[", 
        RowBox[{"p3", ",", "c", ",", "m"}], "]"}], ",", 
       RowBox[{"psi", "[", 
        RowBox[{"p4", ",", "d", ",", "l"}], "]"}]}], "]"}], "/", 
     RowBox[{"deltam", "[", 
      RowBox[{"p1", "+", "p2", "+", "p3", "+", "p4"}], "]"}]}], "//", 
    "Expand"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dR", "[", 
    RowBox[{
     RowBox[{"psib", "[", 
      RowBox[{"p1_", ",", "a_", ",", "i_"}], "]"}], ",", 
     RowBox[{"psi", "[", 
      RowBox[{"p2_", ",", "b_", ",", "j_"}], "]"}], ",", 
     RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"diracM", "[", 
     RowBox[{"p2", ",", "a", ",", "b"}], "]"}], " ", 
    RowBox[{"delta", "[", 
     RowBox[{"flavor", ",", "i", ",", "j"}], "]"}], " ", 
    RowBox[{"dRs", "[", 
     RowBox[{
      RowBox[{"p1", "^", "2"}], ",", "k"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.507353572847446*^9, 3.507353576716747*^9}, {
   3.507364226775764*^9, 3.507364226860038*^9}, 3.507364401073507*^9, 
   3.783252803064094*^9, {3.784874197818392*^9, 3.784874197978567*^9}, {
   3.901872126942224*^9, 3.901872127909329*^9}, 3.905564454326191*^9, 
   3.905568827352385*^9, {3.971702759388398*^9, 3.971702895574935*^9}, {
   3.971702982599062*^9, 3.971703014364249*^9}, {3.97170373763099*^9, 
   3.9717037391850777`*^9}, {3.971703866559906*^9, 3.971703896117326*^9}, {
   3.971704027740233*^9, 3.9717040813291073`*^9}, {3.971704859548469*^9, 
   3.971704876588003*^9}, {3.9717049190015497`*^9, 3.971704946151135*^9}, {
   3.971751587989182*^9, 3.971751610971999*^9}, {3.972127517375573*^9, 
