Cell["\<\
With some additional rules the equation is rendered dimensionless:\
\>", "Text",
 CellChangeTimes->{{3.784871847473207*^9, 3.784871859073657*^9}, {
  3.902413248812175*^9, 3.902413257985907*^9}},
 CellID->539860501,ExpressionUUID->"2a12eb16-6f0d-4c12-bf93-53fe9c7e813b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dimLessRulesGN", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Rs", "[", 
       RowBox[{"x_", ",", "k"}], "]"}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"x", "/", 
         RowBox[{"k", "^", "2"}]}], "]"}], " ", 
       RowBox[{"Z", "[", "x", "]"}]}]}], ",", 
     RowBox[{"gb", "\[Rule]", 
      RowBox[{"g", " ", 
       RowBox[{"k", "^", 
        RowBox[{"(", 
         RowBox[{"2", "-", "d"}], ")"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"dRs", "[", 
       RowBox[{
        RowBox[{"q1", "^", "2"}], ",", "k"}], "]"}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "y", " ", 
       RowBox[{"Z", "[", 
        RowBox[{"q1", "^", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"r", "'"}], "[", "y", "]"}]}]}], ",", 
     RowBox[{"q1", "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"Sqrt", "[", "y", "]"}], " ", "k"}]}], ",", 
     RowBox[{"dq1", "\[RuleDelayed]", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", "2"}], "/", "2"}], "/", "q1"}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.507364464326525*^9, 3.507364464327523*^9}, {
  3.976967562164431*^9, 3.976967595933628*^9}},
 CellLabel->"In[328]:=",
 CellID->540689582,ExpressionUUID->"af3003e0-89f9-4918-a554-506c46e546ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"angleInt", "[", "d_", "]"}], ":=", 
   RowBox[{"4", 
    RowBox[{"v", "[", "d", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.50736447171069*^9, 3.507364471711358*^9}},
 CellLabel->"In[329]:=",
 CellID->1070441613,ExpressionUUID->"9fceb15a-5f4b-4bbf-a62a-4052f93660f3"],

Cell["Finally, the beta function in dimensionless quantities is", "Text",
 CellChangeTimes->{{3.784871866001163*^9, 3.784871867345619*^9}, {
  3.784871902257728*^9, 3.784871913489979*^9}, {3.9024132642744703`*^9, 
  3.902413264662528*^9}},
 CellID->1979129148,ExpressionUUID->"afde35c8-b655-45a3-b64f-6490605783e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"betaDimLessPre", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"angleInt", "[", "d", "]"}], " ", "dq1", " ", 
      RowBox[{"q1", "^", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}], " ", "beta"}], "//.", 
     "dimLessRulesGN"}], "//", "Expand"}]}], ";"}], "\n", 
 RowBox[{"betaDimLess", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"betaDimLessPre", ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"Element", "[", 
      RowBox[{"d", ",", "Integers"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.507364478485803*^9, 3.507364478486805*^9}, 
