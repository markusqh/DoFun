Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   SuperscriptBox["g", "2"], " ", 
   SuperscriptBox["k", 
    RowBox[{"2", "-", "d"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "2"}], "+", 
     RowBox[{"dgamma", " ", "Nf"}]}], ")"}], " ", 
   SuperscriptBox["y", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox["d", "2"]}]], " ", 
   RowBox[{"v", "[", "d", "]"}], " ", 
   RowBox[{
    SuperscriptBox["r", "\[Prime]",
     MultilineFunction->None], "[", "y", "]"}]}], 
  RowBox[{"Nf", " ", 
