 CellLabel->
  "Out[331]=",ExpressionUUID->"450bfb46-737e-432b-b310-3db44288d0ec"]
}, Open  ]],

Cell["\<\
The flow equation of the four-point function with nonvanishing momenta can \
also be obtained:\
\>", "Text",
 CellChangeTimes->{{3.784872961882947*^9, 3.784872989131711*^9}, {
  3.902413271947461*^9, 3.902413280276638*^9}},
 CellID->1188246153,ExpressionUUID->"7960bbef-0ccf-4c2b-a271-3704c76235ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fourPointAlgFinMom", "=", 
   RowBox[{"Plus", "@@", 
    RowBox[{"getAE", "[", 
     RowBox[{"fourPoint", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"psib", ",", "i1", ",", "p1", ",", "a", ",", "i"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psib", ",", "i2", ",", "p2", ",", "b", ",", "j"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psi", ",", "i3", ",", "p3", ",", "c", ",", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"psi", ",", "i4", ",", "p4", ",", "d", ",", "l"}], "}"}]}], 
       "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.5073653237703*^9, 3.507365323771276*^9}, 
   3.507365485945343*^9, {3.507393511622745*^9, 3.507393524841758*^9}, 
   3.507393589223427*^9, 3.507439098538533*^9, {3.784870156932371*^9, 
   3.7848701603228283`*^9}, {3.7848729996949863`*^9, 3.784873001740849*^9}},
 CellLabel->"In[332]:=",
 CellID->1096066258,ExpressionUUID->"c9852560-dd4e-4199-a42c-05b493a598e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fourPointAlgFinMomProj", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"FixedPoint", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"integrateDeltas", "[", "#", "]"}], "/.", "diracRules"}], 
        "&"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{
           RowBox[{"psib", "[", 
            RowBox[{"p1", ",", "a", ",", "i"}], "]"}], ",", 
           RowBox[{"psib", "[", 
            RowBox[{"p2", ",", "b", ",", "j"}], "]"}], ",", 
           RowBox[{"psi", "[", 
            RowBox[{"p3", ",", "c", ",", "m"}], "]"}], ",", 
           RowBox[{"psi", "[", 
            RowBox[{"p4", ",", "d", ",", "l"}], "]"}], ",", 
           RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], "/", "gb"}], " ",
         "fourPointAlgFinMom"}]}], "]"}], "/.", "dimRules"}], "/.", 
    RowBox[{"p4", ":>", 
     RowBox[{
      RowBox[{"-", "p1"}], "-", "p2", "-", "p3"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"betaFinMom", "=", 
   RowBox[{"fourPointAlgFinMomProj", "/", "lhs"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.50736534173082*^9, 3.507365341731666*^9}, {
   3.507365376910561*^9, 3.507365377262496*^9}, {3.5073654457441797`*^9, 
   3.507365453967389*^9}, 3.507365491196381*^9, {3.507393517098914*^9, 
