        RowBox[{"dirac", ",", "a", ",", "c"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "b", ",", "d"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"flavor", ",", "i", ",", "m"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"flavor", ",", "j", ",", "l"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "a", ",", "d"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "b", ",", "c"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"flavor", ",", "i", ",", "l"}], "]"}], " ", 
       RowBox[{"delta", "[", 
        RowBox[{"flavor", ",", "j", ",", "m"}], "]"}]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      RowBox[{
       RowBox[{"dim", "[", "dirac", "]"}], " ", 
       RowBox[{"dim", "[", "flavor", "]"}]}]}], ")"}], " ", 
    RowBox[{"dRs", "[", 
     RowBox[{
      SuperscriptBox["q1", "2"], ",", "k"}], "]"}]}], ")"}], "/", 
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["Nf", "2"], " ", 
    SuperscriptBox["q1", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Rs", "[", 
        RowBox[{
         SuperscriptBox["q1", "2"], ",", "k"}], "]"}], "+", 
       RowBox[{"Z", "[", 
        SuperscriptBox["q1", "2"], "]"}]}], ")"}], "3"]}], ")"}]}]], "Output",\

 CellChangeTimes->{
  3.976966074490076*^9, 3.976966144296801*^9, 3.9769686520523863`*^9, 
   3.976968805895659*^9, 3.976968913156307*^9, {3.976969052300419*^9, 
