Cell[CellGroupData[{

Cell["Gross-Neveu model", "Title",
 CellID->509267359,ExpressionUUID->"5ad4d6f9-a109-4747-99ad-abd4139bfd3d"],

Cell[TextData[{
 "This tutorial describes the derivation of flow equations for the \
Gross-Neveu model, see, e.g., ",
 ButtonBox["Braun, Gies, Scherer, Phys.Rev.D 83 (2011) 085012, \
arXiv:1011.1456 [hep-th]",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://inspirehep.net/literature/875738"], None},
  ButtonNote->"https://inspirehep.net/literature/875738"],
 "."
}], "Text",
 CellChangeTimes->{{3.784870848360153*^9, 3.784870869144309*^9}, {
  3.902285446902474*^9, 3.902285447028405*^9}, {3.902286348129747*^9, 
  3.902286426703032*^9}, {3.902824905235797*^9, 3.902824907905432*^9}, {
  3.902824955305677*^9, 3.902824955711185*^9}, {3.9310016607331867`*^9, 
  3.9310016788758287`*^9}},
 CellID->1534169418,ExpressionUUID->"2ea02407-09b3-4b62-8546-cb71abb20bfc"],

Cell[TextData[{
 "The Gross-Neveu model is also used as an example in Sec. 5.2 of the paper \
accompanying the publication of DoFun 2, ",
 ButtonBox["Huber, Braun, Comput.Phys.Commun. 183 (2012) 1290, \
arXiv:1102.5307 [hep-th]",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://inspirehep.net/literature/890744"], None},
  ButtonNote->"https://inspirehep.net/literature/890744"],
 ".The present document updates this example to DoFun 3 and ",
 StyleBox["supersedes the former document",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.902406367246457*^9, 3.9024063864453177`*^9}, {
  3.902406416882166*^9, 3.902406439132787*^9}, {3.902406476450681*^9, 
  3.902406499354648*^9}, {3.90240697522844*^9, 3.902407045174225*^9}, {
  3.905318048763517*^9, 
  3.905318049027546*^9}},ExpressionUUID->"ae58c9dc-5278-45a7-a6b1-\
ec5bd706b247"],

