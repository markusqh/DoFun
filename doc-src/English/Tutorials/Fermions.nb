Cell["\<\
Thus we define the bare two-point function and the propagator as\
\>", "Text",
 CellChangeTimes->{{3.971693139315435*^9, 
  3.9716931493921556`*^9}},ExpressionUUID->"afd787e4-d259-4022-b525-\
dbaef5c5d637"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", 
    RowBox[{
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"p1_", ",", "c1_", ",", "i1_"}], "]"}], ",", 
     RowBox[{"\[CapitalPsi]b", "[", 
      RowBox[{"p2_", ",", "c2_", ",", "i2_"}], "]"}], ",", 
     RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], ":=", 
   RowBox[{"(*", " ", 
    RowBox[{"p1", " ", "incoming", " ", "quark", " ", "momentum"}], " ", 
    "*)"}], 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "mu", "}"}], ",", 
     RowBox[{"Z2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", "   ", 
         RowBox[{"vec", "[", 
          RowBox[{"p1", ",", "mu"}], "]"}], 
         RowBox[{"diracGamma", "[", 
          RowBox[{"mu", ",", "i2", ",", "i1"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"delta", "[", 
          RowBox[{"dirac", ",", "i2", ",", "i1"}], "]"}], "Zm", " ", "m"}]}], 
       ")"}], 
      RowBox[{"delta", "[", 
       RowBox[{"fund", ",", "c1", ",", "c2"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"p1_", ",", "c1_", ",", "i1_"}], "]"}], ",", 
     RowBox[{"\[CapitalPsi]b", "[", 
      RowBox[{"p2_", ",", "c2_", ",", "i2_"}], "]"}], ",", 
     RowBox[{"explicit", "\[Rule]", "True"}]}], "]"}], ":=", 
   RowBox[{"(*", " ", 
    RowBox[{"p2", " ", "outgoing", " ", "quark", " ", "momentum"}], " ", 
    "*)"}], 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "mu", "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"DquA", "[", 
            RowBox[{"sp", "[", "p1", "]"}], "]"}]}], " ", "I", " ", 
          RowBox[{"diracGamma", "[", 
           RowBox[{"mu", ",", "i1", ",", "i2"}], "]"}], 
          RowBox[{"vec", "[", 
           RowBox[{
            RowBox[{"-", "p2"}], ",", "mu"}], "]"}]}], "+", " ", 
         RowBox[{
          RowBox[{"delta", "[", 
           RowBox[{"dirac", ",", "i1", ",", "i2"}], "]"}], 
          RowBox[{"DquB", "[", 
           RowBox[{"sp", "[", "p1", "]"}], "]"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"sp", "[", "p1", "]"}], " ", 
          RowBox[{
           RowBox[{"DquA", "[", 
            RowBox[{"sp", "[", "p1", "]"}], "]"}], "^", "2"}]}], "+", 
         RowBox[{
          RowBox[{"DquB", "[", 
           RowBox[{"sp", "[", "p1", "]"}], "]"}], "^", "2"}]}], ")"}]}], 
      RowBox[{"delta", "[", 
       RowBox[{"fund", ",", "c1", ",", "c2"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "[", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"p1_", ",", "a_", ",", "mu_"}], "]"}], ",", 
    RowBox[{"A", "[", 
     RowBox[{"p2_", ",", "b_", ",", "nu_"}], "]"}], ",", 
    RowBox[{"explicit", "->", "True"}]}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "\[Xi]"], 
   RowBox[{"delta", "[", 
    RowBox[{"adj", ",", "a", ",", "b"}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Z3", " ", "\[Xi]", " ", 
      RowBox[{"metr", "[", 
       RowBox[{"mu", ",", "nu"}], "]"}], " ", 
      RowBox[{"sp", "[", "p1", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Z3", " ", "\[Xi]"}]}], ")"}], " ", 
      RowBox[{"vec", "[", 
       RowBox[{"p1", ",", "mu"}], "]"}], " ", 
      RowBox[{"vec", "[", 
       RowBox[{"p1", ",", "nu"}], "]"}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "[", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"p1_", ",", "a_", ",", "mu_"}], "]"}], ",", 
    RowBox[{"A", "[", 
     RowBox[{"p2_", ",", "b_", ",", "nu_"}], "]"}], ",", 
    RowBox[{"explicit", "->", "True"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"delta", "[", 
    RowBox[{"adj", ",", "a", ",", "b"}], "]"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"metr", "[", 
         RowBox[{"mu", ",", "nu"}], "]"}], "-", 
        RowBox[{
         RowBox[{"vec", "[", 
          RowBox[{"p1", ",", "mu"}], "]"}], 
         RowBox[{
          RowBox[{"vec", "[", 
           RowBox[{"p1", ",", "nu"}], "]"}], "/", 
          RowBox[{"sp", "[", "p1", "]"}]}]}]}], ")"}], 
      RowBox[{
       RowBox[{"Z", "[", 
        RowBox[{"p1", "^", "2"}], "]"}], "/", 
       RowBox[{"sp", "[", "p1", "]"}]}]}], "+", 
     RowBox[{"\[Xi]", " ", 
      RowBox[{"vec", "[", 
       RowBox[{"p1", ",", "mu"}], "]"}], 
      RowBox[{
       RowBox[{"vec", "[", 
        RowBox[{"p1", ",", "nu"}], "]"}], "/", 
       RowBox[{
        RowBox[{"sp", "[", "p1", "]"}], "^", "2"}]}]}]}], ")"}]}]}]}], "Input",\

 CellChangeTimes->{{3.430756186150782*^9, 3.430756223298501*^9}, {
