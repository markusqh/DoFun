        RowBox[{"(", 
         RowBox[{"2", "Nc"}], ")"}]}]}], "*)"}], ",", 
     RowBox[{
      RowBox[{"dim", "[", "fund", "]"}], ":>", "Nc"}]}], "}"}]}], 
