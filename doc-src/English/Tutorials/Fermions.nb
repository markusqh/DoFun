  3.973607942115889*^9}},ExpressionUUID->"8e4e1748-2620-41d6-8ad6-\
75bfb5db5a17"],

Cell["with (all derivatives are from the left)", "Text",
 CellChangeTimes->{{3.948114219983946*^9, 3.948114222127754*^9}, 
   3.972299410752521*^9},ExpressionUUID->"f81417f4-43d5-41d8-8a61-\
8f49e201ea6f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[Eta]", "_"], "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", "\[Delta]\[CapitalPsi]"]}]}], ",",
     " ", 
    RowBox[{"\[Eta]", "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", 
       RowBox[{"\[Delta]", 
        OverscriptBox["\[CapitalPsi]", "_"]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"520e6ef4-6ed4-488d-855d-dd1822e2dfb0"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[CapitalPsi]", "_"], "=", 
     FractionBox["\[Delta]W", "\[Delta]\[Eta]"]}], ",", " ", 
    RowBox[{"\[CapitalPsi]", "=", 
     FractionBox["\[Delta]W", 
      RowBox[{"\[Delta]", 
       OverscriptBox["\[Eta]", "_"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "0154776d-389b-4f75-b646-6dee417e6544"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
