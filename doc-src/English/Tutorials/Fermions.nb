Cell["\<\
The following definition of the action uses some special notation for \
four-vectors (vec), scalar products (sp), the metric tensor (metr) and color \
functions (delta, SUNF, SUNT).\
\>", "Text",
 CellChangeTimes->{{3.977544746346139*^9, 3.9775448037683573`*^9}, {
  3.977544892757703*^9, 
  3.97754489891009*^9}},ExpressionUUID->"5d6dddb2-0eae-4105-b541-\
5cf4e7a5247f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"actionQCD", ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dummy", "=", 
        RowBox[{"insDummy", "[", "]"}]}], ",", 
       RowBox[{"\[Mu]1", "=", 
        RowBox[{"insDummy", "[", "]"}]}], ",", 
       RowBox[{"\[Mu]2", "=", 
        RowBox[{"insDummy", "[", "]"}]}]}], "}"}], ",", 
     RowBox[{"convertAction", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"\[CapitalPsi]b", " ", "\[CapitalPsi]"}], " ", "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           RowBox[{"vec", "[", 
            RowBox[{"p", ",", "\[Mu]1"}], "]"}], 
           RowBox[{"diracGamma", "[", 
            RowBox[{"\[Mu]1", ",", "i", ",", "j"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"delta", "[", 
            RowBox[{"dirac", ",", "i", ",", "j"}], "]"}], "Zm", " ", "m"}]}], 
         ")"}], "Z2", " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"\[CapitalPsi]b", "[", 
           RowBox[{"p", ",", "a", ",", "i"}], "]"}], ",", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{
            RowBox[{"-", "p"}], ",", "a", ",", "j"}], "]"}]}], "]"}]}], "-", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "\[CapitalPsi]b", " ", "\[CapitalPsi]"}], " ", 
        "*)"}], 
       RowBox[{"ZF1", " ", "I", " ", "g", " ", 
        RowBox[{"(", 
         RowBox[{"diracGamma", "[", 
          RowBox[{"\[Mu]2", ",", "i", ",", "j"}], "]"}], ")"}], " ", 
        RowBox[{"SUNT", "[", 
         RowBox[{"a", ",", "b", ",", "d"}], "]"}], " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"\[CapitalPsi]b", "[", 
           RowBox[{"p", ",", "b", ",", "i"}], "]"}], ",", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"q", ",", "d", ",", "j"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "p"}], "-", "q"}], ",", "a", ",", "\[Mu]2"}], 
           "]"}]}], "]"}]}], "+", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "A"}], " ", "*)"}], 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Z3", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"metr", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "-", " ", 
             RowBox[{
              RowBox[{"vec", "[", 
               RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"vec", "[", 
                RowBox[{"p", ",", "\[Nu]"}], "]"}], "/", 
               RowBox[{"sp", "[", "p", "]"}]}]}]}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"1", "/", "\[Xi]"}], "  ", 
           RowBox[{"vec", "[", 
            RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"p", ",", "\[Nu]"}], "]"}], "/", 
            RowBox[{"sp", "[", "p", "]"}]}]}]}], ")"}], " ", 
        RowBox[{"sp", "[", "p", "]"}], " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"p", ",", "a", ",", "\[Mu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{
            RowBox[{"-", "p"}], ",", "a", ",", "\[Nu]"}], "]"}]}], "]"}]}], "+", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "A", " ", "A"}], " ", "*)"}], 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "Z1", " ", "g", " ", 
        RowBox[{"SUNF", "[", 
         RowBox[{"a", ",", "b", ",", "d"}], "]"}], " ", "I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"vec", "[", 
             RowBox[{"p", ",", "\[Mu]"}], "]"}]}], " ", 
           RowBox[{"op", "[", 
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"p", ",", "a", ",", "\[Nu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{"q", ",", "b", ",", "\[Mu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "p"}], "-", "q"}], ",", "d", ",", "\[Nu]"}], 
              "]"}]}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"p", ",", "\[Nu]"}], "]"}], " ", 
           RowBox[{"op", "[", 
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"p", ",", "a", ",", "\[Mu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{"q", ",", "b", ",", "\[Mu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "p"}], "-", "q"}], ",", "d", ",", "\[Nu]"}], 
              "]"}]}], "]"}]}]}], ")"}]}], "+", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "A", " ", "A", " ", "A"}], " ", "*)"}], 
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", "Z4", " ", 
        RowBox[{"g", "^", "2"}], " ", 
        RowBox[{"SUNF", "[", 
         RowBox[{"a", ",", "b", ",", "dummy"}], "]"}], " ", 
        RowBox[{"SUNF", "[", 
         RowBox[{"e", ",", "f", ",", "dummy"}], "]"}], " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"p", ",", "a", ",", "\[Mu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{"q", ",", "b", ",", "\[Nu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{"r", ",", "e", ",", "\[Mu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "p"}], "-", "q", "-", "r"}], ",", "f", ",", 
            "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetAttributes", "[", 
  RowBox[{"metr", ",", "Orderless"}], "]"}]}], "Input",
 CellChangeTimes->{{3.508572793562947*^9, 3.508572793566254*^9}, {
   3.585301594188297*^9, 3.585301595110676*^9}, {3.585301640914011*^9, 
   3.585301644033986*^9}, 3.585301863709687*^9, {3.585395705829302*^9, 
