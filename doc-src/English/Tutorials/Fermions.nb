  "],ExpressionUUID->"b520fb2f-13cc-4e9c-a3da-bef6627516f5"],

Cell[TextData[{
 "Multiplying with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "i"], 
       SubscriptBox["\[Delta]\[Phi]", "l"]}]], ")"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "37c5def7-10e1-4191-b32f-bd61975a0951"],
 " yields:\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Phi]", "j"], 
        SubscriptBox["\[Delta]\[Phi]", "l"]}]], ")"}], 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       SubsuperscriptBox["\[Epsilon]", 
        SubscriptBox["\[Phi]", "k"], 
        SubscriptBox["\[Phi]", "k"]], "(", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Phi]", "i"], 
         SubscriptBox["\[Delta]\[Phi]", "l"]}]], ")"}], 
      RowBox[{"-", "1"}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "i"], 
       SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Xi]", "k"], 
        SubscriptBox["\[Delta]\[Xi]", "j"]}]],
      TraditionalForm]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Phi]", "j"], 
        SubscriptBox["\[Delta]\[Phi]", "l"]}]], ")"}], 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "k"], 
       SubscriptBox["\[Phi]", "k"]], 
      SubscriptBox["\[Delta]", "lk"], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Xi]", "k"], 
         SubscriptBox["\[Delta]\[Xi]", "j"]}]],
       TraditionalForm]}], "=", 
     RowBox[{
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "l"], 
       SubscriptBox["\[Phi]", "l"]], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Xi]", "l"], 
         SubscriptBox["\[Delta]\[Xi]", "j"]}]],
       TraditionalForm]}]}]}], TraditionalForm]}],ExpressionUUID->
  "dc621b9e-3bea-49dc-b84e-12ea3b7b315a"],
 "\nIf we set the sources to zero, we get the relations between two-point \
functions and propagators:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Xi]", "i"], 
       SubscriptBox["\[Delta]\[Xi]", "j"]}]],
     TraditionalForm], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Phi]", "i"], 
        SubscriptBox["\[Delta]\[Phi]", "j"]}]], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "62088c7f-d19d-427f-975a-8a77110c0edb"],
 "\nFor example:\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    FormBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{
       SubscriptBox["\[Delta]J", "i"], 
       SubscriptBox["\[Delta]J", "j"]}]],
     TraditionalForm], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]A", "i"], 
        SubscriptBox["\[Delta]A", "j"]}]], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{"\[Delta]", 
       SubscriptBox[
        OverscriptBox["\[Eta]", "_"], "i"], 
       SubscriptBox["\[Delta]\[Eta]", "j"]}]],
     TraditionalForm], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "i"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "j"]}]], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]}],ExpressionUUID->
  "7213700f-9d59-4ce3-b405-0377ef511440"]
}], "Text",
