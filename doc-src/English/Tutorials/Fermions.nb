Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getFR", "[", 
    RowBox[{"actionQCD", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"p2", ",", "a", ",", "mu"}], "]"}], ",", 
       RowBox[{"A", "[", 
        RowBox[{"p1", ",", "b", ",", "nu"}], "]"}]}], "}"}]}], "]"}], "/.", 
   RowBox[{"{", 
