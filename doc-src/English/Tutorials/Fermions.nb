Cell[TextData[{
 "The action is given by (in linear covariant gauges, without ghost terms) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox["dq", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
      SubscriptBox["Z", "2"], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["\[Psi]", "_"], "a"], "(", "p", ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["\[Gamma]", "\[Mu]"], 
         SubscriptBox["p", "\[Mu]"]}], "+", 
        RowBox[{
         SubscriptBox["Z", "m"], "m"}]}], ")"}], 
      RowBox[{
       SuperscriptBox["\[Psi]", "a"], "(", 
       RowBox[{"-", "p"}], ")"}]}]}], "-", 
    RowBox[{
     SubscriptBox["Z", "F1"], "\[ImaginaryI]", " ", "g", " ", 
     SubsuperscriptBox["T", "bd", "a"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{"dp", " ", "dq"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "8"]], 
       SubscriptBox["\[Gamma]", "\[Mu]"], 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "a"], "(", "q", ")"}], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["\[Psi]", "_"], "b"], "(", "p", ")"}], 
       RowBox[{
        SuperscriptBox["\[Psi]", "d"], "(", 
        RowBox[{
         RowBox[{"-", "p"}], "-", "q"}], ")"}]}]}]}], "+", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox["dq", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
      FractionBox["1", "2"], 
      SubscriptBox["Z", "3"], 
      RowBox[{
       SubsuperscriptBox["A", "\[Mu]", "a"], "(", "p", ")"}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["g", "\[Mu]\[Nu]"], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox["1", "\[Xi]"]}], ")"}], 
         FractionBox[
          RowBox[{
           SubscriptBox["p", "\[Mu]"], 
           SubscriptBox["p", "\[Nu]"]}], 
          SuperscriptBox["p", "2"]]}]}], ")"}], 
      RowBox[{
       SubsuperscriptBox["A", "\[Nu]", "a"], "(", 
       RowBox[{"-", "p"}], ")"}]}]}], "+", 
    RowBox[{
     SubscriptBox["Z", "1"], 
     FractionBox["\[ImaginaryI]", "2"], " ", "g", " ", 
     SuperscriptBox["f", "abc"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{"dp", " ", "dq"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "8"]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["p", "\[Mu]"]}], 
          RowBox[{
           SubsuperscriptBox["A", "\[Nu]", "a"], "(", "p", ")"}], 
          RowBox[{
           SubsuperscriptBox["A", "\[Mu]", "b"], "(", "q", ")"}], " ", 
          RowBox[{
           SubsuperscriptBox["A", "\[Nu]", "c"], "(", 
           RowBox[{
            RowBox[{"-", "p"}], "-", "q"}], ")"}]}], "+", 
         RowBox[{
          SubscriptBox["p", "\[Nu]"], 
          RowBox[{
           SubsuperscriptBox["A", "\[Mu]", "a"], "(", "p", ")"}], 
          RowBox[{
           SubsuperscriptBox["A", "\[Mu]", "b"], "(", "q", ")"}], " ", 
          RowBox[{
           SubsuperscriptBox["A", "\[Nu]", "c"], "(", 
           RowBox[{
            RowBox[{"-", "p"}], "-", "q"}], ")"}]}]}], ")"}]}]}]}], "+", 
    RowBox[{
     SubscriptBox["Z", "4"], 
     FractionBox["1", "4"], " ", 
     SuperscriptBox["g", "2"], " ", 
     SuperscriptBox["f", "abd"], 
     SuperscriptBox["f", "efd"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{"dp", " ", "dq", " ", "dr"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "12"]], 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "a"], "(", "p", ")"}], 
       RowBox[{
        SubsuperscriptBox["A", "\[Nu]", "b"], "(", "q", ")"}], " ", 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "e"], "(", "r", ")"}], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["A", "\[Nu]", "f"], "(", 
         RowBox[{
          RowBox[{"-", "p"}], "-", "q", "-", "r"}], ")"}], "."}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"8663f70f-e33b-4fc5-ad88-9efcbf4230b8"]
}], "Text",
 CellChangeTimes->{{3.948115339418234*^9, 3.948115344599498*^9}, {
