Cell["Action, generating functionals, propagators and vertices", "Section",
 CellChangeTimes->{{3.784870893912496*^9, 3.784870902072659*^9}, {
  3.948113755135345*^9, 3.948113755870718*^9}, {3.948113873366518*^9, 
  3.948113877535141*^9}, {3.973608040888588*^9, 3.9736080469145327`*^9}},
 CellID->490632353,ExpressionUUID->"550489a9-af9f-4519-ab18-3fc0aa55e0e4"],

Cell["Let the action for a fermionic field be given by", "Text",
 CellChangeTimes->{{3.901870981232856*^9, 3.90187098327337*^9}, {
   3.902286456418818*^9, 3.902286460910561*^9}, {3.931001860304375*^9, 
   3.931001885366467*^9}, 3.931001926530777*^9, {3.948113770827875*^9, 
   3.948113795579723*^9}, {3.948114084828415*^9, 3.948114088742712*^9}, {
   3.962606479915216*^9, 
   3.962606485990947*^9}},ExpressionUUID->"c7fc16a9-73c1-426c-a798-\
f6eb316b035e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"\[Psi]", ",", 
      OverscriptBox["\[Psi]", "_"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["d", "d"], "q"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], " ", 
       SubscriptBox["Z", "2"], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["\[Psi]", "_"], "i"], "(", "q", ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubscriptBox["q", "\[Mu]"], 
          SubscriptBox["\[Gamma]", 
           RowBox[{"\[Mu]", " "}]]}], "+", 
         RowBox[{"m", " ", 
          SubscriptBox["Z", "m"]}]}], ")"}], 
       RowBox[{
        SuperscriptBox["\[Psi]", "i"], "(", 
        RowBox[{"-", "p"}], ")"}]}]}], "-", 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["d", "d"], "q"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["d", "d"], "r"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
       SubscriptBox["Z", 
        RowBox[{"1", "F"}]], "\[ImaginaryI]", " ", "g", " ", 
       SubsuperscriptBox["T", "ij", "a"], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["\[Psi]", "_"], "i"], "(", "q", ")"}], 
       SuperscriptBox[
        RowBox[{"\[Psi]", " "}], "j"], 
       RowBox[{"(", "r", ")"}], 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "a"], "(", 
        RowBox[{
         RowBox[{"-", "q"}], "-", "r"}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"60ba1638-0e47-49ed-85b4-aa70d4bbdc56"],
 ","
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
  3.902286509132814*^9}, {3.902286556687783*^9, 3.902286559535182*^9}, {
  3.902286641073317*^9, 3.902286644237081*^9}, {3.948113803514504*^9, 
  3.9481138581629143`*^9}, {3.948113969873868*^9, 3.948113977666354*^9}, {
  3.948114060527379*^9, 3.948114060658785*^9}, {3.962606065457354*^9, 
  3.962606065572545*^9}, {3.96260614144983*^9, 3.962606147723494*^9}, {
  3.962606495063794*^9, 
  3.962606799568049*^9}},ExpressionUUID->"9b95f19e-fe62-4ec8-acd4-\
c4fc179e1ac0"],

Cell["or in symbolic form (integration is implied):", "Text",
 CellChangeTimes->{{3.901870981232856*^9, 3.90187098327337*^9}, {
   3.902286456418818*^9, 3.902286460910561*^9}, {3.931001860304375*^9, 
   3.931001885366467*^9}, 3.931001926530777*^9, {3.948113770827875*^9, 
   3.948113795579723*^9}, {3.948114084828415*^9, 3.948114088742712*^9}, {
   3.962606479915216*^9, 3.9626064825343924`*^9}, {3.962606793230007*^9, 
   3.962606804030469*^9}},ExpressionUUID->"d45f1ded-0c47-4577-877e-\
eb51254b447f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"\[Psi]", ",", 
      OverscriptBox["\[Psi]", "_"]}], "]"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"\[Psi]", 
        OverscriptBox["\[Psi]", "_"]}]], 
      OverscriptBox["\[Psi]", "_"], "\[Psi]"}], "+", 
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"A", 
        OverscriptBox["\[Psi]", "_"], "\[Psi]"}]], 
      OverscriptBox["\[Psi]", "_"], "\[Psi]", " ", "A"}]}]}], 
   TraditionalForm]],ExpressionUUID->"efa7f48d-7629-4468-91af-38122d153c61"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
