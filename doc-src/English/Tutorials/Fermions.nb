Cell[BoxData[
 RowBox[{
  FractionBox["1", "\[Xi]"], 
  RowBox[{
   RowBox[{"delta", "[", 
    RowBox[{"adj", ",", "a", ",", "b"}], "]"}], " ", 
   RowBox[{"deltam", "[", 
    RowBox[{"p1", "+", "p2"}], "]"}], " ", 
