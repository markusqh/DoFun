  3.948114060527379*^9, 3.948114060658785*^9}, {3.962606065457354*^9, 
  3.962606065572545*^9}, {3.96260614144983*^9, 3.962606147723494*^9}, {
  3.971592384205102*^9, 3.971592389777166*^9}, {3.972100789990926*^9, 
  3.972100802437743*^9}, {3.973609693372517*^9, 3.973609701926663*^9}, {
  3.9736104736603394`*^9, 3.973610479928996*^9}, {3.9768557431038513`*^9, 
  3.976855743743988*^9}, {3.976857473369636*^9, 3.9768574735936413`*^9}, {
  3.977831554610918*^9, 3.9778315613464613`*^9}, {3.977837675240362*^9, 
  3.9778376772355127`*^9}},ExpressionUUID->"819763cd-83e0-4b65-9968-\
4084aba38b51"],

Cell["The path integral is given by", "Text",
 CellChangeTimes->{{3.901870990423199*^9, 3.901871117336906*^9}, 
   3.902285470348755*^9, 3.9022866614112053`*^9, {3.902286710447488*^9, 
   3.902286727746322*^9}, {3.902406540983011*^9, 3.902406604328875*^9}, {
   3.931001698385118*^9, 3.93100173086585*^9}, {3.948113880775463*^9, 
   3.948113912027194*^9}, {3.948114063182558*^9, 3.9481140685820704`*^9}, {
   3.962606066834278*^9, 3.962606067627521*^9}, {3.971591049746356*^9, 
   3.971591050210375*^9}, {3.976855399989662*^9, 3.976855400366728*^9}, {
   3.9775424953638153`*^9, 
   3.977542495633102*^9}},ExpressionUUID->"3e371d28-2823-4b78-86e2-\
0154fdea0220"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Z", "[", 
     RowBox[{
      OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"W", "[", 
       RowBox[{
        OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}]], " ", "=", 
     RowBox[{"\[Integral]", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         OverscriptBox["\[Psi]", "_"], "\[Psi]"}], "]"}], 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"S", "[", 
           RowBox[{"\[Psi]", ",", 
            OverscriptBox["\[Psi]", "_"]}], "]"}]}], "+", 
         RowBox[{"\[Integral]", 
          RowBox[{"dx", "(", 
           RowBox[{
            RowBox[{
             OverscriptBox["\[Eta]", "_"], "\[Psi]"}], "+", 
            RowBox[{"\[Eta]", 
             OverscriptBox["\[Psi]", "_"]}]}], ")"}]}]}]]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"9e1bcf82-ea74-4a4f-9fcd-2c1f830ae4c5"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
  3.902286509132814*^9}, {3.902286556687783*^9, 3.902286559535182*^9}, {
  3.902286641073317*^9, 3.902286644237081*^9}, {3.948113803514504*^9, 
  3.9481138581629143`*^9}, {3.948113919821107*^9, 3.948114036257471*^9}, {
  3.948114146001145*^9, 3.948114174958753*^9}, {3.9736079216466923`*^9, 
  3.973607939190092*^9}},ExpressionUUID->"9d18525e-7a05-4da6-aad3-\
08c4e9fd7f1e"],

Cell["The effective action is defined as", "Text",
 CellChangeTimes->{{3.948114114843569*^9, 3.948114119027444*^9}, {
   3.971591070868703*^9, 3.9715910790591297`*^9}, {3.9715911127724323`*^9, 
