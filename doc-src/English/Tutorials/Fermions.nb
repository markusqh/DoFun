Cell[TextData[{
 "From the action, the Feynman rules an be derived. The bare two-point \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{"\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "S"}], 
     RowBox[{"\[Delta]\[Psi]\[Delta]", 
      OverscriptBox["\[Psi]", "_"]}]]}], TraditionalForm]],ExpressionUUID->
  "1be013bf-b333-4e4d-b091-74dbda40ed13"],
 " is obtained from"
}], "Text",
