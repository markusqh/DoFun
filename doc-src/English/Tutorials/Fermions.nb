Cell[BoxData[
 RowBox[{
  RowBox[{"projQuB", "=", 
   RowBox[{
    RowBox[{"delta", "[", 
     RowBox[{"dirac", ",", "i", ",", "j"}], "]"}], 
    RowBox[{
     RowBox[{
