Cell[TextData[{
 "For the quark propagator we check ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], 
        SuperscriptBox["W", "0"]}], 
       RowBox[{"\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[Eta]", "_"], "k"], 
        SubscriptBox["\[Delta]\[Eta]", "i"]}]],
      TraditionalForm], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "S"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "j"]}]]}], "=", 
    SubscriptBox["\[Delta]", "ij"]}], TraditionalForm]],ExpressionUUID->
  "7eb4a6fb-b1aa-4a0a-b676-5b22464c4697"],
 ":"
}], "Text",
