Cell[TextData[{
 "To calculate the derivative of a propagator, we start from an expression \
for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "ij"], TraditionalForm]],ExpressionUUID->
  "4bfd4967-957e-44ca-befa-92c2aaba3ac1"],
 ". We apply a derivative upon which the left-hand side vanishes:"
}], "Text",
 CellChangeTimes->{{3.9793740481718493`*^9, 3.979374118156867*^9}, {
  3.979455894338958*^9, 3.979455910567614*^9}, {3.979456102497801*^9, 
  3.979456114790111*^9}, {3.979469761474131*^9, 3.979469770015616*^9}, {
  3.9857785133156843`*^9, 
  3.985778514007567*^9}},ExpressionUUID->"9e05a7bc-353e-4f78-8835-\
9b5cd72bd335"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Delta]", 
        SubscriptBox["\[Delta]\[Phi]", "l"]], 
       FormBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "W"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[Xi]", "i"], 
          SubscriptBox["\[Delta]\[Xi]", "k"]}]],
        TraditionalForm]}], ")"}], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[CapitalPhi]", "j"], 
       SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "j"], 
      SubscriptBox["\[Phi]", "j"]], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "k"], 
      SubscriptBox["\[Phi]", "j"]]}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "l"], 
       RowBox[{
        SubscriptBox["\[Phi]", "i"], 
        SubscriptBox["\[Phi]", "k"]}]]}], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "j"], 
      SubscriptBox["\[Phi]", "j"]], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "k"], 
      SubscriptBox["\[Phi]", "j"]], 
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Xi]", "i"], 
        SubscriptBox["\[Delta]\[Xi]", "k"]}]],
      TraditionalForm], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "l"], 
       SubscriptBox["\[Delta]\[CapitalPhi]", "j"], 
       SubscriptBox["\[Delta]\[Phi]", "k"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"bb1aed5c-1ae3-4656-9cb3-74522f461ca7"],
 "\nThis, we multiply with ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "W"}], 
    RowBox[{
     SubscriptBox["\[Delta]\[Xi]", "j"], 
     SubscriptBox["\[Delta]\[Xi]", "m"]}]], TraditionalForm]],ExpressionUUID->
  "b8fb9edd-708a-4c2c-ac01-4bd83ef32740"],
 " from the right so we obtain a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "km"], TraditionalForm]],ExpressionUUID->
  "cffccac3-065e-45e7-a606-fd2aca7eeacc"],
 ":\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Delta]", 
        SubscriptBox["\[Delta]\[Phi]", "l"]], 
       FormBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "W"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[Xi]", "i"], 
          SubscriptBox["\[Delta]\[Xi]", "k"]}]],
        TraditionalForm]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Phi]", "j"], 
         SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Xi]", "j"], 
         SubscriptBox["\[Delta]\[Xi]", "m"]}]], 
       SubsuperscriptBox["\[Epsilon]", 
        SubscriptBox["\[Phi]", "j"], 
        SubscriptBox["\[Phi]", "j"]], 
       SubsuperscriptBox["\[Epsilon]", 
        SubscriptBox["\[Phi]", "k"], 
        SubscriptBox["\[Phi]", "j"]]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "l"], 
       RowBox[{
        SubscriptBox["\[Phi]", "i"], 
        SubscriptBox["\[Phi]", "k"]}]]}], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "j"], 
      SubscriptBox["\[Phi]", "j"]], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "k"], 
      SubscriptBox["\[Phi]", "j"]], 
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Xi]", "i"], 
        SubscriptBox["\[Delta]\[Xi]", "k"]}]],
      TraditionalForm], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "l"], 
       SubscriptBox["\[Delta]\[Phi]", "j"], 
       SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Xi]", "j"], 
       SubscriptBox["\[Delta]\[Xi]", "m"]}]]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Delta]", 
        SubscriptBox["\[Delta]\[Phi]", "l"]], 
       FormBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "W"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[Xi]", "i"], 
          SubscriptBox["\[Delta]\[Xi]", "k"]}]],
        TraditionalForm]}], ")"}], 
     SubscriptBox["\[Delta]", "km"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "l"], 
       RowBox[{
        SubscriptBox["\[Phi]", "i"], 
        SubscriptBox["\[Phi]", "k"]}]]}], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "j"], 
      SubscriptBox["\[Phi]", "j"]], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "k"], 
      SubscriptBox["\[Phi]", "j"]], 
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Xi]", "i"], 
        SubscriptBox["\[Delta]\[Xi]", "k"]}]],
      TraditionalForm], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "l"], 
       SubscriptBox["\[Delta]\[Phi]", "j"], 
       SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Xi]", "j"], 
       SubscriptBox["\[Delta]\[Xi]", "m"]}]]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Delta]", 
       SubscriptBox["\[Delta]\[Phi]", "l"]], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Xi]", "i"], 
         SubscriptBox["\[Delta]\[Xi]", "m"]}]],
       TraditionalForm]}], ")"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "l"], 
       RowBox[{
        SubscriptBox["\[Phi]", "i"], 
        SubscriptBox["\[Phi]", "k"]}]]}], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "j"], 
      SubscriptBox["\[Phi]", "j"]], 
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Xi]", "i"], 
        SubscriptBox["\[Delta]\[Xi]", "k"]}]],
      TraditionalForm], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "l"], 
       SubscriptBox["\[Delta]\[Phi]", "k"], 
       SubscriptBox["\[Delta]\[Phi]", "j"]}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Xi]", "j"], 
       SubscriptBox["\[Delta]\[Xi]", "m"]}]]}]}], TraditionalForm]}],
  ExpressionUUID->"e1f169c4-eaff-4d4d-b51d-518d3d1773e6"],
 "\nRephrased in indices i,j,k:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Delta]", 
       SubscriptBox["\[Delta]\[Phi]", "k"]], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Xi]", "i"], 
         SubscriptBox["\[Delta]\[Xi]", "j"]}]],
       TraditionalForm]}], ")"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "k"], 
       RowBox[{
        SubscriptBox["\[Phi]", "i"], 
        SubscriptBox["\[Phi]", "l"]}]]}], 
     SubsuperscriptBox["\[Epsilon]", 
      SubscriptBox["\[Phi]", "m"], 
      SubscriptBox["\[Phi]", "m"]], 
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Xi]", "i"], 
        SubscriptBox["\[Delta]\[Xi]", "l"]}]],
      TraditionalForm], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Phi]", "k"], 
       SubscriptBox["\[Delta]\[Phi]", "l"], 
       SubscriptBox["\[Delta]\[Phi]", "m"]}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "W"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[Xi]", "m"], 
       SubscriptBox["\[Delta]\[Xi]", "j"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"e6a25f4e-fde1-4a97-996e-901f5e510e9a"]
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwlzF1IU3EAhvGxqQ3RCDdKMGehLrKE5VDUnHBqC/y4KIdERF5EWQjlGKuR
