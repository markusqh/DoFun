Cell["\<\
$signConvention sets the convention for vertices. With $signConvention = 1, \
they are the negative derivatives of the effective action. Default is -1, \
viz., vertices are the derivatives of the effective action.\
\>", "Text",
 CellChangeTimes->{{3.9775444461418533`*^9, 
  3.9775445093086967`*^9}},ExpressionUUID->"a3c47ec2-b131-4cc2-ad27-\
622bcbac1cd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$signConvention", "=", "1"}], ";"}]], "Input",
 CellChangeTimes->{{3.973609353095443*^9, 3.973609355047842*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"5b0ba589-778f-4387-8754-34310356bdce"],

