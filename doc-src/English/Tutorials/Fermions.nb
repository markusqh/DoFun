   3.9778343661265717`*^9, 3.977834392639695*^9}, {3.977996155319572*^9, 
   3.9779961557842827`*^9}, {3.9779962340135403`*^9, 3.977996234246779*^9}, {
   3.97947121011652*^9, 3.979471244002164*^9}, {3.988620868714155*^9, 
   3.988620870129979*^9}},ExpressionUUID->"b526a58d-6685-4eb2-8e62-\
8a828a1773a2"],

Cell[TextData[{
 StyleBox["n-point functions:",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{
      SubscriptBox["A", "1"], ",", 
      SubscriptBox["\[CapitalPsi]", "3"], ",", 
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], "2"]}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "$signConvention"}], " ", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "3"], " ", "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]A", "1"], 
        SubscriptBox["\[Delta]\[CapitalPsi]", "3"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "2"]}]]}], "=", 
     RowBox[{
      RowBox[{"doDSE", "[", 
       RowBox[{"action", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "2"], ",", 
          SubscriptBox["\[CapitalPsi]", "3"], ",", 
          SubscriptBox["A", "1"]}], "}"}]}], "]"}], " ", "<->", " ", 
      RowBox[{"doFR", "[", 
       RowBox[{"action", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "2"], ",", 
          SubscriptBox["\[CapitalPsi]", "3"], ",", 
          SubscriptBox["A", "1"]}], "}"}]}], "]"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"694396b7-6cd5-47d9-ac11-a70ecf58c6ef"]
}], "Text",
