Cell[BoxData[
 RowBox[{"quAlgPre", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"getAE", "[", 
     RowBox[{"qupropDSE", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[CapitalPsi]", ",", "i1", ",", "p", ",", "c1", ",", "i"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalPsi]b", ",", "i2", ",", 
          RowBox[{"-", "p"}], ",", "c2", ",", "j"}], "}"}]}], "}"}]}], "]"}], 
    "/.", 
    RowBox[{"\[Xi]", ":>", "0"}]}], "/.", 
   RowBox[{"q1", ":>", 
    RowBox[{"q1", "-", "p", 
     RowBox[{"(*", " ", 
      RowBox[{"change", " ", "momentum", " ", "routing"}], " ", 
      "*)"}]}]}]}]}]], "Input",
