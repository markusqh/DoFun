Cell["\<\
The propagator is the inverse of the two-point function (using symbolic \
notation with integration over repeated indices):\
\>", "Text",
 CellChangeTimes->{{3.977542554278988*^9, 3.9775425724225616`*^9}, {
  3.977542675056697*^9, 3.9775426872668552`*^9}, {3.97754297094258*^9, 
  3.9775429711593637`*^9}},ExpressionUUID->"5e07eb44-510c-4f2f-a8df-\
f01baa1281f4"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Delta]", "12"], "=", 
   RowBox[{
    FormBox[
     FractionBox[
      SubscriptBox["\[Delta]\[Eta]", "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]],
     TraditionalForm], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       SubscriptBox["\[Delta]\[CapitalPsi]", "3"], 
       SubscriptBox["\[Delta]\[Eta]", "1"]], 
      FractionBox["\[Delta]", 
       SubscriptBox["\[Delta]\[CapitalPsi]", "3"]], 
      RowBox[{"(", 
       RowBox[{"-", 
        FractionBox["\[Delta]\[CapitalGamma]", 
         RowBox[{"\[Delta]", 
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "2"]}]]}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "W"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[Eta]", "1"], "\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[Eta]", "_"], "3"]}]],
         TraditionalForm]}], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[CapitalPsi]", "3"], "\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[CapitalPsi]", "_"], "2"]}]]}], "=", 
      RowBox[{
       RowBox[{
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "W"}], 
          RowBox[{"\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[Eta]", "_"], "3"], 
           SubscriptBox["\[Delta]\[Eta]", "1"]}]],
         TraditionalForm], 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[CapitalPsi]", "3"], "\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], "\[DoubleLongRightArrow]", 
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{"\[Delta]", 
            SubscriptBox[
             OverscriptBox["\[Eta]", "_"], "2"], 
            SubscriptBox["\[Delta]\[Eta]", "1"]}]],
          TraditionalForm]}]}], "=", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[CapitalPsi]", "1"], "\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], ")"}], 
        RowBox[{"-", "1"}]]}]}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"486ebfec-9619-429b-88c6-a78dba96e0ce"]], \
"DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
  3.902286509132814*^9}, {3.902286556687783*^9, 3.902286559535182*^9}, {
  3.902286641073317*^9, 3.902286644237081*^9}, {3.948113803514504*^9, 
  3.9481138581629143`*^9}, {3.948113919821107*^9, 3.948114036257471*^9}, {
  3.948114131202759*^9, 3.948114218692923*^9}, {3.948114357361177*^9, 
  3.9481144258281593`*^9}, {3.9481145153760366`*^9, 3.9481145158694477`*^9}, {
  3.9715914514581738`*^9, 3.971591476824871*^9}, {3.97685543824934*^9, 
  3.9768554474580193`*^9}, {3.977542595917173*^9, 3.9775428440546722`*^9}, {
  3.97754299287486*^9, 3.977543004559074*^9}, {3.977543035001913*^9, 
  3.9775431104089518`*^9}, {3.977831278762596*^9, 
  3.9778312795206947`*^9}},ExpressionUUID->"24655b45-61ca-4457-9692-\
1a3ea3825dc7"],

Cell[TextData[{
 "Note: This can also be seen illustratively for the bare propagator. \
Considering only the quadratic part in the action, one can complete the \
square in the path integral,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FormBox[
          RowBox[{
           SuperscriptBox["S", 
            RowBox[{"\[Psi]", 
             OverscriptBox["\[Psi]", "_"]}]], 
           OverscriptBox["\[Psi]", "_"], "\[Psi]"}],
          TraditionalForm]}], "+", 
        FormBox[
         RowBox[{
          RowBox[{
           OverscriptBox["\[Eta]", "_"], "\[Psi]"}], "+", 
          RowBox[{"\[Eta]", 
           OverscriptBox["\[Psi]", "_"]}]}],
         TraditionalForm]}], " ", "=", 
       RowBox[{
        FormBox[
         RowBox[{"-", 
          RowBox[{"(", 
           OverscriptBox["\[Psi]", "_"]}]}],
         TraditionalForm], "-", 
        SuperscriptBox[
         RowBox[{
          FormBox[
           OverscriptBox["\[Eta]", "_"],
           TraditionalForm], "[", 
          FormBox[
           SuperscriptBox["S", 
            RowBox[{"\[Psi]", 
             OverscriptBox["\[Psi]", "_"]}]],
           TraditionalForm], "]"}], 
         RowBox[{"-", "1"}]]}]}], ")"}], 
     RowBox[{
      FormBox[
       SuperscriptBox["S", 
        RowBox[{"\[Psi]", 
         OverscriptBox["\[Psi]", "_"]}]],
       TraditionalForm], "(", 
      RowBox[{"\[Psi]", "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"[", 
          SuperscriptBox["S", 
           RowBox[{"\[Psi]", 
            OverscriptBox["\[Psi]", "_"]}]], "]"}], 
         RowBox[{"-", "1"}]], "\[Eta]"}]}], ")"}]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       OverscriptBox["\[Eta]", "_"], " ", "[", 
       SuperscriptBox["S", 
        RowBox[{"\[Psi]", 
         OverscriptBox["\[Psi]", "_"]}]], "]"}], 
      RowBox[{"-", "1"}]], "\[Eta]"}]}], TraditionalForm]],ExpressionUUID->
  "65110dea-ca47-4ab2-8d1a-1ca517aa4fbb"],
 " ,\nand integrate out the fields. Then only\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["W", "0"], "[", 
     RowBox[{
      OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}], "=", 
    RowBox[{"ln", "(", 
     RowBox[{"N", " ", 
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{
           OverscriptBox["\[Eta]", "_"], " ", "[", 
           SuperscriptBox["S", 
            RowBox[{"\[Psi]", 
             OverscriptBox["\[Psi]", "_"]}]], "]"}], 
          RowBox[{"-", "1"}]]}], "\[Eta]"}], ")"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"4ca247cf-af42-4fa6-88ce-a9480a11efb2"],
 "\nremains where the superscript 0 indicates that interactions were dropped. \
The bare propagator ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], 
     SuperscriptBox["W", "0"]}], 
    RowBox[{"\[Delta]", 
     SubscriptBox[
      OverscriptBox["\[Eta]", "_"], "2"], 
     SubscriptBox["\[Delta]\[Eta]", "1"]}]], TraditionalForm]],ExpressionUUID->
  "2c69a5fc-7a43-4334-9343-92dce81af141"],
 " is then given by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", 
     SuperscriptBox["S", 
      RowBox[{
       SubscriptBox["\[Psi]", "2"], 
       SubscriptBox[
        OverscriptBox["\[Psi]", "_"], "1"]}]], "]"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "ce64da9d-5c11-46f1-bc5d-c7a2f0da153d"],
 ", or explicitly for the example above:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{
      SubscriptBox["\[Psi]", "1"], 
      SubscriptBox[
       OverscriptBox["\[Psi]", "_"], "2"]}]], "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "S"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[CapitalPsi]", "1"], "\[Delta]", 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["Z", "2"], "(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubscriptBox[
           SubscriptBox["p", "2"], "\[Mu]"], 
          SubscriptBox["\[Gamma]", 
           RowBox[{"\[Mu]", " "}]]}], "+", 
         RowBox[{"m", " ", 
          SubscriptBox["Z", "m"]}]}], ")"}], 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
       RowBox[{
        RowBox[{"\[Delta]", "(", 
         RowBox[{
          SubscriptBox["p", "1"], "+", 
          SubscriptBox["p", "2"]}], ")"}], "\[DoubleLongRightArrow]", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], 
          SuperscriptBox["W", "0"]}], 
         RowBox[{"\[Delta]", 
          SubscriptBox[
           OverscriptBox["\[Eta]", "_"], "2"], 
          SubscriptBox["\[Delta]\[Eta]", "1"]}]]}]}], "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "S"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[CapitalPsi]", "1"], "\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], ")"}], 
        RowBox[{"-", "1"}]], "=", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"[", 
          SuperscriptBox["S", 
           RowBox[{
            SubscriptBox["\[Psi]", "1"], 
            SubscriptBox[
             OverscriptBox["\[Psi]", "_"], "2"]}]], "]"}], 
         RowBox[{"-", "1"}]], "=", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], "d"], 
          RowBox[{"\[Delta]", "(", 
           RowBox[{
            SubscriptBox["p", "1"], "+", 
            SubscriptBox["p", "2"]}], ")"}], 
          FractionBox["1", 
           SubscriptBox["Z", "2"]], 
          FractionBox[
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", 
             SubscriptBox[
              SubscriptBox["p", "2"], "\[Mu]"], 
             SubscriptBox["\[Gamma]", 
              RowBox[{"\[Mu]", " "}]]}], "+", 
            RowBox[{"m", " ", 
             SubscriptBox["Z", "m"]}]}], 
           RowBox[{
            SuperscriptBox["p1", "2"], "+", 
            SuperscriptBox["m", "2"]}]]}], "=", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], "d"], 
          RowBox[{"\[Delta]", "(", 
           RowBox[{
            SubscriptBox["p", "1"], "+", 
            SubscriptBox["p", "2"]}], ")"}], 
          FractionBox["1", 
           SubscriptBox["Z", "2"]], 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", 
             SubscriptBox[
              SubscriptBox["p", "1"], "\[Mu]"], 
             SubscriptBox["\[Gamma]", 
              RowBox[{"\[Mu]", " "}]]}], "+", 
            RowBox[{"m", " ", 
             SubscriptBox["Z", "m"]}]}], 
           RowBox[{
            SuperscriptBox["p1", "2"], "+", 
            SuperscriptBox["m", "2"]}]]}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f3130565-5b46-4a68-930f-ffbff07d4cf6"]
}], "Text",
 CellChangeTimes->{{3.972100891749976*^9, 3.972101208319063*^9}, {
   3.972101335164773*^9, 3.972101382836917*^9}, {3.972101466999653*^9, 
   3.9721015014482937`*^9}, {3.972101558896555*^9, 3.972101573061*^9}, 
   3.9774666781278048`*^9, {3.977475452673171*^9, 3.977475455044116*^9}, {
   3.977543326804388*^9, 3.9775437201994343`*^9}, {3.977543785459655*^9, 
   3.97754379465628*^9}, {3.9775438261949244`*^9, 3.977543826525124*^9}, {
   3.977543863572027*^9, 3.977543955071534*^9}, {3.977543989903014*^9, 
   3.9775441192064133`*^9}, {3.97754498464995*^9, 3.9775449856811533`*^9}, {
   3.977545702593629*^9, 3.977545705037938*^9}, {3.977545807191244*^9, 
   3.977545916018653*^9}, {3.9777449176864347`*^9, 
   3.977744922830277*^9}},ExpressionUUID->"20055634-2e35-4f63-9b80-\
438e0e008b77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary of DoFun conventions", "Section",
 CellChangeTimes->{{3.977544283404169*^9, 
  3.9775442943899527`*^9}},ExpressionUUID->"bf7c38c7-9fae-42b5-9f1e-\
efcdfc7050f4"],

Cell["\<\
Here is a summary of definitions where the order of fields is important:\
\>", "Abstract",
 CellChangeTimes->{{3.972295259642276*^9, 
  3.9722953165633793`*^9}},ExpressionUUID->"34c87532-97b8-4e71-9474-\
42780c50188c"],

Cell[TextData[{
 "The propagator is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], " ", "W"}], 
     RowBox[{"\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Eta]", "_"], "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], " ", "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "1"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "495f8878-cc95-44e8-9799-13be31049303"],
 ".\nThis describes the propagation from creation of a particle (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "649b2db6-0fb3-40b4-8b03-f20864cf8ae1"],
 ", source \[Eta]) at 1 to annihilation (\[CapitalPsi], sink ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Eta]", "_"], TraditionalForm]],ExpressionUUID->
  "31e63586-5dd2-42a1-ae64-53b67307d237"],
 ") of the particle at 2.\nIn DoFun, the notation uses only field arguments \
and the propagators is then denoted schematically by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "2"], ",", " ", 
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], "1"]}], "]"}], TraditionalForm]],
  ExpressionUUID->"fcc6301f-cfec-4603-887e-19ad553337ff"],
 ".\n The canonical notation puts antifermions before fermions, e.g., V[A, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "262a839e-9809-48c7-b8c0-f5c2f7f81edf"],
 ", \[CapitalPsi]]."
}], "Abstract",
 CellChangeTimes->{{3.972295259642276*^9, 3.97229537256583*^9}, {
   3.9722954966840487`*^9, 3.9722957381595793`*^9}, {3.97229959666411*^9, 
   3.9722996099119368`*^9}, 3.97360801322194*^9, {3.9736081133036833`*^9, 
   3.9736081724642344`*^9}, 3.9775441291824636`*^9, {3.977544209934176*^9, 
   3.977544260539819*^9}, {3.977745184647257*^9, 
   3.977745187141575*^9}},ExpressionUUID->"15bbeac9-9eaa-4d51-96ee-\
25f4c8cc1a71"],

Cell[TextData[{
 "Momentum conventions:\nPropagators (P): All momenta ",
 StyleBox["outgoing",
  FontWeight->"Bold"],
 ".\nDressed (V) and bare (S) n-point functions as well as regulator \
insertions (dR) have all momenta ",
 StyleBox["incoming",
  FontWeight->"Bold"],
 " and the \[OpenCurlyQuote]flow of fields\[CloseCurlyQuote] is from \
\[CapitalPsi]  to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "64043417-ed94-4d9c-9a34-10bf2ae02f25"],
 "."
}], "Abstract",
 CellChangeTimes->{{3.972295259642276*^9, 3.97229537256583*^9}, {
   3.9722954966840487`*^9, 3.972295930664649*^9}, 3.973608024469043*^9, {
   3.9736080602104473`*^9, 3.97360809649008*^9}, {3.973608150877849*^9, 
   3.973608161622909*^9}, {3.973608307677452*^9, 3.973608331321662*^9}, {
   3.976855629331818*^9, 3.97685563007679*^9}, {3.977544132385367*^9, 
   3.977544208882875*^9}, {3.977544382450387*^9, 
   3.977544382614835*^9}},ExpressionUUID->"d400e0e5-b961-47dc-82f4-\
f177a525e098"],

Cell[TextData[{
 "The symbolic equations are derived with doDSE/doRGE. All derivatives are \
left-derivatives and the order of fields, for example in vertices V, is such \
that they are taken in the order as written. For instance, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{
      SubscriptBox["i", "2"], " ", 
      SubscriptBox["i", "1"]}], 
     RowBox[{" ", 
      RowBox[{"\[CapitalPsi]", 
       OverscriptBox["\[CapitalPsi]", "_"]}]}]], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
     RowBox[{
      SubscriptBox["\[Delta]\[CapitalPsi]", 
       SubscriptBox["i", "2"]], "\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       SubscriptBox["i", "1"]]}]]}], TraditionalForm]],ExpressionUUID->
  "38ab68fe-04c0-4bb6-abca-a38ad6f0e051"],
 ". The functions doDSE and doRGE, however, apply one derivative after the \
other, starting with the first entry. Thus, to get the DSE for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "1"]}], 
    RowBox[{" ", 
     RowBox[{"\[CapitalPsi]", 
      OverscriptBox["\[CapitalPsi]", "_"]}]}]], TraditionalForm]],
  ExpressionUUID->"4ea1bf7f-3a22-4205-b644-7b2e0f250614"],
 ", one calls doDSE[action, {{",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e53f5237-4c60-4879-b98d-cc9707566d1d"],
 ",i1},{\[CapitalPsi],i2}}]."
}], "Text",
 CellChangeTimes->{{3.90240673833813*^9, 3.902406832740601*^9}, {
   3.902407067636001*^9, 3.902407083360821*^9}, {3.9310020021674232`*^9, 
   3.931002192371374*^9}, {3.948089862154179*^9, 3.948089865118677*^9}, {
   3.948089927549662*^9, 3.948089928666588*^9}, 3.962606420229444*^9, {
   3.971592023083099*^9, 3.971592082208984*^9}, {3.971692839758719*^9, 
   3.971692945710589*^9}, {3.9717024870093307`*^9, 3.971702487802981*^9}, {
   3.973608615175864*^9, 3.973608628201985*^9}, {3.976855658810499*^9, 
   3.976855660465513*^9}, {3.9768568482786293`*^9, 3.976856849758333*^9}, {
   3.976958067789196*^9, 3.97695806852419*^9}, {3.977544342979464*^9, 
   3.977544343398677*^9}},ExpressionUUID->"818ec6c5-9003-4f7c-bece-\
572875d1d2cf"],

Cell[TextData[{
 "Propagators in DoFun are written as P[{\[CapitalPsi], i2}, {",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "24f76dde-a149-4d45-a918-e9be18e2b2ee"],
 ", i1}]. This corresponds to ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "W"}], 
    RowBox[{"\[Delta]", 
     SubscriptBox[
      OverscriptBox["\[Eta]", "_"], "2"], 
     SubscriptBox["\[Delta]\[Eta]", "1"]}]], TraditionalForm]],ExpressionUUID->
  "ea38e9ab-c26e-4d6f-94ad-2beaa60d883a"],
 ". Note that the propagator arguments match those of the vertices they are \
connected to."
}], "Text",
 CellChangeTimes->{{3.971592187190864*^9, 3.971592199551407*^9}, {
   3.971592421622897*^9, 3.9715925102223253`*^9}, 3.971592555432929*^9, 
   3.9715926264649887`*^9, {3.971592666498701*^9, 3.971592718970048*^9}, {
   3.973609581492618*^9, 3.973609600285617*^9}, {3.97685675008521*^9, 
   3.976856758801559*^9}},ExpressionUUID->"a1089f3d-83f0-45dc-ac23-\
4a3e8967fe70"],

Cell["\<\
In algebraic expressions, where momenta are explicit, their direction is \
defined via the definition of the Fourier transformation. In DoFun, the same \
Fourier transformation is chosen for all fields with incoming momenta at all \
vertex legs. Due to the propagator notation with the same fields as the \
vertices, their momenta are defined as outgoing.\
\>", "Text",
 CellChangeTimes->{{3.971695176131135*^9, 
  3.971695304248516*^9}},ExpressionUUID->"6dff884c-56c7-4d62-8d85-\
29da43c3fbac"],

Cell[CellGroupData[{

Cell["Cheat sheet", "Subsection",
 CellChangeTimes->{{3.9777422372150803`*^9, 
  3.977742239787959*^9}},ExpressionUUID->"85baf054-9bd6-4383-9358-\
6d485cd333ac"],

Cell[TextData[{
 StyleBox["Action and derivatives:",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"\[Psi]", ",", 
      OverscriptBox["\[Psi]", "_"]}], "]"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"\[Psi]", 
        OverscriptBox["\[Psi]", "_"]}]], 
      OverscriptBox["\[Psi]", "_"], "\[Psi]"}], "+", 
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"A", 
        OverscriptBox["\[Psi]", "_"], "\[Psi]"}]], 
      OverscriptBox["\[Psi]", "_"], "\[Psi]", " ", "A"}]}]}], 
   TraditionalForm]],ExpressionUUID->"3ebeb37e-d771-455e-9ea6-c5438c07e671"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalGamma]", "[", 
     RowBox[{"\[CapitalPsi]", ",", 
      OverscriptBox["\[CapitalPsi]", "_"]}], "]"}], "=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"W", "[", 
       RowBox[{
        OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}]}], "+", 
     RowBox[{"\[Integral]", 
      RowBox[{"dx", "(", 
       RowBox[{
        RowBox[{
         OverscriptBox["\[Eta]", "_"], "\[CapitalPsi]"}], "+", 
        RowBox[{"\[Eta]", 
         OverscriptBox["\[CapitalPsi]", "_"]}]}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"6776fee2-0041-4cc2-a3b2-6a7bf5fb2708"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[Eta]", "_"], "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", "\[Delta]\[CapitalPsi]"]}]}], ",",
     " ", 
    RowBox[{"\[Eta]", "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", 
       RowBox[{"\[Delta]", 
        OverscriptBox["\[CapitalPsi]", "_"]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"9d1c0fde-ba58-4230-afaf-1bc5e21f92b3"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[CapitalPsi]", "_"], "=", 
     FractionBox["\[Delta]W", "\[Delta]\[Eta]"]}], ",", " ", 
    RowBox[{"\[CapitalPsi]", "=", 
     FractionBox["\[Delta]W", 
      RowBox[{"\[Delta]", 
       OverscriptBox["\[Eta]", "_"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "2006cbdf-5665-4c2f-b58e-3801b8e35f3c"]
}], "Text",
 CellChangeTimes->{{3.9777424556676073`*^9, 3.977742492777853*^9}, {
  3.977742570439184*^9, 
  3.9777425761726837`*^9}},ExpressionUUID->"fe171a29-89a9-48bd-800f-\
9e011df055d9"],

Cell[TextData[{
 StyleBox["Propagator:",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "[", 
     RowBox[{
      SubscriptBox["\[CapitalPsi]", "2"], ",", " ", 
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], "1"]}], "]"}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], " ", "W"}], 
      RowBox[{"\[Delta]", 
       SubscriptBox[
        OverscriptBox["\[Eta]", "_"], "2"], 
       SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], " ", "\[CapitalGamma]"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[CapitalPsi]", "1"], "\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], ")"}], 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]],ExpressionUUID->
  "e2e0699c-a485-481a-a222-bb52dde90268"],
 " "
}], "Text",
 CellChangeTimes->{{3.9777422783689823`*^9, 3.977742311362598*^9}, {
   3.977742776931649*^9, 3.977742918281127*^9}, 3.977743547017524*^9, {
   3.977743633183572*^9, 3.9777437095713*^9}, {3.977743769610282*^9, 
   3.977743793986821*^9}, {3.977744018094823*^9, 3.9777440401605787`*^9}, {
   3.977745197745122*^9, 3.977745271457673*^9}, 3.977745506199668*^9, {
   3.9778191676393557`*^9, 3.9778192062939157`*^9}, {3.977831017841881*^9, 
   3.977831018284525*^9}},ExpressionUUID->"a7ad5b41-09c7-4477-9661-\
f2008c2943ec"],

