Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Z2", " ", 
    RowBox[{"delta", "[", 
     RowBox[{"fund", ",", "c1", ",", "c2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"m", " ", "Zm", " ", 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "j", ",", "i"}], "]"}]}], "+", 
