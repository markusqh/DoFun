Cell[TextData[{
 "How to define the propagator Feynman rule:\n1. Calculate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{
      SubscriptBox["\[CapitalPsi]", "1"], 
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], " ", "=", " ", 
    RowBox[{
     RowBox[{"S", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalPsi]", ",", "i1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         OverscriptBox["\[CapitalPsi]", "_"], ",", "i2"}], "}"}]}], "]"}], 
     " ", "=", " ", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], " ", "S"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "1"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], "=", 
      RowBox[{"doFR", "[", 
       RowBox[{"action", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "2"], ",", 
          SubscriptBox["\[CapitalPsi]", "1"]}], "}"}]}], "]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"3b18d65c-dc3f-4018-8098-b9cadfe73bd6"],
 ".\n2. Invert it.\n4. Add dressings.\n5. Define propagator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "2"], ",", 
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], "1"]}], "]"}], TraditionalForm]],
  ExpressionUUID->"55368068-cda0-4055-be95-8e1d7c8fd158"],
 ". (Note: The indices are given such that they correspond to the indices in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "1"], 
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], "2"]}]], TraditionalForm]],
  ExpressionUUID->"a21c81c9-97ba-4c11-a072-cfeb1f2f85db"],
 ". The different directions of momenta, outgoing for P, incoming for S, \
needs to be taken into account.)\n6. Check ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "[", 
      RowBox[{
       SubscriptBox["\[CapitalPsi]", "3"], ",", 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "1"]}], "]"}], 
     RowBox[{"S", "[", 
      RowBox[{
       SubscriptBox["\[CapitalPsi]", "3"], ",", 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "2"]}], "]"}]}], "=", 
    SubscriptBox["\[Delta]", "12"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c42d553-3852-4456-96a9-640f949b92f3"],
 " with all dressings set to 1."
}], "Text",
 CellChangeTimes->{{3.9777422783689823`*^9, 3.977742311362598*^9}, {
   3.977742776931649*^9, 3.977742918281127*^9}, 3.977743547017524*^9, {
   3.977743633183572*^9, 3.9777437095713*^9}, {3.977743769610282*^9, 
   3.977743793986821*^9}, {3.977744018094823*^9, 3.9777440401605787`*^9}, {
   3.977745197745122*^9, 3.977745271457673*^9}, 3.977745506199668*^9, {
   3.9778191676393557`*^9, 3.9778191685983*^9}, {3.977831026730091*^9, 
   3.9778310470181923`*^9}, {3.97783117294088*^9, 3.9778311771406507`*^9}, {
   3.977831243443515*^9, 3.9778313702065353`*^9}, {3.9778334929297543`*^9, 
   3.977833501997867*^9}, {3.9778335432046623`*^9, 3.977833629445982*^9}, {
   3.9778343661265717`*^9, 
   3.977834392639695*^9}},ExpressionUUID->"b526a58d-6685-4eb2-8e62-\
8a828a1773a2"],

Cell[TextData[{
 StyleBox["n-point functions:",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{
      SubscriptBox["A", "1"], ",", 
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], "2"], ",", 
      SubscriptBox["\[CapitalPsi]", "3"]}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "$signConvention"}], " ", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "3"], " ", "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]A", "1"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "2"], 
        SubscriptBox["\[Delta]\[CapitalPsi]", "3"]}]]}], "=", 
     RowBox[{
      RowBox[{"doDSE", "[", 
       RowBox[{"action", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["\[CapitalPsi]", "3"], ",", 
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "2"], ",", 
          SubscriptBox["A", "1"]}], "}"}]}], "]"}], " ", "<->", " ", 
      RowBox[{"doFR", "[", 
       RowBox[{"action", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["\[CapitalPsi]", "3"], ",", 
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "2"], ",", 
          SubscriptBox["A", "1"]}], "}"}]}], "]"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"dca57ed7-5c9a-4f03-a4d9-c8829f0a63ee"]
}], "Text",
 CellChangeTimes->{{3.977742503389308*^9, 3.9777425050385838`*^9}, {
  3.977742584843485*^9, 3.977742719107325*^9}, {3.97774358688256*^9, 
  3.9777436159770107`*^9}, {3.977744046536042*^9, 3.977744185073443*^9}, {
  3.977837916411944*^9, 
  3.9778379168542643`*^9}},ExpressionUUID->"8e3b8cdd-0de8-4c85-9d7f-\
8f138cf36032"],

Cell[TextData[{
 StyleBox["Momenta:",
  FontWeight->"Bold"],
 "\nV, S, dR: incoming\nP: outgoing"
}], "Text",
 CellChangeTimes->{{3.977742390545712*^9, 
  3.97774242512637*^9}},ExpressionUUID->"bcd23530-efe8-449a-84e8-\
626f4635f0a4"]
}, Open  ]]
}, Open  ]],

