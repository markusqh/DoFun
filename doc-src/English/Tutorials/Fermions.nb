Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Z", "[", 
     RowBox[{
      OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"W", "[", 
       RowBox[{
        OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}]], " ", "=", 
     RowBox[{"\[Integral]", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         OverscriptBox["\[Psi]", "_"], "\[Psi]"}], "]"}], 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"S", "[", 
           RowBox[{"\[Psi]", ",", 
            OverscriptBox["\[Psi]", "_"]}], "]"}]}], "+", 
         RowBox[{"\[Integral]", 
          RowBox[{"dx", "(", 
           RowBox[{
            RowBox[{
             OverscriptBox["\[Eta]", "_"], "\[Psi]"}], "+", 
            RowBox[{"\[Eta]", 
             OverscriptBox["\[Psi]", "_"]}]}], ")"}]}]}]]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"9e1bcf82-ea74-4a4f-9fcd-2c1f830ae4c5"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
