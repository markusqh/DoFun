Cell[TextData[{
 "The propagator is the inverse of the two-point function (using symbolic \
notation with integration over repeated indices):\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]", "ij"], "=", 
    RowBox[{
     FormBox[
      FractionBox[
       SubscriptBox["\[Delta]\[Eta]", "j"], 
       SubscriptBox["\[Delta]\[Eta]", "i"]],
      TraditionalForm], "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        SubscriptBox["\[Delta]\[CapitalPsi]", "k"], 
        SubscriptBox["\[Delta]\[Eta]", "i"]], 
       FractionBox["\[Delta]", 
        SubscriptBox["\[Delta]\[CapitalPsi]", "k"]], 
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["\[Delta]\[CapitalGamma]", 
          RowBox[{"\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[CapitalPsi]", "_"], "j"]}]]}], ")"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[Eta]", "i"], "\[Delta]", 
            SubscriptBox[
             OverscriptBox["\[Eta]", "_"], "k"]}]],
          TraditionalForm]}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "j"]}]]}], "=", 
       RowBox[{
        RowBox[{
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{"\[Delta]", 
            SubscriptBox[
             OverscriptBox["\[Eta]", "_"], "k"], 
            SubscriptBox["\[Delta]\[Eta]", "i"]}]],
          TraditionalForm], 
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
            SubscriptBox[
             OverscriptBox["\[CapitalPsi]", "_"], "j"]}]], "\[DoubleLongRightArrow]", 
          FormBox[
           FractionBox[
            RowBox[{
             SuperscriptBox["\[Delta]", "2"], "W"}], 
            RowBox[{"\[Delta]", 
             SubscriptBox[
              OverscriptBox["\[Eta]", "_"], "2"], 
             SubscriptBox["\[Delta]\[Eta]", "1"]}]],
           TraditionalForm]}]}], "=", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[CapitalPsi]", "2"], "\[Delta]", 
            SubscriptBox[
             OverscriptBox["\[CapitalPsi]", "_"], "1"]}]], ")"}], 
         RowBox[{"-", "1"}]]}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "808d431e-a340-4110-ac65-4a442886abdc"],
 " "
}], "Text",
 CellChangeTimes->{{3.977542554278988*^9, 3.9775425724225616`*^9}, {
  3.977542675056697*^9, 3.9775426872668552`*^9}, {3.97754297094258*^9, 
  3.9775429711593637`*^9}, {3.977999267366473*^9, 3.977999267706663*^9}, {
  3.9794811774173613`*^9, 3.9794811821496696`*^9}, {3.98577171028249*^9, 
  3.98577177806851*^9}, {3.985773501361925*^9, 3.985773504253213*^9}, {
  3.985773624648532*^9, 3.985773629712151*^9}, {3.985773670187992*^9, 
  3.985773682117021*^9}, {3.985773721386609*^9, 3.985773727109569*^9}, {
  3.9887155520009747`*^9, 
  3.98871556754277*^9}},ExpressionUUID->"5e07eb44-510c-4f2f-a8df-\
f01baa1281f4"],

Cell[TextData[{
 "This can also be illustrated directly for the bare propagator. Considering \
only the part of the action quadratic in the fermionic fields, one can \
complete the square in the path integral,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FormBox[
       RowBox[{
        SuperscriptBox["S", 
         RowBox[{
          SubscriptBox["\[Psi]", "j"], 
          SubscriptBox[
           OverscriptBox["\[Psi]", "_"], "i"]}]], 
        SubscriptBox[
         OverscriptBox["\[Psi]", "_"], "i"], 
        SubscriptBox["\[Psi]", "j"]}],
       TraditionalForm]}], "+", 
     FormBox[
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Eta]", "_"], "i"], 
        SubscriptBox["\[Psi]", "i"]}], "+", 
       RowBox[{
        SubscriptBox["\[Eta]", "i"], 
        SubscriptBox[
         OverscriptBox["\[Psi]", "_"], "i"]}]}],
      TraditionalForm]}], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FormBox[
         RowBox[{"-", 
          SubscriptBox[
           OverscriptBox["\[Psi]", "_"], "i"]}],
         TraditionalForm], "+", 
        SuperscriptBox[
         RowBox[{
          SubscriptBox[
           FormBox[
            OverscriptBox["\[Eta]", "_"],
            TraditionalForm], "k"], "[", 
          FormBox[
           SuperscriptBox["S", 
            RowBox[{
             SubscriptBox["\[Psi]", "k"], 
             SubscriptBox[
              OverscriptBox["\[Psi]", "_"], "i"]}]],
           TraditionalForm], "]"}], 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{
       FormBox[
        SuperscriptBox["S", 
         RowBox[{
          SubscriptBox["\[Psi]", "j"], 
          SubscriptBox[
           OverscriptBox["\[Psi]", "_"], "i"]}]],
        TraditionalForm], "(", 
       RowBox[{
        SubscriptBox["\[Psi]", "j"], "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"[", 
           SuperscriptBox["S", 
            RowBox[{
             SubscriptBox["\[Psi]", "j"], 
             SubscriptBox[
              OverscriptBox["\[Psi]", "_"], "l"]}]], "]"}], 
          RowBox[{"-", "1"}]], 
         SubscriptBox["\[Eta]", "l"]}]}], ")"}]}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Eta]", "_"], "k"], " ", "[", 
        SuperscriptBox["S", 
         RowBox[{
          SubscriptBox["\[Psi]", "k"], 
          SubscriptBox[
           OverscriptBox["\[Psi]", "_"], "l"]}]], "]"}], 
       RowBox[{"-", "1"}]], 
      SubscriptBox["\[Eta]", "l"]}]}]}], TraditionalForm]],ExpressionUUID->
  "b042daa3-015f-4e2b-8386-9fb17676705f"],
 ",\nshift the fields and integrate them out. Then only\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["W", "0"], "[", 
     RowBox[{
      OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}], "=", 
    RowBox[{"ln", "(", 
     RowBox[{"N", " ", 
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{
           SubscriptBox[
            OverscriptBox["\[Eta]", "_"], "i"], " ", "[", 
           SuperscriptBox["S", 
            RowBox[{
             SubscriptBox["\[Psi]", "i"], 
             SubscriptBox[
              OverscriptBox["\[Psi]", "_"], "j"]}]], "]"}], 
          RowBox[{"-", "1"}]]}], 
        SubscriptBox["\[Eta]", "j"]}], ")"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"53b50b1f-8c49-4b85-9796-291ce944dbcb"],
 "\nremains, where the superscript 0 indicates that interactions were \
dropped. The bare propagator ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], 
     SuperscriptBox["W", "0"]}], 
    RowBox[{"\[Delta]", 
     SubscriptBox[
      OverscriptBox["\[Eta]", "_"], "2"], 
     SubscriptBox["\[Delta]\[Eta]", "1"]}]], TraditionalForm]],ExpressionUUID->
  "2c69a5fc-7a43-4334-9343-92dce81af141"],
 " is then given by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", 
     SuperscriptBox["S", 
      RowBox[{
       SubscriptBox["\[Psi]", "2"], 
       SubscriptBox[
        OverscriptBox["\[Psi]", "_"], "1"]}]], "]"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "ce64da9d-5c11-46f1-bc5d-c7a2f0da153d"],
 "."
}], "Text",
 CellChangeTimes->{{3.972100891749976*^9, 3.972101208319063*^9}, {
   3.972101335164773*^9, 3.972101382836917*^9}, {3.972101466999653*^9, 
   3.9721015014482937`*^9}, {3.972101558896555*^9, 3.972101573061*^9}, 
   3.9774666781278048`*^9, {3.977475452673171*^9, 3.977475455044116*^9}, {
   3.977543326804388*^9, 3.9775437201994343`*^9}, {3.977543785459655*^9, 
   3.97754379465628*^9}, {3.9775438261949244`*^9, 3.977543826525124*^9}, {
   3.977543863572027*^9, 3.977543955071534*^9}, {3.977543989903014*^9, 
   3.9775441192064133`*^9}, {3.97754498464995*^9, 3.9775449856811533`*^9}, {
   3.977545702593629*^9, 3.977545705037938*^9}, {3.977545807191244*^9, 
   3.977545916018653*^9}, {3.9777449176864347`*^9, 3.977744922830277*^9}, {
   3.977972282506557*^9, 3.97797236157635*^9}, {3.977972669331541*^9, 
   3.977972681017022*^9}, {3.977972720909505*^9, 3.977972791892572*^9}, 
   3.977999271741851*^9, {3.979470391681521*^9, 3.979470414406172*^9}, {
   3.9794704926577578`*^9, 3.97947049645965*^9}, {3.979470532131686*^9, 
   3.979470562876154*^9}, {3.979470619057938*^9, 3.9794707357125196`*^9}, {
   3.979470957823155*^9, 3.97947105453617*^9}, {3.980419917225349*^9, 
   3.980419960500681*^9}, {3.980419991049366*^9, 3.9804200902008047`*^9}, {
   3.9804201461135197`*^9, 3.980420168679228*^9}, {3.980420311092284*^9, 
   3.980420357204193*^9}, {3.9857709691420803`*^9, 3.9857710429074583`*^9}, {
   3.985771085704948*^9, 3.985771134608232*^9}, {3.9857711909193983`*^9, 
   3.9857712234819527`*^9}, {3.9857712602818003`*^9, 3.98577132932092*^9}, {
   3.985771538504496*^9, 3.985771541616893*^9}, {3.985771653857053*^9, 
   3.985771658514778*^9}, {3.988715001417448*^9, 3.988715008283523*^9}, {
   3.988715573773265*^9, 3.98871561608396*^9}, {3.9887156875607843`*^9, 
   3.988715688104308*^9}},ExpressionUUID->"20055634-2e35-4f63-9b80-\
438e0e008b77"],

Cell[TextData[{
 "For an example, consider the action\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"A", ",", "\[Psi]", ",", 
      OverscriptBox["\[Psi]", "_"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["d", "d"], "q"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], " ", 
       SubscriptBox["Z", "2"], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["\[Psi]", "_"], "i"], "(", "q", ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubscriptBox["q", "\[Mu]"], 
          SubscriptBox["\[Gamma]", 
           RowBox[{"\[Mu]", " "}]]}], "+", 
         RowBox[{"m", " ", 
          SubscriptBox["Z", "m"]}]}], ")"}], 
       RowBox[{
        SuperscriptBox["\[Psi]", "i"], "(", 
        RowBox[{"-", "q"}], ")"}]}]}], "-", 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["d", "d"], "q"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["d", "d"], "r"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
       SubscriptBox["Z", 
        RowBox[{"1", "F"}]], "\[ImaginaryI]", " ", "g", " ", 
       SubsuperscriptBox["T", "ij", "a"], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["\[Psi]", "_"], "i"], "(", "q", ")"}], 
       SuperscriptBox[
        RowBox[{"\[Psi]", " "}], "j"], 
       RowBox[{"(", "r", ")"}], 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "a"], "(", 
        RowBox[{
         RowBox[{"-", "q"}], "-", "r"}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c254bace-4e42-4cd9-b32c-1a8d13b9a645"],
 "."
}], "Text",
 CellChangeTimes->{{3.901870981232856*^9, 3.90187098327337*^9}, {
   3.902286456418818*^9, 3.902286460910561*^9}, {3.931001860304375*^9, 
   3.931001885366467*^9}, 3.931001926530777*^9, {3.948113770827875*^9, 
   3.948113795579723*^9}, {3.948114084828415*^9, 3.948114088742712*^9}, {
   3.962606479915216*^9, 3.962606485990947*^9}, {3.977999248722584*^9, 
   3.9779992489316387`*^9}, {3.979470194484499*^9, 3.97947019470964*^9}, {
   3.988715695473113*^9, 
   3.988715705672961*^9}},ExpressionUUID->"c7fc16a9-73c1-426c-a798-\
f6eb316b035e"],

Cell[TextData[{
 "Then:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{
      SubscriptBox["\[Psi]", "2"], 
      SubscriptBox[
       OverscriptBox["\[Psi]", "_"], "1"]}]], "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Delta]", "2"], "S"}], 
      RowBox[{
       SubscriptBox["\[Delta]\[CapitalPsi]", "2"], "\[Delta]", 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "1"]}]], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["Z", "2"], "(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubscriptBox[
           SubscriptBox["p", "1"], "\[Mu]"], 
          SubscriptBox["\[Gamma]", 
           RowBox[{"\[Mu]", " "}]]}], "+", 
         RowBox[{"m", " ", 
          SubscriptBox["Z", "m"]}]}], ")"}], 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
       RowBox[{
        RowBox[{"\[Delta]", "(", 
         RowBox[{
          SubscriptBox["p", "1"], "+", 
          SubscriptBox["p", "2"]}], ")"}], "\[DoubleLongRightArrow]", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], 
          SuperscriptBox["W", "0"]}], 
         RowBox[{"\[Delta]", 
          SubscriptBox[
           OverscriptBox["\[Eta]", "_"], "2"], 
          SubscriptBox["\[Delta]\[Eta]", "1"]}]]}]}], "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "S"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[CapitalPsi]", "2"], "\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[CapitalPsi]", "_"], "1"]}]], ")"}], 
        RowBox[{"-", "1"}]], "=", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"[", 
          SuperscriptBox["S", 
           RowBox[{
            SubscriptBox["\[Psi]", "2"], 
            SubscriptBox[
             OverscriptBox["\[Psi]", "_"], "1"]}]], "]"}], 
         RowBox[{"-", "1"}]], "=", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], "d"], 
          RowBox[{"\[Delta]", "(", 
           RowBox[{
            SubscriptBox["p", "1"], "+", 
            SubscriptBox["p", "2"]}], ")"}], 
          FractionBox["1", 
           SubscriptBox["Z", "2"]], 
          FractionBox[
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", 
             SubscriptBox[
              SubscriptBox["p", "1"], "\[Mu]"], 
             SubscriptBox["\[Gamma]", 
              RowBox[{"\[Mu]", " "}]]}], "+", 
            RowBox[{"m", " ", 
             SubscriptBox["Z", "m"]}]}], 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["p", "1"], "2"], "+", 
            SuperscriptBox["m", "2"]}]]}], "=", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], "d"], 
          RowBox[{"\[Delta]", "(", 
           RowBox[{
            SubscriptBox["p", "1"], "+", 
            SubscriptBox["p", "2"]}], ")"}], 
          FractionBox["1", 
           SubscriptBox["Z", "2"]], 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", 
             SubscriptBox[
              SubscriptBox["p", "2"], "\[Mu]"], 
             SubscriptBox["\[Gamma]", 
              RowBox[{"\[Mu]", " "}]]}], "+", 
            RowBox[{"m", " ", 
             SubscriptBox["Z", "m"]}]}], 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["p", "1"], "2"], "+", 
            SuperscriptBox["m", "2"]}]]}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"1d9dc7d1-ed24-4bb3-a13a-93330d901951"]
}], "Text",
 CellChangeTimes->{{3.972100891749976*^9, 3.972101208319063*^9}, {
   3.972101335164773*^9, 3.972101382836917*^9}, {3.972101466999653*^9, 
   3.9721015014482937`*^9}, {3.972101558896555*^9, 3.972101573061*^9}, 
   3.9774666781278048`*^9, {3.977475452673171*^9, 3.977475455044116*^9}, {
   3.977543326804388*^9, 3.9775437201994343`*^9}, {3.977543785459655*^9, 
   3.97754379465628*^9}, {3.9775438261949244`*^9, 3.977543826525124*^9}, {
   3.977543863572027*^9, 3.977543955071534*^9}, {3.977543989903014*^9, 
   3.9775441192064133`*^9}, {3.97754498464995*^9, 3.9775449856811533`*^9}, {
   3.977545702593629*^9, 3.977545705037938*^9}, {3.977545807191244*^9, 
   3.977545916018653*^9}, {3.9777449176864347`*^9, 3.977744922830277*^9}, {
   3.977972282506557*^9, 3.97797236157635*^9}, {3.977972669331541*^9, 
   3.977972681017022*^9}, {3.977972720909505*^9, 3.977972791892572*^9}, 
   3.977999271741851*^9, {3.979470391681521*^9, 3.979470414406172*^9}, {
   3.9794704926577578`*^9, 3.97947049645965*^9}, {3.979470532131686*^9, 
   3.979470562876154*^9}, {3.979470619057938*^9, 3.9794707357125196`*^9}, {
   3.979470957823155*^9, 3.97947105453617*^9}, {3.980419917225349*^9, 
   3.980419960500681*^9}, {3.980419991049366*^9, 3.9804200902008047`*^9}, {
   3.9804201461135197`*^9, 3.980420168679228*^9}, {3.980420311092284*^9, 
   3.980420357204193*^9}, {3.9857709691420803`*^9, 3.9857710429074583`*^9}, {
   3.985771085704948*^9, 3.985771134608232*^9}, {3.9857711909193983`*^9, 
   3.9857712234819527`*^9}, {3.9857712602818003`*^9, 3.98577132932092*^9}, {
   3.985771538504496*^9, 3.985771541616893*^9}, {3.985771653857053*^9, 
   3.985771658514778*^9}, {3.988715001417448*^9, 3.988715008283523*^9}, {
   3.988715573773265*^9, 3.98871561608396*^9}, {3.9887156875607843`*^9, 
   3.988715714177875*^9}},ExpressionUUID->"d1d0e593-cfe4-40da-8b92-\
2cd40322c776"],

Cell[CellGroupData[{

Cell["Derivation of \[Delta]P/\[Delta]\[Phi]", "Subsection",
 CellChangeTimes->{{3.9793709788730707`*^9, 
  3.979371004308313*^9}},ExpressionUUID->"8ba95a1c-32f8-492e-9db0-\
de2eaa15b535"],

Cell[TextData[{
 "We consider a superfield \[Phi] with bosonic and fermionic components. The \
corresponding source is \[Xi].\nFor example, \[Phi] can represent a bosonic \
field A and fermionic fields \[CapitalPsi], ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "4f64ab3e-3f90-4d69-9abc-c4498f284cf1"],
 " with sources J, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Eta]", "_"], TraditionalForm]],ExpressionUUID->
  "327480ca-3352-4362-91ed-a33ccd8b9f53"],
 ", \[Eta]. Then the following relations hold:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[Eta]", "_"], "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", "\[Delta]\[CapitalPsi]"]}]}], ",",
     " ", 
    RowBox[{"\[Eta]", "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", 
       RowBox[{"\[Delta]", 
        OverscriptBox["\[CapitalPsi]", "_"]}]]}]}], ",", " ", 
    RowBox[{"J", "=", 
     FractionBox["\[Delta]\[CapitalGamma]", "\[Delta]A"]}]}], 
   TraditionalForm]],ExpressionUUID->"e9db30a3-8b8a-47fa-a8f3-9eaf787409f5"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[CapitalPsi]", "_"], "=", 
     FractionBox["\[Delta]W", "\[Delta]\[Eta]"]}], ",", " ", 
    RowBox[{"\[CapitalPsi]", "=", 
     FractionBox["\[Delta]W", 
      RowBox[{"\[Delta]", 
       OverscriptBox["\[Eta]", "_"]}]]}], ",", " ", 
    RowBox[{"A", "=", 
     FractionBox["\[Delta]W", "\[Delta]J"]}]}], TraditionalForm]],
  ExpressionUUID->"9d52cc1c-d009-4fb2-868f-b2e7eac8ea9f"],
 ".\t"
}], "Text",
 CellChangeTimes->{{3.977542554278988*^9, 3.9775425724225616`*^9}, {
  3.977542675056697*^9, 3.9775426872668552`*^9}, {3.97754297094258*^9, 
  3.9775429711593637`*^9}, {3.977999267366473*^9, 3.977999267706663*^9}, {
  3.979371041203713*^9, 3.97937123982934*^9}, {3.979371274466998*^9, 
  3.979371279107679*^9}, {3.979371365796954*^9, 
  3.979371502330765*^9}},ExpressionUUID->"45324f49-7f47-4422-b009-\
aa6da6d2e3cd"],

Cell[TextData[{
 "Minus signs from interchanging fermionic fields are taken into account via \
the following function:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Epsilon]", "i", 
     RowBox[{"jk", "..."}]], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{
      RowBox[{"#", " ", "fermions", " ", "in", " ", "j"}], ",", "k", ",", 
      "..."}]]}], TraditionalForm]],ExpressionUUID->
  "b6fa74a6-0a62-42c5-97b0-b1ada32ac414"],
 " if index i corresponds to a fermionic field/source. The function is 1 if \
the index i corresponds to a bosonic field.\nThe derivatives above can thus \
be abbreviated as\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Xi]", "i"], "=", 
     RowBox[{
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Phi]", "i"], 
       SubscriptBox["\[Phi]", "i"]], 
      FractionBox["\[Delta]\[CapitalGamma]", 
       SubscriptBox["\[Delta]\[Phi]", "i"]]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["\[Phi]", "1"], "=", 
     FractionBox["\[Delta]W", 
      SubscriptBox["\[Delta]\[Xi]", "i"]]}]}], TraditionalForm]],
  ExpressionUUID->"adf91df1-efd9-4b84-8761-ce6594765d5f"],
 "."
}], "Text",
 CellChangeTimes->{{3.977542554278988*^9, 3.9775425724225616`*^9}, {
  3.977542675056697*^9, 3.9775426872668552`*^9}, {3.97754297094258*^9, 
  3.9775429711593637`*^9}, {3.977999267366473*^9, 3.977999267706663*^9}, {
  3.979371041203713*^9, 3.97937123982934*^9}, {3.979371274466998*^9, 
  3.979371279107679*^9}, {3.979371365796954*^9, 3.979371373500545*^9}, {
  3.979455408752537*^9, 3.979455439372778*^9}, {3.979455489139504*^9, 
  3.979455489992875*^9}, {3.985778017332315*^9, 3.985778141446692*^9}, {
  3.986031397897155*^9, 3.9860313989298363`*^9}, {3.986031439094657*^9, 
  3.9860314465778437`*^9}},ExpressionUUID->"2bca449a-99af-4e5d-aa0b-\
fdf58a6755c7"],

Cell[TextData[{
 "We start by showing that the propagator is the inverse of the two-point \
function (using symbolic notation with integration over repeated indices). We \
keep all potential signs for later.",
 StyleBox["\n",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]", "ij"], "=", 
    RowBox[{
     FormBox[
      FractionBox[
       SubscriptBox["\[Delta]\[Xi]", "j"], 
       SubscriptBox["\[Delta]\[Xi]", "i"]],
      TraditionalForm], "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        SubscriptBox["\[Delta]\[Phi]", "k"], 
        SubscriptBox["\[Delta]\[Xi]", "i"]], 
       FractionBox["\[Delta]", 
        SubscriptBox["\[Delta]\[Phi]", "k"]], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "j"], 
          SubscriptBox["\[Phi]", "j"]], 
         FractionBox["\[Delta]\[CapitalGamma]", 
          SubscriptBox["\[Delta]\[Phi]", "j"]]}], ")"}]}], "=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", 
         SubscriptBox["\[Phi]", "j"], 
         SubscriptBox["\[Phi]", "j"]], 
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "W"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[Xi]", "i"], 
           SubscriptBox["\[Delta]\[Xi]", "k"]}]],
         TraditionalForm], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[Phi]", "k"], 
          SubscriptBox["\[Delta]\[Phi]", "j"]}]]}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "j"], 
          SubscriptBox["\[Phi]", "j"]], 
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "k"], 
          SubscriptBox["\[Phi]", "i"]], 
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[Xi]", "k"], 
            SubscriptBox["\[Delta]\[Xi]", "i"]}]],
          TraditionalForm], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[CapitalPhi]", "k"], 
           SubscriptBox["\[Delta]\[Phi]", "j"]}]]}], "=", 
        RowBox[{
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "j"], 
          SubscriptBox["\[Phi]", "j"]], 
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "k"], 
          SubscriptBox["\[Phi]", "j"]], 
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[Xi]", "i"], 
            SubscriptBox["\[Delta]\[Xi]", "k"]}]],
          TraditionalForm], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[Phi]", "j"], 
           SubscriptBox["\[Delta]\[Phi]", "k"]}]]}]}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"8e329d0b-b844-45a0-822e-1262a5273af2"],
 "\nAlternatively, one can start with the fields:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]", "ij"], "=", 
    RowBox[{
     FormBox[
      FractionBox[
       SubscriptBox["\[Delta]\[Phi]", "j"], 
       SubscriptBox["\[Delta]\[Phi]", "i"]],
      TraditionalForm], "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        SubscriptBox["\[Delta]\[Xi]", "k"], 
        SubscriptBox["\[Delta]\[Phi]", "i"]], 
       FractionBox["\[Delta]", 
        SubscriptBox["\[Delta]\[Xi]", "k"]], 
       FractionBox["\[Delta]W", 
        SubscriptBox["\[Delta]\[Xi]", "j"]]}], "=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", 
         SubscriptBox["\[Phi]", "k"], 
         SubscriptBox["\[Phi]", "k"]], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[Phi]", "i"], 
          SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "W"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[Xi]", "k"], 
           SubscriptBox["\[Delta]\[Xi]", "j"]}]],
         TraditionalForm]}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "k"], 
          SubscriptBox["\[Phi]", "k"]], 
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "i"], 
          SubscriptBox["\[Phi]", "k"]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[Phi]", "k"], 
           SubscriptBox["\[Delta]\[Phi]", "i"]}]], 
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[Xi]", "k"], 
            SubscriptBox["\[Delta]\[Xi]", "j"]}]],
          TraditionalForm]}], "=", 
        RowBox[{
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "k"], 
          SubscriptBox["\[Phi]", "k"]], 
         SubsuperscriptBox["\[Epsilon]", 
          SubscriptBox["\[Phi]", "j"], 
          SubscriptBox["\[Phi]", "k"]], 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
          RowBox[{
           SubscriptBox["\[Delta]\[Phi]", "i"], 
           SubscriptBox["\[Delta]\[Phi]", "k"]}]], 
         FormBox[
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "W"}], 
           RowBox[{
            SubscriptBox["\[Delta]\[Xi]", "j"], 
            SubscriptBox["\[Delta]\[Xi]", "k"]}]],
          TraditionalForm]}]}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "b70f7f2b-2b57-4888-bf99-1d88d38470ba"],
 "\nTo show the equivalence of the two expressions one needs to take into \
account that the indices i and j refer to the same field if the left-hand \
side is not zero."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwdzlsow2EYBvCFWmLlzLgihpQhZ7vw14o5luLCKdQkYpZZKLtwTk4XI9Za
QjZscsphhbUkJCFEinKu+V8QtVB8z3fx9uu5eJ7ewEpZvtSBw+EEkoPNbEbj
