Cell[CellGroupData[{

Cell["Fermions", "Title",
 CellChangeTimes->{{3.948113691602951*^9, 3.948113693094727*^9}},
 CellID->509267359,ExpressionUUID->"5ad4d6f9-a109-4747-99ad-abd4139bfd3d"],

Cell[TextData[{
 "This document describes the conventions for fermions. Note that this ",
 StyleBox["supersedes previous documentation",
  FontSlant->"Italic"],
 ".\nBelow also a cheat sheet for ",
 ButtonBox["quick reference",
  BaseStyle->"Hyperlink",
  ButtonData->"Cheat sheet"],
 " is provided."
}], "Text",
 CellChangeTimes->{{3.784870848360153*^9, 3.784870869144309*^9}, {
  3.902285446902474*^9, 3.902285447028405*^9}, {3.902286348129747*^9, 
  3.902286426703032*^9}, {3.902824905235797*^9, 3.902824907905432*^9}, {
  3.902824955305677*^9, 3.902824955711185*^9}, {3.9310016607331867`*^9, 
  3.9310016788758287`*^9}, {3.94811369796491*^9, 3.948113745567008*^9}, {
  3.977971449235194*^9, 3.9779714635973797`*^9}, {3.977971626308372*^9, 
  3.977971631829928*^9}, {3.979455354441304*^9, 3.97945536584083*^9}},
 CellID->1534169418,ExpressionUUID->"2ea02407-09b3-4b62-8546-cb71abb20bfc"],

Cell[CellGroupData[{

Cell["Action, generating functionals, propagators and vertices", "Section",
 CellChangeTimes->{{3.784870893912496*^9, 3.784870902072659*^9}, {
  3.948113755135345*^9, 3.948113755870718*^9}, {3.948113873366518*^9, 
  3.948113877535141*^9}, {3.973608040888588*^9, 3.9736080469145327`*^9}},
 CellID->490632353,ExpressionUUID->"550489a9-af9f-4519-ab18-3fc0aa55e0e4"],

Cell[TextData[{
 "The action in symbolic form (integration is implied) is given by:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"A", ",", "\[Psi]", ",", 
      OverscriptBox["\[Psi]", "_"]}], "]"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"\[Psi]", 
        OverscriptBox["\[Psi]", "_"]}]], 
      OverscriptBox["\[Psi]", "_"], "\[Psi]"}], " ", "+", 
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"A\[Psi]", 
        OverscriptBox["\[Psi]", "_"]}]], 
      OverscriptBox["\[Psi]", "_"], "\[Psi]", " ", "A"}]}]}], 
   TraditionalForm]],ExpressionUUID->"4ec10391-4c43-461e-b57a-82d4308cf0f1"],
 "."
}], "Text",
 CellChangeTimes->{{3.901870981232856*^9, 3.90187098327337*^9}, {
   3.902286456418818*^9, 3.902286460910561*^9}, {3.931001860304375*^9, 
   3.931001885366467*^9}, 3.931001926530777*^9, {3.948113770827875*^9, 
   3.948113795579723*^9}, {3.948114084828415*^9, 3.948114088742712*^9}, {
   3.962606479915216*^9, 3.9626064825343924`*^9}, {3.962606793230007*^9, 
   3.962606804030469*^9}, {3.9779992533044243`*^9, 3.977999253411406*^9}, {
   3.979470196299081*^9, 3.979470196599172*^9}, {3.9887156628839483`*^9, 
   3.98871566933442*^9}},ExpressionUUID->"d45f1ded-0c47-4577-877e-\
eb51254b447f"],

Cell[TextData[{
 "The coefficients of the fields ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", 
    RowBox[{"\[Psi]", 
     OverscriptBox["\[Psi]", "_"]}]], TraditionalForm]],ExpressionUUID->
  "71fe196a-afcc-40e8-8d81-c220f59a41cf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", 
    RowBox[{"A\[Psi]", 
     OverscriptBox["\[Psi]", "_"]}]], TraditionalForm]],ExpressionUUID->
  "2415af13-f4ec-4239-98b4-6409aeeb8e9d"],
 " and the field have opposite order. With this choice, we obtain the \
coefficients as (left-)derivatives from the action in the same order, e.g., \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{"A\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Delta]", "3"], 
      RowBox[{
       RowBox[{
        RowBox[{"S", "/", "\[Delta]A"}], "/", "\[Delta]\[Psi]"}], "/", 
       "\[Delta]"}], 
      OverscriptBox["\[Psi]", "_"]}], 
     SubscriptBox["|", 
      RowBox[{"A", "=", 
       RowBox[{"\[Psi]", "=", 
        RowBox[{
         OverscriptBox["\[Psi]", "_"], "=", "0"}]}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"7978d306-02a4-4aa7-9241-71f56e4ee784"],
 ". The coefficients correspond to the tree-level expressions.\n",
 StyleBox["As a consequence, we define vertices with fermions left of \
anti-fermions, e.g., <A \[Psi] ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Psi]", "_"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"cdf60cc9-17f6-423e-8c31-47632970b7b6"],
 StyleBox["> \[Rule] V[A, \[Psi], ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Psi]", "_"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"caf25217-b44b-4ac4-a285-86a6be38b381"],
 StyleBox["]. This is different to previous versions of DoFun.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.977971479700247*^9, 3.977971596406528*^9}, {
  3.97947004098967*^9, 3.979470111866809*^9}, {3.979470164773781*^9, 
  3.979470236710001*^9}, {3.985769887502082*^9, 3.985769919962144*^9}, {
  3.988620187051737*^9, 3.988620328795038*^9}, {3.988715177508391*^9, 
  3.988715190520483*^9}, {3.988715229273735*^9, 3.988715420410725*^9}, {
  3.9887156756343517`*^9, 
  3.988715676512842*^9}},ExpressionUUID->"41a29868-c01b-47f6-8f0e-\
2ff160a5b9fc"],

Cell[TextData[{
 "The path integral is given by\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Z", "[", 
     RowBox[{
      OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"W", "[", 
       RowBox[{
        OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}]], " ", "=", 
     RowBox[{"\[Integral]", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         OverscriptBox["\[Psi]", "_"], "\[Psi]"}], "]"}], 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"S", "[", 
           RowBox[{"A", ",", "\[Psi]", ",", 
            OverscriptBox["\[Psi]", "_"]}], "]"}]}], "+", 
         RowBox[{"\[Integral]", 
          RowBox[{"dx", "(", 
           RowBox[{
            RowBox[{
             OverscriptBox["\[Eta]", "_"], "\[Psi]"}], "+", 
            RowBox[{"\[Eta]", 
             OverscriptBox["\[Psi]", "_"]}]}], ")"}]}]}]]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"e08a90e1-fef0-4bc0-8ed7-eadb2e9d02d9"]
}], "Text",
 CellChangeTimes->{{3.901870990423199*^9, 3.901871117336906*^9}, 
   3.902285470348755*^9, 3.9022866614112053`*^9, {3.902286710447488*^9, 
   3.902286727746322*^9}, {3.902406540983011*^9, 3.902406604328875*^9}, {
   3.931001698385118*^9, 3.93100173086585*^9}, {3.948113880775463*^9, 
   3.948113912027194*^9}, {3.948114063182558*^9, 3.9481140685820704`*^9}, {
   3.962606066834278*^9, 3.962606067627521*^9}, {3.971591049746356*^9, 
   3.971591050210375*^9}, {3.976855399989662*^9, 3.976855400366728*^9}, {
   3.9775424953638153`*^9, 3.977542495633102*^9}, {3.977999258569701*^9, 
   3.977999258695777*^9}, {3.979470243115562*^9, 3.979470243363241*^9}, 
   3.98871545543505*^9},ExpressionUUID->"3e371d28-2823-4b78-86e2-\
0154fdea0220"],

Cell[TextData[{
 "and the effective action is defined as\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalGamma]", "[", 
     RowBox[{"\[CapitalPsi]", ",", 
      OverscriptBox["\[CapitalPsi]", "_"]}], "]"}], "=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"W", "[", 
       RowBox[{
        OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}]}], "+", 
     RowBox[{"\[Integral]", 
      RowBox[{"dx", "(", 
       RowBox[{
        RowBox[{"J", " ", "A"}], " ", "+", " ", 
        RowBox[{
         OverscriptBox["\[Eta]", "_"], "\[CapitalPsi]"}], " ", "+", " ", 
        RowBox[{"\[Eta]", 
         OverscriptBox["\[CapitalPsi]", "_"]}]}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"92b01d0c-26b5-4e91-9d43-1494fc320652"]
}], "Text",
 CellChangeTimes->{{3.948114114843569*^9, 3.948114119027444*^9}, {
   3.971591070868703*^9, 3.9715910790591297`*^9}, {3.9715911127724323`*^9, 
   3.971591120340458*^9}, 3.9722994089768744`*^9, {3.977999261637471*^9, 
   3.9779992618254347`*^9}, {3.979470247717684*^9, 3.97947026192551*^9}, {
   3.988715456973303*^9, 
   3.988715457789386*^9}},ExpressionUUID->"cc2c2854-43ef-4a59-9b5a-\
8a0768b742fa"],

Cell[TextData[{
 "with (all derivatives are from the left)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[Eta]", "_"], "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", "\[Delta]\[CapitalPsi]"]}]}], ",",
     " ", 
    RowBox[{"\[Eta]", "=", 
     RowBox[{"-", 
      FractionBox["\[Delta]\[CapitalGamma]", 
       RowBox[{"\[Delta]", 
        OverscriptBox["\[CapitalPsi]", "_"]}]]}]}], ",", " ", 
    RowBox[{"J", "=", 
     FractionBox["\[Delta]\[CapitalGamma]", "\[Delta]A"]}]}], 
   TraditionalForm]],ExpressionUUID->"1d0a7dfe-99ee-4204-bd7a-bb7c7a7d6025"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[CapitalPsi]", "_"], "=", 
     FractionBox["\[Delta]W", "\[Delta]\[Eta]"]}], ",", " ", 
    RowBox[{"\[CapitalPsi]", "=", 
     FractionBox["\[Delta]W", 
      RowBox[{"\[Delta]", 
       OverscriptBox["\[Eta]", "_"]}]]}], ",", " ", 
    RowBox[{"A", "=", 
     FractionBox["\[Delta]W", "\[Delta]J"]}]}], TraditionalForm]],
  ExpressionUUID->"89a88799-1d82-450e-8558-63e08e155067"],
 "."
}], "Text",
 CellChangeTimes->{{3.948114219983946*^9, 3.948114222127754*^9}, 
   3.972299410752521*^9, {3.977999241153537*^9, 3.977999241275288*^9}, {
   3.979470265006833*^9, 
   3.979470325693325*^9}},ExpressionUUID->"f81417f4-43d5-41d8-8a61-\
8f49e201ea6f"],

Cell[TextData[{
 "To clarify the meaning of the notation, we note that a propagator \
describing the propagation of a particle created at 1 to its annihilation at \
2 is given by (sources set to zero but not indicated)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "W"}], 
     RowBox[{"\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Eta]", "_"], "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
    RowBox[{"<", 
     RowBox[{
      SubscriptBox["\[Psi]", "2"], 
      SubscriptBox[
       OverscriptBox["\[Psi]", "_"], "1"]}], ">", 
     RowBox[{"-", 
      RowBox[{"<", 
       SubscriptBox["\[Psi]", "2"], ">", "<", 
       SubscriptBox[
        OverscriptBox["\[Psi]", "_"], "1"], ">"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e0b7ab56-8526-4625-b798-4cb7562b8c1f"],
 "."
}], "Text",
 CellChangeTimes->{{3.9481140737514668`*^9, 3.948114112497149*^9}, {
  3.948114319751792*^9, 3.948114348184263*^9}, {3.948114431490033*^9, 
  3.948114447569888*^9}, {3.962606353949375*^9, 3.9626063548786783`*^9}, {
  3.971591130765414*^9, 3.97159119784062*^9}, {3.977542937368909*^9, 
  3.9775429594590673`*^9}, {3.9779992332935667`*^9, 
  3.977999233468927*^9}},ExpressionUUID->"45f11185-106e-4640-8c62-\
c21bdb90efb4"],

Cell[TextData[{
 "Diagrammatically, propagation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Psi]", "_"], "1"], TraditionalForm]],ExpressionUUID->
  "78fb0f29-7c2a-4d64-b217-3e7763ead1a2"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "2"], TraditionalForm]],ExpressionUUID->
  "9bcc07c4-da12-4396-b12d-2daaecf27b2b"],
 " means, in terms of the sources, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", "1"], TraditionalForm]],ExpressionUUID->
  "d9abac36-0ca6-474c-be9a-8960fcb8cc12"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Eta]", "_"], "2"], TraditionalForm]],ExpressionUUID->
  "18193b99-8172-4a8d-bd7c-492a434da437"],
 " is represented as"
}], "Text",
 CellChangeTimes->{{3.9715918724053097`*^9, 3.9715919846595592`*^9}, {
  3.9768557459192667`*^9, 3.9768557494414797`*^9}, {3.976856294096839*^9, 
  3.976856299813081*^9}, {3.9887154904835987`*^9, 
  3.988715502627199*^9}},ExpressionUUID->"9422524c-3e42-44f2-9997-\
432c21874468"],

