       RowBox[{"vec", "[", 
        RowBox[{"p", ",", "mu$20793"}], "]"}]}]}], ")"}]}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["g", "2"], " ", "ZF1", " ", 
      RowBox[{"delta", "[", 
       RowBox[{"adj", ",", "a$20783", ",", "b$20783"}], "]"}], " ", 
      RowBox[{"delta", "[", 
