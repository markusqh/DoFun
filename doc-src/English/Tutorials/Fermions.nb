Cell[TextData[{
 "From the action, the Feynman rules an be derived. The bare two-point \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{"\[Psi]", 
      OverscriptBox["\[Psi]", "_"]}]], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "S"}], 
     RowBox[{"\[Delta]\[Psi]\[Delta]", 
      OverscriptBox["\[Psi]", "_"]}]]}], TraditionalForm]],ExpressionUUID->
  "a902597d-e9ef-47be-8464-d89bb66c009f"],
 " is obtained with"
}], "Text",
 CellChangeTimes->{{3.948115416461734*^9, 3.9481154373329363`*^9}, {
  3.962606817420649*^9, 3.9626068179150257`*^9}, {3.971693010341638*^9, 
