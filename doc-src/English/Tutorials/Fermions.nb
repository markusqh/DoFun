Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getFR", "[", 
    RowBox[{"actionQCD", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"p1", ",", "a", ",", "mu"}], "]"}], ",", 
       RowBox[{"A", "[", 
        RowBox[{"p2", ",", "b", ",", "nu"}], "]"}]}], "}"}]}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"-", "a_"}], "]"}], ":>", 
      RowBox[{"sp", "[", "a", "]"}]}], ",", 
     RowBox[{
      RowBox[{"vec", "[", 
       RowBox[{
        RowBox[{"-", "a_"}], ",", "mu_"}], "]"}], ":>", 
