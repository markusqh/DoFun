Cell["\<\
We can check that the bare propagators are the inverses of the bare two-point \
functions:\
\>", "Text",
 CellChangeTimes->{{3.971693155332855*^9, 3.971693172988844*^9}, {
  3.976971988313451*^9, 
  3.9769719923253727`*^9}},ExpressionUUID->"631de162-d45b-4db8-a325-\
cd6a7c41f342"],

Cell[BoxData[
 RowBox[{
  RowBox[{"contractRulesDirac", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"slash", "[", 
       RowBox[{"p_", ",", "i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "mu", "}"}], ",", 
        RowBox[{
         RowBox[{"vec", "[", 
          RowBox[{"p", ",", "mu"}], "]"}], 
         RowBox[{"diracGamma", "[", 
          RowBox[{"mu", ",", "i", ",", "j"}], "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"mudelta", "[", 
        RowBox[{"fund", ",", "a_", ",", "b_"}], "]"}], 
       RowBox[{"delta", "[", 
        RowBox[{"fund", ",", "c_", ",", "b_"}], "]"}]}], ":>", 
      RowBox[{"delta", "[", 
       RowBox[{"fund", ",", "a", ",", "c"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "j_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"delta", "[", 
       RowBox[{"dirac", ",", "i", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "k_", ",", "i_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "k", ",", "j"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "j_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "i", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"nu_", ",", "j_", ",", "k_"}], "]"}], 
       RowBox[{"vec", "[", 
        RowBox[{"p_", ",", "mu_"}], "]"}], 
       RowBox[{"vec", "[", 
        RowBox[{"p_", ",", "nu_"}], "]"}]}], ":>", 
      RowBox[{
       RowBox[{"sp", "[", "p", "]"}], 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i", ",", "k"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dim", "[", "dirac", "]"}], ":>", "4"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "j", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "j_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "i", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
