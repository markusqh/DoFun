      RowBox[{"diracGamma", "[", 
       RowBox[{"b$20792", ",", "j", ",", "b$20786"}], "]"}], " ", 
      RowBox[{"GammaA\[CapitalPsi]\[CapitalPsi]b", "[", 
       RowBox[{"1", ",", 
        RowBox[{"p", "-", "q1"}], ",", 
