Cell["\<\
Here is a summary of definitions where the order of fields is important:\
\>", "Abstract",
 CellChangeTimes->{{3.972295259642276*^9, 
  3.9722953165633793`*^9}},ExpressionUUID->"34c87532-97b8-4e71-9474-\
42780c50188c"],

Cell[TextData[{
 "Propagator: All momenta outgoing.\nThe propagator is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], " ", "W"}], 
     RowBox[{"\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Eta]", "_"], "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], " ", "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "2"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "1"]}]], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "495f8878-cc95-44e8-9799-13be31049303"],
 ".\nThis describes the propagation from creation of a particle (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "649b2db6-0fb3-40b4-8b03-f20864cf8ae1"],
 ", source \[Eta]) at 1 to annihilation (\[CapitalPsi], sink ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Eta]", "_"], TraditionalForm]],ExpressionUUID->
  "31e63586-5dd2-42a1-ae64-53b67307d237"],
 ") of the particle at 2.\nIn DoFun, the notation uses only field arguments \
and the propagators is then denoted schematically by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "[", 
    RowBox[{
     SubscriptBox["\[CapitalPsi]", "2"], ",", " ", 
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], "1"]}], "]"}], TraditionalForm]],
  ExpressionUUID->"fcc6301f-cfec-4603-887e-19ad553337ff"],
 "."
}], "Abstract",
 CellChangeTimes->{{3.972295259642276*^9, 3.97229537256583*^9}, {
   3.9722954966840487`*^9, 3.9722957381595793`*^9}, {3.97229959666411*^9, 
   3.9722996099119368`*^9}, 3.97360801322194*^9, {3.9736081133036833`*^9, 
   3.9736081724642344`*^9}},ExpressionUUID->"15bbeac9-9eaa-4d51-96ee-\
25f4c8cc1a71"],

Cell[TextData[{
 "Dressed (V) and bare (S) n-point functions have, in contradistinction to \
propagators, all momenta incoming and the \[OpenCurlyQuote]flow of fields\
\[CloseCurlyQuote] is from \[CapitalPsi]  to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "64043417-ed94-4d9c-9a34-10bf2ae02f25"],
 ". The canonical notation is, e.g., V[A, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "9bb64b86-6016-439c-909f-fca7fad03d51"],
 ", \[CapitalPsi]]."
}], "Abstract",
 CellChangeTimes->{{3.972295259642276*^9, 3.97229537256583*^9}, {
   3.9722954966840487`*^9, 3.972295930664649*^9}, 3.973608024469043*^9, {
   3.9736080602104473`*^9, 3.97360809649008*^9}, {3.973608150877849*^9, 
   3.973608161622909*^9}, {3.973608307677452*^9, 3.973608331321662*^9}, {
   3.976855629331818*^9, 
   3.97685563007679*^9}},ExpressionUUID->"d400e0e5-b961-47dc-82f4-\
f177a525e098"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Definitions in DoFun", "Section",
 CellChangeTimes->{{3.948089829048134*^9, 3.9480898388814297`*^9}, {
  3.948115151126446*^9, 
  3.9481151540126457`*^9}},ExpressionUUID->"bf995354-af63-4d70-baba-\
a9b7e64de95d"],

Cell[TextData[{
 "The symbolic equations are derived with doDSE/doRGE. All derivatives are \
left-derivatives and the order of fields, for example in vertices V, is such \
that they are taken in the order as written. For instance, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     RowBox[{
      SubscriptBox["i", "2"], " ", 
      SubscriptBox["i", "1"]}], 
     RowBox[{" ", 
      RowBox[{"\[CapitalPsi]", 
       OverscriptBox["\[CapitalPsi]", "_"]}]}]], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
     RowBox[{
      SubscriptBox["\[Delta]\[CapitalPsi]", 
       SubscriptBox["i", "2"]], "\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], 
       SubscriptBox["i", "1"]]}]]}], TraditionalForm]],ExpressionUUID->
  "38ab68fe-04c0-4bb6-abca-a38ad6f0e051"],
 ". The functions doDSE and doRGE, however, apply one derivative after the \
other, starting with the first entry. Thus, to get the DSE for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["i", "2"], " ", 
     SubscriptBox["i", "1"]}], 
    RowBox[{" ", 
     RowBox[{"\[CapitalPsi]", 
      OverscriptBox["\[CapitalPsi]", "_"]}]}]], TraditionalForm]],
  ExpressionUUID->"4ea1bf7f-3a22-4205-b644-7b2e0f250614"],
 ", one calls doDSE[action, {{\[CapitalPsi],i1},{\[CapitalPsi],i2}}]."
}], "Text",
 CellChangeTimes->{{3.90240673833813*^9, 3.902406832740601*^9}, {
   3.902407067636001*^9, 3.902407083360821*^9}, {3.9310020021674232`*^9, 
   3.931002192371374*^9}, {3.948089862154179*^9, 3.948089865118677*^9}, {
   3.948089927549662*^9, 3.948089928666588*^9}, 3.962606420229444*^9, {
   3.971592023083099*^9, 3.971592082208984*^9}, {3.971692839758719*^9, 
   3.971692945710589*^9}, {3.9717024870093307`*^9, 3.971702487802981*^9}, {
   3.973608615175864*^9, 3.973608628201985*^9}, {3.976855658810499*^9, 
   3.976855660465513*^9}, {3.9768568482786293`*^9, 3.976856849758333*^9}, {
   3.976958067789196*^9, 
   3.97695806852419*^9}},ExpressionUUID->"818ec6c5-9003-4f7c-bece-\
572875d1d2cf"],

Cell[TextData[{
 "Propagators in DoFun are written as P[{\[CapitalPsi], i2}, {",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalPsi]", "_"], TraditionalForm]],ExpressionUUID->
  "24f76dde-a149-4d45-a918-e9be18e2b2ee"],
 ", i1}]. This corresponds to ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "W"}], 
    RowBox[{"\[Delta]", 
     SubscriptBox[
      OverscriptBox["\[Eta]", "_"], "2"], 
     SubscriptBox["\[Delta]\[Eta]", "1"]}]], TraditionalForm]],ExpressionUUID->
  "ea38e9ab-c26e-4d6f-94ad-2beaa60d883a"],
 ". Note that the propagator arguments match those of the vertices they are \
connected to."
}], "Text",
 CellChangeTimes->{{3.971592187190864*^9, 3.971592199551407*^9}, {
   3.971592421622897*^9, 3.9715925102223253`*^9}, 3.971592555432929*^9, 
