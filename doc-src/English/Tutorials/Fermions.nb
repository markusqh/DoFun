cd6a7c41f342"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"contractRulesDirac", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"vec", "[", 
       RowBox[{
        RowBox[{"-", "p_"}], ",", "mu_"}], "]"}], ":>", 
      RowBox[{"-", 
       RowBox[{"vec", "[", 
        RowBox[{"p", ",", "mu"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"slash", "[", 
       RowBox[{"p_", ",", "i_", ",", "j_"}], "]"}], ":>", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "mu", "}"}], ",", 
        RowBox[{
         RowBox[{"vec", "[", 
          RowBox[{"p", ",", "mu"}], "]"}], 
         RowBox[{"diracGamma", "[", 
          RowBox[{"mu", ",", "i", ",", "j"}], "]"}]}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"fund", ",", "a_", ",", "b_"}], "]"}], 
       RowBox[{"delta", "[", 
        RowBox[{"fund", ",", "c_", ",", "b_"}], "]"}]}], ":>", 
      RowBox[{"delta", "[", 
       RowBox[{"fund", ",", "a", ",", "c"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "j_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"delta", "[", 
       RowBox[{"dirac", ",", "i", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "k_", ",", "i_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "k", ",", "j"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "j_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "i", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"nu_", ",", "j_", ",", "k_"}], "]"}], 
       RowBox[{"vec", "[", 
        RowBox[{"p_", ",", "mu_"}], "]"}], 
       RowBox[{"vec", "[", 
        RowBox[{"p_", ",", "nu_"}], "]"}]}], ":>", 
      RowBox[{
       RowBox[{"sp", "[", "p", "]"}], 
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i", ",", "k"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dim", "[", "dirac", "]"}], ":>", "4"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "j", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "j_", ",", "k_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "i", ",", "k"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "k_", ",", "i_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "k", ",", "j"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "[", 
        RowBox[{"dirac", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "k_", ",", "j_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu", ",", "k", ",", "i"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"metr", "[", 
        RowBox[{"mu_", ",", "nu_"}], "]"}]}], ":>", 
      RowBox[{"diracGamma", "[", 
       RowBox[{"nu", ",", "i", ",", "j"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "traces", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"diracGamma", "[", 
       RowBox[{"mu_", ",", "i_", ",", "i_"}], "]"}], ":>", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"nu_", ",", "j_", ",", "i_"}], "]"}]}], ":>", 
      RowBox[{"4", 
       RowBox[{"metr", "[", 
        RowBox[{"mu", ",", "nu"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"nu_", ",", "j_", ",", "k_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"rho_", ",", "k_", ",", "i_"}], "]"}]}], ":>", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"diracGamma", "[", 
        RowBox[{"mu_", ",", "i_", ",", "j_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"nu_", ",", "j_", ",", "k_"}], "]"}], " ", 
       RowBox[{"diracGamma", "[", 
        RowBox[{"rho_", ",", "k_", ",", "l_"}], "]"}], 
       RowBox[{"diracGamma", "[", 
        RowBox[{"sigma_", ",", "l_", ",", "i_"}], "]"}]}], ":>", 
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"metr", "[", 
           RowBox[{"mu", ",", "nu"}], "]"}], 
          RowBox[{"metr", "[", 
           RowBox[{"rho", ",", "sigma"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"metr", "[", 
           RowBox[{"mu", ",", "rho"}], "]"}], 
          RowBox[{"metr", "[", 
           RowBox[{"nu", ",", "sigma"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"metr", "[", 
