  3.9626062622471867`*^9}},ExpressionUUID->"48124502-fd37-4bfc-8505-\
aae79f778efe"],

Cell["\<\
To clarify the meaning of the notation, we note that a propagator describing \
the propagation of a particle created at 1 to its annihilation at 2 is given \
by (sources set to zero but not indicated)\
\>", "Text",
 CellChangeTimes->{{3.9481140737514668`*^9, 3.948114112497149*^9}, {
  3.948114319751792*^9, 3.948114348184263*^9}, {3.948114431490033*^9, 
  3.948114447569888*^9}, {3.962606353949375*^9, 3.9626063548786783`*^9}, {
  3.971591130765414*^9, 3.97159119784062*^9}, {3.977542937368909*^9, 
  3.9775429594590673`*^9}},ExpressionUUID->"45f11185-106e-4640-8c62-\
c21bdb90efb4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "W"}], 
     RowBox[{"\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Eta]", "_"], "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
    RowBox[{"<", 
     RowBox[{
      SubscriptBox["\[Psi]", "2"], 
      SubscriptBox[
       OverscriptBox["\[Psi]", "_"], "1"]}], ">", 
     RowBox[{"-", 
      RowBox[{"<", 
       SubscriptBox["\[Psi]", "2"], ">", "<", 
       SubscriptBox[
        OverscriptBox["\[Psi]", "_"], "1"], ">"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"0c0b15dd-fe4e-4b65-b2a7-11559c52710f"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
  3.902286509132814*^9}, {3.902286556687783*^9, 3.902286559535182*^9}, {
  3.902286641073317*^9, 3.902286644237081*^9}, {3.948113803514504*^9, 
  3.9481138581629143`*^9}, {3.948113919821107*^9, 3.948114036257471*^9}, {
  3.948114131202759*^9, 3.948114218692923*^9}, {3.948114357361177*^9, 
  3.9481144258281593`*^9}, {3.9481145153760366`*^9, 3.9481145158694477`*^9}, {
  3.9715914514581738`*^9, 3.971591476824871*^9}, {3.97685543824934*^9, 
  3.9768554474580193`*^9}, {3.9775428783458557`*^9, 3.977542884029269*^9}, {
  3.977542921112636*^9, 
  3.977542934955922*^9}},ExpressionUUID->"b521b1ed-af5d-4134-836c-\
cb4785d1ccaa"],

Cell[TextData[{
 "In other words, propagation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Psi]", "_"], "1"], TraditionalForm]],ExpressionUUID->
  "78fb0f29-7c2a-4d64-b217-3e7763ead1a2"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "2"], TraditionalForm]],ExpressionUUID->
  "9bcc07c4-da12-4396-b12d-2daaecf27b2b"],
 " means, in terms of the sources, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", "1"], TraditionalForm]],ExpressionUUID->
  "d9abac36-0ca6-474c-be9a-8960fcb8cc12"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Eta]", "_"], "2"], TraditionalForm]],ExpressionUUID->
  "18193b99-8172-4a8d-bd7c-492a434da437"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9715918724053097`*^9, 3.9715919846595592`*^9}, {
