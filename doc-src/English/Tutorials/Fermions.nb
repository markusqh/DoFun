Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"delta", "[", 
    RowBox[{"adj", ",", "a", ",", "b"}], "]"}], " ", 
   RowBox[{"deltam", "[", 
    RowBox[{"p1", "+", "p2"}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Z3", " ", "\[Xi]", " ", 
      RowBox[{"metr", "[", 
       RowBox[{"mu", ",", "nu"}], "]"}], " ", 
      RowBox[{"sp", "[", "p1", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Z3", " ", "\[Xi]"}]}], ")"}], " ", 
      RowBox[{"vec", "[", 
       RowBox[{"p1", ",", "mu"}], "]"}], " ", 
      RowBox[{"vec", "[", 
       RowBox[{"p1", ",", "nu"}], "]"}]}]}], ")"}]}], "\[Xi]"]], "Output",
