8a0768b742fa"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalGamma]", "[", 
    RowBox[{"\[CapitalPsi]", ",", 
     OverscriptBox["\[CapitalPsi]", "_"]}], "]"}], "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"W", "[", 
      RowBox[{
       OverscriptBox["\[Eta]", "_"], ",", "\[Eta]"}], "]"}]}], "+", 
    RowBox[{"\[Integral]", 
     RowBox[{"dx", "(", 
      RowBox[{
       RowBox[{
        OverscriptBox["\[Eta]", "_"], "\[CapitalPsi]"}], "+", 
       RowBox[{"\[Eta]", 
        OverscriptBox["\[CapitalPsi]", "_"]}]}], ")"}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"1de7733a-1127-4c86-bba7-4e7d8d1c40fe"]], \
"DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
