Cell["Summary of DoFun conventions", "Section",
 CellChangeTimes->{{3.977544283404169*^9, 
  3.9775442943899527`*^9}},ExpressionUUID->"bf7c38c7-9fae-42b5-9f1e-\
efcdfc7050f4"],

Cell["\<\
Here is a summary of definitions where the order of fields is important:\
\>", "Text",
 CellChangeTimes->{{3.972295259642276*^9, 
  3.9722953165633793`*^9}},ExpressionUUID->"34c87532-97b8-4e71-9474-\
42780c50188c"],

Cell[TextData[{
 "The propagator is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], " ", "W"}], 
     RowBox[{"\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Eta]", "_"], "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], " ", "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "2"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "1"]}]], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "495f8878-cc95-44e8-9799-13be31049303"],
 ".\n",
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
