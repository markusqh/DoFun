  RowBox[{"projQuA", "=", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{
     RowBox[{"slash", "[", 
      RowBox[{"p", ",", "i", ",", "j"}], "]"}], "/", 
     RowBox[{"sp", "[", "p", "]"}]}], 
