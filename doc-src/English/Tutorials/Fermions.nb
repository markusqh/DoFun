Cell[TextData[{
 "To illustrate the importance of the \[Epsilon]\[CloseCurlyQuote]s, consider \
the derivative of a mixed derivative:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Delta]", 
       SubscriptBox["\[Delta]\[CapitalPsi]", "k"]], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{"\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[Eta]", "_"], "i"], 
         SubscriptBox["\[Delta]A", "j"]}]],
       TraditionalForm]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Epsilon]", 
        SubscriptBox["\[CapitalPsi]", "k"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[CapitalPsi]", "_"], "l"], 
         SubscriptBox["A", "m"]}]]}], 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["A", "m"], 
       SubscriptBox["A", "m"]], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{"\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[Eta]", "_"], "i"], 
         SubscriptBox["\[Delta]\[Eta]", "l"]}]],
       TraditionalForm], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "l"], 
        SubscriptBox["\[Delta]A", "m"]}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]J", "m"], 
        SubscriptBox["\[Delta]J", "j"]}]]}], "=", 
     RowBox[{
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{"\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[Eta]", "_"], "i"], 
         SubscriptBox["\[Delta]\[Eta]", "l"]}]],
       TraditionalForm], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "l"], 
        SubscriptBox["\[Delta]A", "m"]}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]J", "m"], 
        SubscriptBox["\[Delta]J", "j"]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"f94b3286-0874-492b-bef5-ec999088d7df"],
 "\nThis should be the same as the derivative of the mixed derivative with \
opposite order:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[Delta]", 
       SubscriptBox["\[Delta]\[CapitalPsi]", "k"]], 
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]A", "j"], "\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[Eta]", "_"], "i"]}]],
       TraditionalForm]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Epsilon]", 
        SubscriptBox["\[CapitalPsi]", "k"], 
        RowBox[{
         SubscriptBox["A", "l"], 
         SubscriptBox["\[CapitalPsi]", "m"]}]]}], 
      SubsuperscriptBox["\[Epsilon]", 
       SubscriptBox["\[Eta]", "m"], 
       SubscriptBox["\[Eta]", "m"]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]J", "j"], 
        SubscriptBox["\[Delta]J", "l"]}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[CapitalPsi]", "k"], 
        SubscriptBox["\[Delta]A", "l"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "m"]}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "W"}], 
       RowBox[{
        SubscriptBox["\[Delta]\[Eta]", "m"], "\[Delta]", 
        SubscriptBox[
         OverscriptBox["\[Eta]", "_"], "i"]}]]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "W"}], 
         RowBox[{
          SubscriptBox["\[Delta]J", "j"], 
          SubscriptBox["\[Delta]J", "l"]}]]}], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "3"], "\[CapitalGamma]"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[CapitalPsi]", "k"], 
         SubscriptBox["\[Delta]A", "l"], "\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[CapitalPsi]", "_"], "m"]}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "W"}], 
        RowBox[{
         SubscriptBox["\[Delta]\[Eta]", "m"], "\[Delta]", 
         SubscriptBox[
          OverscriptBox["\[Eta]", "_"], "i"]}]]}], "=", "  ", 
      RowBox[{
       RowBox[{
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "W"}], 
          RowBox[{"\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[Eta]", "_"], "i"], 
           SubscriptBox["\[Delta]\[Eta]", "m"]}]],
         TraditionalForm], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "m"], 
          SubscriptBox["\[Delta]A", "l"]}]], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "W"}], 
         RowBox[{
          SubscriptBox["\[Delta]J", "l"], 
          SubscriptBox["\[Delta]J", "j"]}]]}], "=", 
       RowBox[{
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "W"}], 
          RowBox[{"\[Delta]", 
           SubscriptBox[
            OverscriptBox["\[Eta]", "_"], "i"], 
           SubscriptBox["\[Delta]\[Eta]", "l"]}]],
         TraditionalForm], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "\[CapitalGamma]"}], 
         RowBox[{
          SubscriptBox["\[Delta]\[CapitalPsi]", "k"], "\[Delta]", 
          SubscriptBox[
           OverscriptBox["\[CapitalPsi]", "_"], "l"], 
          SubscriptBox["\[Delta]A", "m"]}]], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "W"}], 
         RowBox[{
          SubscriptBox["\[Delta]J", "m"], 
          SubscriptBox["\[Delta]J", "j"]}]]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c19fd907-b8a2-4ab5-8300-31192ca4c8f4"]
}], "Text",
 CellChangeTimes->{{3.9793782194021*^9, 3.979378505784444*^9}, {
  3.9793785749924583`*^9, 3.9793787652893143`*^9}, {3.9794685578133993`*^9, 
  3.979468588213641*^9}, {3.979468716588169*^9, 3.979469117182989*^9}, {
  3.9857791211467857`*^9, 3.985779132953739*^9}, {3.985779162971236*^9, 
  3.985779265601893*^9}, {3.985779398052388*^9, 3.985779540261688*^9}, {
  3.985780424580285*^9, 3.985780564111992*^9}, {3.985780811273078*^9, 
  3.985780855630052*^9}, {3.988715039329121*^9, 3.988715040972763*^9}, {
  3.988716900340745*^9, 
  3.988716901345723*^9}},ExpressionUUID->"a1c46b5f-9433-493c-83b1-\
dfded21c2bd6"],

Cell["\<\
Without the dedicated \[Epsilon] factors, these expressions would differ by \
the sign.\
\>", "Text",
 CellChangeTimes->{{3.985780867141479*^9, 3.985780891711975*^9}, {
  3.9887170041531973`*^9, 
  3.988717004526857*^9}},ExpressionUUID->"a8ed9298-972c-44e5-a663-\
54acba3575a9"]
}, Open  ]]
}, Open  ]],

