Cell[TextData[{
 "The action is given by (in linear covariant gauges, without ghost terms) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox["dq", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
      SubscriptBox["Z", "2"], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["\[Psi]", "_"], "a"], "(", "p", ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["\[Gamma]", "\[Mu]"], 
         SubscriptBox["p", "\[Mu]"]}], "+", 
        RowBox[{
         SubscriptBox["Z", "m"], "m"}]}], ")"}], 
      RowBox[{
       SuperscriptBox["\[Psi]", "a"], "(", 
       RowBox[{"-", "p"}], ")"}]}]}], "-", 
    RowBox[{
     SubscriptBox["Z", "F1"], "\[ImaginaryI]", " ", "g", " ", 
     SubsuperscriptBox["T", "bd", "a"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox["dpdq", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "8"]], 
       SubscriptBox["\[Gamma]", "\[Mu]"], 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "a"], "(", "q", ")"}], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["\[Psi]", "_"], "b"], "(", "p", ")"}], 
       RowBox[{
        SuperscriptBox["\[Psi]", "d"], "(", 
        RowBox[{
         RowBox[{"-", "p"}], "-", "q"}], ")"}]}]}]}], "+", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox["dq", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
      FractionBox["1", "2"], 
      SubscriptBox["Z", "3"], 
      RowBox[{
       SubsuperscriptBox["A", "\[Mu]", "a"], "(", "p", ")"}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["g", "\[Mu]\[Nu]"], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox["1", "\[Xi]"]}], ")"}], 
         FractionBox[
          RowBox[{
           SubscriptBox["p", "\[Mu]"], 
           SubscriptBox["p", "\[Nu]"]}], 
          SuperscriptBox["p", "2"]]}]}], ")"}], 
      RowBox[{
       SubsuperscriptBox["A", "\[Nu]", "a"], "(", 
       RowBox[{"-", "p"}], ")"}]}]}], "+", 
    RowBox[{
     SubscriptBox["Z", "1"], 
     FractionBox["\[ImaginaryI]", "2"], " ", "g", " ", 
     SuperscriptBox["f", "abc"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox["dpdq", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "8"]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["p", "\[Mu]"]}], 
          RowBox[{
           SubsuperscriptBox["A", "\[Nu]", "a"], "(", "p", ")"}], 
          RowBox[{
           SubsuperscriptBox["A", "\[Mu]", "b"], "(", "q", ")"}], " ", 
          RowBox[{
           SubsuperscriptBox["A", "\[Nu]", "c"], "(", 
           RowBox[{
            RowBox[{"-", "p"}], "-", "q"}], ")"}]}], "+", 
         RowBox[{
          SubscriptBox["p", "\[Nu]"], 
          RowBox[{
           SubsuperscriptBox["A", "\[Mu]", "a"], "(", "p", ")"}], 
          RowBox[{
           SubsuperscriptBox["A", "\[Mu]", "b"], "(", "q", ")"}], " ", 
          RowBox[{
           SubsuperscriptBox["A", "\[Nu]", "c"], "(", 
           RowBox[{
            RowBox[{"-", "p"}], "-", "q"}], ")"}]}]}], ")"}]}]}]}], "+", 
    RowBox[{
     SubscriptBox["Z", "4"], 
     FractionBox["1", "4"], " ", 
     SuperscriptBox["g", "2"], " ", 
     SuperscriptBox["f", "abd"], 
     SuperscriptBox["f", "efd"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       FractionBox["dpdqdr", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "12"]], 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "a"], "(", "p", ")"}], 
       RowBox[{
        SubsuperscriptBox["A", "\[Nu]", "b"], "(", "q", ")"}], " ", 
       RowBox[{
        SubsuperscriptBox["A", "\[Mu]", "e"], "(", "r", ")"}], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["A", "\[Nu]", "f"], "(", 
         RowBox[{
          RowBox[{"-", "p"}], "-", "q", "-", "r"}], ")"}], "."}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"8663f70f-e33b-4fc5-ad88-9efcbf4230b8"]
}], "Text",
 CellChangeTimes->{{3.948115339418234*^9, 3.948115344599498*^9}, {
   3.971592750239793*^9, 3.971592752639583*^9}, {3.971692416141801*^9, 
   3.9716927251377172`*^9}, {3.972101983734955*^9, 3.972101983941098*^9}, {
   3.973608688795903*^9, 3.973609100115768*^9}, 
   3.9768571398241673`*^9},ExpressionUUID->"86f8417a-3ebe-4282-b495-\
506a0b27c94d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"actionQCD", ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dummy", "=", 
        RowBox[{"insDummy", "[", "]"}]}], ",", 
       RowBox[{"\[Mu]1", "=", 
        RowBox[{"insDummy", "[", "]"}]}], ",", 
       RowBox[{"\[Mu]2", "=", 
        RowBox[{"insDummy", "[", "]"}]}]}], "}"}], ",", 
     RowBox[{"convertAction", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"\[CapitalPsi]b", " ", "\[CapitalPsi]"}], " ", "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           RowBox[{"vec", "[", 
            RowBox[{"p", ",", "\[Mu]1"}], "]"}], 
           RowBox[{"diracGamma", "[", 
            RowBox[{"\[Mu]1", ",", "i", ",", "j"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"delta", "[", 
            RowBox[{"dirac", ",", "i", ",", "j"}], "]"}], "Zm", " ", "m"}]}], 
         ")"}], "Z2", " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"\[CapitalPsi]b", "[", 
           RowBox[{"p", ",", "a", ",", "i"}], "]"}], ",", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{
            RowBox[{"-", "p"}], ",", "a", ",", "j"}], "]"}]}], "]"}]}], "-", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "\[CapitalPsi]b", " ", "\[CapitalPsi]"}], " ", 
        "*)"}], 
       RowBox[{"ZF1", " ", "I", " ", "g", " ", 
        RowBox[{"(", 
         RowBox[{"diracGamma", "[", 
          RowBox[{"\[Mu]2", ",", "i", ",", "j"}], "]"}], ")"}], " ", 
        RowBox[{"SUNT", "[", 
         RowBox[{"a", ",", "b", ",", "d"}], "]"}], " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"\[CapitalPsi]b", "[", 
           RowBox[{"p", ",", "b", ",", "i"}], "]"}], ",", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"q", ",", "d", ",", "j"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "p"}], "-", "q"}], ",", "a", ",", "\[Mu]2"}], 
           "]"}]}], "]"}]}], "+", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "A"}], " ", "*)"}], 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Z3", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"metr", "[", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "-", " ", 
             RowBox[{
              RowBox[{"vec", "[", 
               RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"vec", "[", 
                RowBox[{"p", ",", "\[Nu]"}], "]"}], "/", 
               RowBox[{"sp", "[", "p", "]"}]}]}]}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"1", "/", "\[Xi]"}], "  ", 
           RowBox[{"vec", "[", 
            RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"p", ",", "\[Nu]"}], "]"}], "/", 
            RowBox[{"sp", "[", "p", "]"}]}]}]}], ")"}], " ", 
        RowBox[{"sp", "[", "p", "]"}], " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"p", ",", "a", ",", "\[Mu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{
            RowBox[{"-", "p"}], ",", "a", ",", "\[Nu]"}], "]"}]}], "]"}]}], "+", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "A", " ", "A"}], " ", "*)"}], 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "Z1", " ", "g", " ", 
        RowBox[{"SUNF", "[", 
         RowBox[{"a", ",", "b", ",", "d"}], "]"}], " ", "I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"vec", "[", 
             RowBox[{"p", ",", "\[Mu]"}], "]"}]}], " ", 
           RowBox[{"op", "[", 
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"p", ",", "a", ",", "\[Nu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{"q", ",", "b", ",", "\[Mu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "p"}], "-", "q"}], ",", "d", ",", "\[Nu]"}], 
              "]"}]}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"p", ",", "\[Nu]"}], "]"}], " ", 
           RowBox[{"op", "[", 
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"p", ",", "a", ",", "\[Mu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{"q", ",", "b", ",", "\[Mu]"}], "]"}], ",", 
             RowBox[{"A", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "p"}], "-", "q"}], ",", "d", ",", "\[Nu]"}], 
              "]"}]}], "]"}]}]}], ")"}]}], "+", 
       RowBox[{"(*", " ", 
        RowBox[{"A", " ", "A", " ", "A", " ", "A"}], " ", "*)"}], 
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", "Z4", " ", 
        RowBox[{"g", "^", "2"}], " ", 
        RowBox[{"SUNF", "[", 
         RowBox[{"a", ",", "b", ",", "dummy"}], "]"}], " ", 
        RowBox[{"SUNF", "[", 
         RowBox[{"e", ",", "f", ",", "dummy"}], "]"}], " ", 
        RowBox[{"op", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"p", ",", "a", ",", "\[Mu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{"q", ",", "b", ",", "\[Nu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{"r", ",", "e", ",", "\[Mu]"}], "]"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "p"}], "-", "q", "-", "r"}], ",", "f", ",", 
            "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
