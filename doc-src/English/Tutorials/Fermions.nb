Cell["\<\
To clarify the meaning of the notation, we note that a propagator describing \
the propagation of a particle created at 1 to its annihilation at 2 is given \
by\
\>", "Text",
 CellChangeTimes->{{3.9481140737514668`*^9, 3.948114112497149*^9}, {
  3.948114319751792*^9, 3.948114348184263*^9}, {3.948114431490033*^9, 
  3.948114447569888*^9}, {3.962606353949375*^9, 3.9626063548786783`*^9}, {
  3.971591130765414*^9, 
  3.97159119784062*^9}},ExpressionUUID->"45f11185-106e-4640-8c62-\
c21bdb90efb4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "W"}], 
     RowBox[{"\[Delta]", 
      SubscriptBox[
       OverscriptBox["\[Eta]", "_"], "2"], 
      SubscriptBox["\[Delta]\[Eta]", "1"]}]], "=", 
    RowBox[{"<", 
     RowBox[{
      SubscriptBox["\[Psi]", "2"], 
      SubscriptBox[
       OverscriptBox["\[Psi]", "_"], "1"]}], ">", 
     RowBox[{"-", 
      RowBox[{"<", 
       SubscriptBox["\[Psi]", "2"], ">", "<", 
       SubscriptBox[
        OverscriptBox["\[Psi]", "_"], "1"], ">"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"0c0b15dd-fe4e-4b65-b2a7-11559c52710f"],
 "."
}], "DisplayFormula",
 CellChangeTimes->{{3.901870797945565*^9, 3.9018709855590773`*^9}, {
  3.901871145893468*^9, 3.9018712985474176`*^9}, {3.902286480259836*^9, 
  3.902286509132814*^9}, {3.902286556687783*^9, 3.902286559535182*^9}, {
  3.902286641073317*^9, 3.902286644237081*^9}, {3.948113803514504*^9, 
  3.9481138581629143`*^9}, {3.948113919821107*^9, 3.948114036257471*^9}, {
  3.948114131202759*^9, 3.948114218692923*^9}, {3.948114357361177*^9, 
  3.9481144258281593`*^9}, {3.9481145153760366`*^9, 3.9481145158694477`*^9}, {
  3.9715914514581738`*^9, 3.971591476824871*^9}, {3.97685543824934*^9, 
  3.9768554474580193`*^9}},ExpressionUUID->"b521b1ed-af5d-4134-836c-\
cb4785d1ccaa"],

Cell[TextData[{
 "Note: Considering only the quadratic part in the action, one can complete \
the square,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FormBox[
          RowBox[{
           SuperscriptBox["S", 
            RowBox[{"\[Psi]", 
             OverscriptBox["\[Psi]", "_"]}]], 
           OverscriptBox["\[Psi]", "_"], "\[Psi]"}],
          TraditionalForm]}], "+", 
        FormBox[
         RowBox[{
          RowBox[{
           OverscriptBox["\[Eta]", "_"], "\[Psi]"}], "+", 
          RowBox[{"\[Eta]", 
           OverscriptBox["\[Psi]", "_"]}]}],
         TraditionalForm]}], " ", "=", 
       RowBox[{
        FormBox[
         RowBox[{"-", 
          RowBox[{"(", 
           OverscriptBox["\[Psi]", "_"]}]}],
         TraditionalForm], "-", 
        SuperscriptBox[
         RowBox[{
          FormBox[
           OverscriptBox["\[Eta]", "_"],
           TraditionalForm], "[", 
          FormBox[
           SuperscriptBox["S", 
            RowBox[{"\[Psi]", 
             OverscriptBox["\[Psi]", "_"]}]],
           TraditionalForm], "]"}], 
         RowBox[{"-", "1"}]]}]}], ")"}], 
     RowBox[{
      FormBox[
       SuperscriptBox["S", 
        RowBox[{"\[Psi]", 
         OverscriptBox["\[Psi]", "_"]}]],
       TraditionalForm], "(", 
      RowBox[{"\[Psi]", "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"[", 
          SuperscriptBox["S", 
           RowBox[{"\[Psi]", 
            OverscriptBox["\[Psi]", "_"]}]], "]"}], 
         RowBox[{"-", "1"}]], "\[Eta]"}]}], ")"}]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       OverscriptBox["\[Eta]", "_"], " ", "[", 
       SuperscriptBox["S", 
        RowBox[{"\[Psi]", 
         OverscriptBox["\[Psi]", "_"]}]], "]"}], 
      RowBox[{"-", "1"}]], "\[Eta]"}]}], TraditionalForm]],ExpressionUUID->
  "65110dea-ca47-4ab2-8d1a-1ca517aa4fbb"],
 " ,\nand integrate out the fields. The bare propagator ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", 
     SuperscriptBox["S", 
      RowBox[{"\[Psi]", 
       OverscriptBox["\[Psi]", "_"]}]], "]"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "ce64da9d-5c11-46f1-bc5d-c7a2f0da153d"],
 " is then given by the derivative ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[Delta]", "2"], 
    RowBox[{"\[Delta]", 
     OverscriptBox["\[Eta]", "_"], "\[Delta]\[Eta]"}]], TraditionalForm]],
  ExpressionUUID->"703195a4-f42b-461f-a980-dc9ef898589e"],
 "."
}], "Text",
 CellChangeTimes->{{3.972100891749976*^9, 3.972101208319063*^9}, {
  3.972101335164773*^9, 3.972101382836917*^9}, {3.972101466999653*^9, 
  3.9721015014482937`*^9}, {3.972101558896555*^9, 
  3.972101573061*^9}},ExpressionUUID->"20055634-2e35-4f63-9b80-438e0e008b77"],

Cell[TextData[{
 "In other words, propagation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Psi]", "_"], "1"], TraditionalForm]],ExpressionUUID->
  "a4d2a3cb-ab31-44bf-a68d-9ec1425a94ca"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "2"], TraditionalForm]],ExpressionUUID->
  "4cbd5757-ecb9-4f33-a143-76704287b8de"],
 " means, in terms of the sources, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", "1"], TraditionalForm]],ExpressionUUID->
  "db1fd9ac-886b-48ee-8150-c523e963fb4f"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Eta]", "_"], "2"], TraditionalForm]],ExpressionUUID->
  "73a62ade-5965-487f-986c-b2123f9b4362"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9715918724053097`*^9, 3.9715919846595592`*^9}, {
  3.9768557459192667`*^9, 3.9768557494414797`*^9}, {3.976856294096839*^9, 
  3.976856299813081*^9}},ExpressionUUID->"9422524c-3e42-44f2-9997-\
432c21874468"],

